[
  {
    "start": 0.05,
    "end": 1.275,
    "words": 4,
    "text": "For five years, this"
  },
  {
    "start": 1.275,
    "end": 2.63,
    "words": 4,
    "text": "man was presumed dead."
  },
  {
    "start": 2.797,
    "end": 3.7345,
    "words": 4,
    "text": "Then he walked into"
  },
  {
    "start": 3.7345,
    "end": 5.1845,
    "words": 4,
    "text": "a police station, claiming"
  },
  {
    "start": 5.1845,
    "end": 6.5645,
    "words": 5,
    "text": "he had lost his memory."
  },
  {
    "start": 6.709333000000001,
    "end": 7.796833000000001,
    "words": 3,
    "text": "But one photograph"
  },
  {
    "start": 7.796833000000001,
    "end": 9.026833000000002,
    "words": 3,
    "text": "destroyed his story."
  },
  {
    "start": 9.246333000000002,
    "end": 10.081791000000003,
    "words": 1,
    "text": "England."
  },
  {
    "start": 10.223957000000002,
    "end": 11.356415000000002,
    "words": 3,
    "text": "Two thousand two."
  },
  {
    "start": 11.534624,
    "end": 12.871291000000001,
    "words": 4,
    "text": "John Darwin paddled out"
  },
  {
    "start": 12.871291000000001,
    "end": 13.366332,
    "words": 4,
    "text": "to sea in a"
  },
  {
    "start": 13.366332,
    "end": 14.54829,
    "words": 3,
    "text": "kayak and vanished."
  },
  {
    "start": 14.709832000000002,
    "end": 16.683915000000002,
    "words": 5,
    "text": "Rescuers found his wrecked boat."
  },
  {
    "start": 16.824916000000005,
    "end": 17.870748000000006,
    "words": 3,
    "text": "But not John."
  },
  {
    "start": 18.020832000000013,
    "end": 19.400832000000012,
    "words": 4,
    "text": "He was declared dead."
  },
  {
    "start": 19.545812000000012,
    "end": 21.06810300000001,
    "words": 4,
    "text": "His wife collected insurance"
  },
  {
    "start": 21.06810300000001,
    "end": 22.17581100000001,
    "words": 3,
    "text": "and other payouts."
  },
  {
    "start": 22.339832000000015,
    "end": 23.144290000000016,
    "words": 3,
    "text": "Their two sons"
  },
  {
    "start": 23.144290000000016,
    "end": 24.227248000000014,
    "words": 3,
    "text": "mourned their father."
  },
  {
    "start": 24.447228166666683,
    "end": 25.78472816666668,
    "words": 4,
    "text": "In December two thousand"
  },
  {
    "start": 25.78472816666668,
    "end": 27.25222816666668,
    "words": 3,
    "text": "seven, he returned."
  },
  {
    "start": 27.395811166666675,
    "end": 28.358311166666674,
    "words": 4,
    "text": "But a woman searched"
  },
  {
    "start": 28.358311166666674,
    "end": 29.358311166666674,
    "words": 4,
    "text": "online and found a"
  },
  {
    "start": 29.358311166666674,
    "end": 30.788311166666677,
    "words": 3,
    "text": "photograph from Panama."
  },
  {
    "start": 30.950519166666666,
    "end": 31.925519166666668,
    "words": 3,
    "text": "John was smiling"
  },
  {
    "start": 31.925519166666668,
    "end": 33.06801916666667,
    "words": 3,
    "text": "beside his wife."
  },
  {
    "start": 33.19908216666666,
    "end": 33.986582166666665,
    "words": 4,
    "text": "It had been taken"
  },
  {
    "start": 33.986582166666665,
    "end": 35.12908216666666,
    "words": 4,
    "text": "in two thousand six,"
  },
  {
    "start": 35.19908216666666,
    "end": 36.53658216666666,
    "words": 4,
    "text": "before his return, while"
  },
  {
    "start": 36.53658216666666,
    "end": 37.46158216666666,
    "words": 4,
    "text": "he was still supposed"
  },
  {
    "start": 37.46158216666666,
    "end": 38.15408216666666,
    "words": 3,
    "text": "to be dead."
  },
  {
    "start": 38.37408216666665,
    "end": 39.36158216666666,
    "words": 3,
    "text": "John had staged"
  },
  {
    "start": 39.36158216666666,
    "end": 40.30408216666666,
    "words": 3,
    "text": "his own death."
  },
  {
    "start": 40.39433216666665,
    "end": 41.49433216666665,
    "words": 4,
    "text": "For years, he hid"
  },
  {
    "start": 41.49433216666665,
    "end": 42.69933216666666,
    "words": 4,
    "text": "close to his family."
  },
  {
    "start": 42.840665166666646,
    "end": 44.278165166666646,
    "words": 4,
    "text": "When visitors arrived, he"
  },
  {
    "start": 44.278165166666646,
    "end": 45.278165166666646,
    "words": 4,
    "text": "slipped through a secret"
  },
  {
    "start": 45.278165166666646,
    "end": 46.465665166666646,
    "words": 4,
    "text": "door behind a wardrobe"
  },
  {
    "start": 46.465665166666646,
    "end": 47.92066516666665,
    "words": 4,
    "text": "into the adjoining property."
  },
  {
    "start": 48.05562316666665,
    "end": 49.160623166666646,
    "words": 3,
    "text": "His wife knew."
  },
  {
    "start": 49.31781116666664,
    "end": 50.43031116666664,
    "words": 4,
    "text": "Later, they planned a"
  },
  {
    "start": 50.43031116666664,
    "end": 51.67281116666664,
    "words": 4,
    "text": "new life in Panama."
  },
  {
    "start": 51.829874166666634,
    "end": 52.62987416666663,
    "words": 4,
    "text": "And appeared on a"
  },
  {
    "start": 52.62987416666663,
    "end": 54.37237416666664,
    "words": 3,
    "text": "property agency website."
  },
  {
    "start": 54.593374166666635,
    "end": 55.65454016666664,
    "words": 4,
    "text": "In two thousand eight,"
  },
  {
    "start": 55.75412416666663,
    "end": 56.73624916666664,
    "words": 4,
    "text": "both went to prison"
  },
  {
    "start": 56.73624916666664,
    "end": 57.29745716666663,
    "words": 3,
    "text": "for more than"
  },
  {
    "start": 57.29745716666663,
    "end": 58.333082166666635,
    "words": 3,
    "text": "six years each."
  },
  {
    "start": 58.49952016666663,
    "end": 60.12185316666663,
    "words": 5,
    "text": "But their sons knew nothing."
  },
  {
    "start": 60.31349916666662,
    "end": 61.37216616666662,
    "words": 4,
    "text": "While their parents planned"
  },
  {
    "start": 61.37216616666662,
    "end": 62.22674916666662,
    "words": 4,
    "text": "a new life, they"
  },
  {
    "start": 62.22674916666662,
    "end": 63.849083166666624,
    "words": 5,
    "text": "believed their father was dead."
  },
  {
    "start": 64.00537516666662,
    "end": 64.77066616666662,
    "words": 4,
    "text": "What is harder to"
  },
  {
    "start": 64.77066616666662,
    "end": 66.50537516666662,
    "words": 4,
    "text": "forgive: stolen money, or"
  },
  {
    "start": 66.50537516666662,
    "end": 67.20691616666662,
    "words": 3,
    "text": "five years of"
  },
  {
    "start": 67.20691616666662,
    "end": 68.47212416666662,
    "words": 3,
    "text": "someone else's grief?"
  }
]
[
  {
    "start": 0.05,
    "end": 2.4425,
    "words": 5,
    "text": "Мужчину пять лет считали погибшим."
  },
  {
    "start": 2.5036039999999997,
    "end": 3.2411039999999995,
    "words": 3,
    "text": "И вдруг он"
  },
  {
    "start": 3.2411039999999995,
    "end": 4.508603999999999,
    "words": 3,
    "text": "пришёл в полицию."
  },
  {
    "start": 4.529312000000001,
    "end": 6.746812,
    "words": 4,
    "text": "Сказал, что потерял память."
  },
  {
    "start": 6.805103999999999,
    "end": 8.017603999999999,
    "words": 3,
    "text": "Но одна фотография"
  },
  {
    "start": 8.017603999999999,
    "end": 9.635104,
    "words": 3,
    "text": "разрушила его историю."
  },
  {
    "start": 9.855104,
    "end": 10.737394999999996,
    "words": 1,
    "text": "Англия."
  },
  {
    "start": 10.737394999999996,
    "end": 12.538185999999998,
    "words": 4,
    "text": "Две тысячи второй год."
  },
  {
    "start": 12.566894999999999,
    "end": 13.903562,
    "words": 4,
    "text": "Джон Дарвин вышел в"
  },
  {
    "start": 13.903562,
    "end": 15.766186,
    "words": 5,
    "text": "море на байдарке и исчез."
  },
  {
    "start": 15.824770000000001,
    "end": 18.071102999999997,
    "words": 4,
    "text": "Спасатели нашли разбитую лодку."
  },
  {
    "start": 18.140541000000006,
    "end": 19.669040000000006,
    "words": 4,
    "text": "Но не самого Джона."
  },
  {
    "start": 19.706499000000008,
    "end": 21.470165000000005,
    "words": 3,
    "text": "Его признали погибшим."
  },
  {
    "start": 21.525040000000008,
    "end": 23.09683200000001,
    "words": 3,
    "text": "Жена получила страховку"
  },
  {
    "start": 23.09683200000001,
    "end": 24.353081000000007,
    "words": 3,
    "text": "и другие выплаты."
  },
  {
    "start": 24.395998000000013,
    "end": 26.80320600000001,
    "words": 4,
    "text": "Двое сыновей оплакивали отца."
  },
  {
    "start": 27.02318583333334,
    "end": 27.910685833333343,
    "words": 4,
    "text": "А в декабре две"
  },
  {
    "start": 27.910685833333343,
    "end": 30.240685833333345,
    "words": 5,
    "text": "тысячи седьмого года он вернулся."
  },
  {
    "start": 30.25337283333334,
    "end": 31.703372833333336,
    "words": 4,
    "text": "Но одна женщина решила"
  },
  {
    "start": 31.703372833333336,
    "end": 33.75837283333334,
    "words": 4,
    "text": "поискать информацию в интернете."
  },
  {
    "start": 33.78774783333333,
    "end": 35.74274783333333,
    "words": 5,
    "text": "И нашла снимок из Панамы."
  },
  {
    "start": 35.802247833333325,
    "end": 37.32724783333332,
    "words": 4,
    "text": "На нём Джон улыбается"
  },
  {
    "start": 37.32724783333332,
    "end": 38.357247833333325,
    "words": 3,
    "text": "рядом с женой."
  },
  {
    "start": 38.361976833333316,
    "end": 39.924476833333316,
    "words": 4,
    "text": "Фотография сделана ещё в"
  },
  {
    "start": 39.924476833333316,
    "end": 41.641976833333324,
    "words": 4,
    "text": "две тысячи шестом году."
  },
  {
    "start": 41.662622833333316,
    "end": 43.80512283333332,
    "words": 5,
    "text": "Когда он ещё считался мёртвым."
  },
  {
    "start": 44.02512283333331,
    "end": 46.80512283333332,
    "words": 4,
    "text": "Выяснилось: Джон инсценировал гибель."
  },
  {
    "start": 46.84633083333331,
    "end": 48.483830833333315,
    "words": 4,
    "text": "Он годами скрывался рядом"
  },
  {
    "start": 48.483830833333315,
    "end": 49.726330833333314,
    "words": 3,
    "text": "с собственной семьёй."
  },
  {
    "start": 49.73010183333331,
    "end": 51.73010183333331,
    "words": 4,
    "text": "Когда приходили гости, уходил"
  },
  {
    "start": 51.73010183333331,
    "end": 52.85510183333331,
    "words": 4,
    "text": "через потайную дверь за"
  },
  {
    "start": 52.85510183333331,
    "end": 54.72708083333329,
    "words": 4,
    "text": "шкафом в соседнее помещение."
  },
  {
    "start": 54.72708083333329,
    "end": 56.16958083333329,
    "words": 3,
    "text": "Жена всё знала."
  },
  {
    "start": 56.188267833333285,
    "end": 57.97576783333329,
    "words": 4,
    "text": "Потом супруги задумали новую"
  },
  {
    "start": 57.97576783333329,
    "end": 59.10033083333329,
    "words": 3,
    "text": "жизнь в Панаме."
  },
  {
    "start": 59.10033083333329,
    "end": 59.837830833333285,
    "words": 3,
    "text": "И попали на"
  },
  {
    "start": 59.837830833333285,
    "end": 61.71783083333329,
    "words": 3,
    "text": "сайт агентства недвижимости."
  },
  {
    "start": 61.93783083333328,
    "end": 63.12403883333329,
    "words": 4,
    "text": "В две тысячи восьмом"
  },
  {
    "start": 63.12403883333329,
    "end": 65.30930983333327,
    "words": 5,
    "text": "году обоих отправили в тюрьму."
  },
  {
    "start": 65.30930983333327,
    "end": 67.54389283333327,
    "words": 5,
    "text": "Каждому дали больше шести лет."
  },
  {
    "start": 67.54589383333327,
    "end": 69.56368483333327,
    "words": 5,
    "text": "Но сыновья ничего не знали."
  },
  {
    "start": 69.57566483333326,
    "end": 71.13178983333326,
    "words": 4,
    "text": "Пока родители строили новую"
  },
  {
    "start": 71.13178983333326,
    "end": 72.48628883333326,
    "words": 3,
    "text": "жизнь, они верили,"
  },
  {
    "start": 72.52208083333326,
    "end": 73.72353883333327,
    "words": 3,
    "text": "что отец погиб."
  },
  {
    "start": 73.75893583333325,
    "end": 75.88901883333327,
    "words": 4,
    "text": "Что труднее простить: украденные"
  },
  {
    "start": 75.88901883333327,
    "end": 76.88393583333325,
    "words": 3,
    "text": "деньги или пять"
  },
  {
    "start": 76.88393583333325,
    "end": 78.11085183333326,
    "words": 3,
    "text": "лет чужого горя?"
  }
]
[
  {
    "start": 0.05,
    "end": 2.5504379999999998,
    "words": 5,
    "text": "Женщина обвинила врача в насилии."
  },
  {
    "start": 2.5504379999999998,
    "end": 3.7004379999999997,
    "words": 4,
    "text": "Но анализ ДНК не"
  },
  {
    "start": 3.7004379999999997,
    "end": 5.180438,
    "words": 3,
    "text": "подтвердил её слова."
  },
  {
    "start": 5.214250000000002,
    "end": 6.20675,
    "words": 2,
    "text": "Ни первый."
  },
  {
    "start": 6.243125000000001,
    "end": 7.235625,
    "words": 2,
    "text": "Ни второй."
  },
  {
    "start": 7.2708960000000005,
    "end": 8.475896,
    "words": 2,
    "text": "Она ошиблась?"
  },
  {
    "start": 8.539499999999999,
    "end": 9.914499999999999,
    "words": 4,
    "text": "Разгадка всё это время"
  },
  {
    "start": 9.914499999999999,
    "end": 11.869499999999999,
    "words": 5,
    "text": "скрывалась прямо под его кожей."
  },
  {
    "start": 12.0895,
    "end": 12.887832999999999,
    "words": 1,
    "text": "Канада."
  },
  {
    "start": 12.939354000000002,
    "end": 15.185687000000003,
    "words": 5,
    "text": "Тысяча девятьсот девяносто второй год."
  },
  {
    "start": 15.195479000000006,
    "end": 17.027146000000005,
    "words": 4,
    "text": "Пациентка заявила, что врач"
  },
  {
    "start": 17.027146000000005,
    "end": 19.013604000000004,
    "words": 5,
    "text": "ввёл ей препарат и изнасиловал."
  },
  {
    "start": 19.059354000000006,
    "end": 20.742521000000004,
    "words": 4,
    "text": "Полиция получила улики и"
  },
  {
    "start": 20.742521000000004,
    "end": 21.961604000000005,
    "words": 4,
    "text": "взяла у него кровь."
  },
  {
    "start": 22.01514600000001,
    "end": 23.395146000000008,
    "words": 2,
    "text": "Совпадения нет."
  },
  {
    "start": 23.43662600000001,
    "end": 26.09133300000001,
    "words": 4,
    "text": "Женщина потребовала повторной проверки."
  },
  {
    "start": 26.146501000000008,
    "end": 27.563625000000005,
    "words": 3,
    "text": "Результат тот же."
  },
  {
    "start": 27.607959,
    "end": 29.309750999999995,
    "words": 4,
    "text": "В итоге дело закрыли."
  },
  {
    "start": 29.529730499999992,
    "end": 31.084730499999996,
    "words": 4,
    "text": "Но она не отступила."
  },
  {
    "start": 31.107084499999992,
    "end": 32.707084499999986,
    "words": 4,
    "text": "Частный детектив добыл из"
  },
  {
    "start": 32.707084499999986,
    "end": 34.59958449999999,
    "words": 5,
    "text": "машины врача бальзам для губ."
  },
  {
    "start": 34.63618849999998,
    "end": 36.741188499999986,
    "words": 5,
    "text": "На нём остались следы слюны."
  },
  {
    "start": 36.76883449999998,
    "end": 37.75633449999998,
    "words": 4,
    "text": "И вот эта ДНК"
  },
  {
    "start": 37.75633449999998,
    "end": 39.361334499999984,
    "words": 4,
    "text": "уже совпала с уликами."
  },
  {
    "start": 39.393938499999976,
    "end": 40.71893849999998,
    "words": 4,
    "text": "Как у одного человека"
  },
  {
    "start": 40.71893849999998,
    "end": 43.09893849999998,
    "words": 5,
    "text": "могли оказаться два разных результата?"
  },
  {
    "start": 43.13854249999997,
    "end": 45.84420949999997,
    "words": 5,
    "text": "Позже появилась ещё одна пострадавшая."
  },
  {
    "start": 45.84420949999997,
    "end": 47.71445949999996,
    "words": 2,
    "text": "Расследование возобновили."
  },
  {
    "start": 47.71445949999996,
    "end": 50.069459499999965,
    "words": 4,
    "text": "Новые образцы, включая волосы,"
  },
  {
    "start": 50.21445949999996,
    "end": 52.09445949999997,
    "words": 4,
    "text": "связали врача с преступлением."
  },
  {
    "start": 52.31445949999995,
    "end": 53.426959499999946,
    "words": 4,
    "text": "А на суде раскрылась"
  },
  {
    "start": 53.426959499999946,
    "end": 55.49445949999995,
    "words": 3,
    "text": "причина прежних несовпадений."
  },
  {
    "start": 55.50498049999995,
    "end": 57.05498049999995,
    "words": 4,
    "text": "Врач спрятал под кожей"
  },
  {
    "start": 57.05498049999995,
    "end": 58.592626499999945,
    "words": 4,
    "text": "трубку с чужой кровью."
  },
  {
    "start": 58.592626499999945,
    "end": 60.055126499999936,
    "words": 4,
    "text": "Во время прежних проверок"
  },
  {
    "start": 60.055126499999936,
    "end": 62.01012649999994,
    "words": 4,
    "text": "кровь брали именно оттуда."
  },
  {
    "start": 62.02920949999993,
    "end": 63.65920949999993,
    "words": 4,
    "text": "Он обманул не анализ."
  },
  {
    "start": 63.73843849999994,
    "end": 66.34343849999993,
    "words": 5,
    "text": "Он подменил то, что анализировали."
  },
  {
    "start": 66.56343849999993,
    "end": 67.97927149999992,
    "words": 4,
    "text": "В тысяча девятьсот девяносто"
  },
  {
    "start": 67.97927149999992,
    "end": 69.48435449999994,
    "words": 4,
    "text": "девятом году Джона признали"
  },
  {
    "start": 69.48435449999994,
    "end": 71.10427149999992,
    "words": 4,
    "text": "виновным в сексуальном насилии"
  },
  {
    "start": 71.10427149999992,
    "end": 72.99864649999992,
    "words": 3,
    "text": "и препятствовании правосудию."
  },
  {
    "start": 72.99864649999992,
    "end": 75.13118849999992,
    "words": 5,
    "text": "Он получил шесть лет тюрьмы."
  },
  {
    "start": 75.14935549999993,
    "end": 77.01160549999992,
    "words": 4,
    "text": "А первая пострадавшая добивалась"
  },
  {
    "start": 77.01160549999992,
    "end": 78.27914649999991,
    "words": 3,
    "text": "этого семь лет."
  },
  {
    "start": 78.27914649999991,
    "end": 79.78427149999993,
    "words": 4,
    "text": "Достаточно ли шести лет"
  },
  {
    "start": 79.78427149999993,
    "end": 80.6516054999999,
    "words": 3,
    "text": "за насилие и"
  },
  {
    "start": 80.6516054999999,
    "end": 82.66935449999991,
    "words": 3,
    "text": "попытку обмануть правосудие?"
  }
]
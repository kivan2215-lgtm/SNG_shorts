[
  {
    "start": 0.05,
    "end": 1.1375,
    "words": 4,
    "text": "A woman accused her"
  },
  {
    "start": 1.1375,
    "end": 2.8425,
    "words": 4,
    "text": "doctor of sexual assault."
  },
  {
    "start": 2.9754579999999997,
    "end": 3.8129579999999996,
    "words": 3,
    "text": "But the DNA"
  },
  {
    "start": 3.8129579999999996,
    "end": 4.842958,
    "words": 3,
    "text": "did not match."
  },
  {
    "start": 4.988729000000001,
    "end": 6.006229,
    "words": 2,
    "text": "Not once."
  },
  {
    "start": 6.129437000000001,
    "end": 7.121937000000002,
    "words": 2,
    "text": "Not twice."
  },
  {
    "start": 7.245165999999999,
    "end": 8.212666,
    "words": 3,
    "text": "Was she wrong?"
  },
  {
    "start": 8.384561999999997,
    "end": 9.509561999999997,
    "words": 4,
    "text": "The answer was hiding"
  },
  {
    "start": 9.509561999999997,
    "end": 10.839561999999999,
    "words": 4,
    "text": "right beneath his skin."
  },
  {
    "start": 11.059061999999997,
    "end": 11.882144999999998,
    "words": 1,
    "text": "Canada."
  },
  {
    "start": 12.000290999999995,
    "end": 13.466915999999998,
    "words": 2,
    "text": "Nineteen ninety-two."
  },
  {
    "start": 13.640832999999999,
    "end": 14.544291,
    "words": 4,
    "text": "A patient said her"
  },
  {
    "start": 14.544291,
    "end": 15.522041,
    "words": 3,
    "text": "doctor had drugged"
  },
  {
    "start": 15.522041,
    "end": 16.295624,
    "words": 3,
    "text": "and raped her."
  },
  {
    "start": 16.421458,
    "end": 17.94375,
    "words": 4,
    "text": "Police collected evidence and"
  },
  {
    "start": 17.94375,
    "end": 18.828706999999998,
    "words": 3,
    "text": "took his blood."
  },
  {
    "start": 18.98022900000001,
    "end": 19.889937000000007,
    "words": 2,
    "text": "No match."
  },
  {
    "start": 20.025459000000012,
    "end": 21.801500000000008,
    "words": 4,
    "text": "She demanded another test."
  },
  {
    "start": 21.966688000000012,
    "end": 23.123896000000013,
    "words": 3,
    "text": "The same result."
  },
  {
    "start": 23.256209000000013,
    "end": 25.25504100000001,
    "words": 5,
    "text": "Eventually, the case was closed."
  },
  {
    "start": 25.47502150000001,
    "end": 26.387521500000013,
    "words": 3,
    "text": "But she refused"
  },
  {
    "start": 26.387521500000013,
    "end": 27.130021500000016,
    "words": 3,
    "text": "to give up."
  },
  {
    "start": 27.26920950000001,
    "end": 28.95670950000001,
    "words": 4,
    "text": "A private investigator obtained"
  },
  {
    "start": 28.95670950000001,
    "end": 29.669209500000008,
    "words": 3,
    "text": "lip balm from"
  },
  {
    "start": 29.669209500000008,
    "end": 30.761709500000006,
    "words": 3,
    "text": "the doctor's car."
  },
  {
    "start": 30.887063500000004,
    "end": 32.8170635,
    "words": 5,
    "text": "It carried traces of saliva."
  },
  {
    "start": 32.920480500000004,
    "end": 34.2829805,
    "words": 4,
    "text": "This time, the DNA"
  },
  {
    "start": 34.2829805,
    "end": 35.425480500000006,
    "words": 3,
    "text": "matched the evidence."
  },
  {
    "start": 35.5792725,
    "end": 36.4917725,
    "words": 4,
    "text": "How could one man"
  },
  {
    "start": 36.4917725,
    "end": 38.246772500000006,
    "words": 4,
    "text": "produce two different results?"
  },
  {
    "start": 38.39887649999999,
    "end": 40.5663765,
    "words": 5,
    "text": "Another victim later came forward."
  },
  {
    "start": 40.72016849999999,
    "end": 42.9501685,
    "words": 4,
    "text": "Investigators reopened the case."
  },
  {
    "start": 43.10931449999999,
    "end": 44.87681449999999,
    "words": 4,
    "text": "New samples, including hair,"
  },
  {
    "start": 44.97181449999999,
    "end": 45.75931449999999,
    "words": 3,
    "text": "linked the doctor"
  },
  {
    "start": 45.75931449999999,
    "end": 46.56431449999999,
    "words": 3,
    "text": "to the crime."
  },
  {
    "start": 46.78431449999998,
    "end": 48.07181449999998,
    "words": 4,
    "text": "At trial, the reason"
  },
  {
    "start": 48.07181449999998,
    "end": 50.01431449999998,
    "words": 5,
    "text": "for those earlier results emerged."
  },
  {
    "start": 50.16012749999997,
    "end": 50.860127499999976,
    "words": 4,
    "text": "He had hidden a"
  },
  {
    "start": 50.860127499999976,
    "end": 52.03512749999997,
    "words": 4,
    "text": "tube of someone else's"
  },
  {
    "start": 52.03512749999997,
    "end": 53.52762749999997,
    "words": 4,
    "text": "blood beneath his skin."
  },
  {
    "start": 53.68935649999996,
    "end": 55.16935649999997,
    "words": 4,
    "text": "During the earlier tests,"
  },
  {
    "start": 55.23935649999996,
    "end": 56.17685649999996,
    "words": 4,
    "text": "blood had been drawn"
  },
  {
    "start": 56.17685649999996,
    "end": 57.03185649999997,
    "words": 3,
    "text": "from that tube."
  },
  {
    "start": 57.24210649999996,
    "end": 57.84210649999996,
    "words": 3,
    "text": "He had not"
  },
  {
    "start": 57.84210649999996,
    "end": 59.197106499999954,
    "words": 3,
    "text": "fooled the analysis."
  },
  {
    "start": 59.31527349999996,
    "end": 60.25277349999996,
    "words": 4,
    "text": "He had switched what"
  },
  {
    "start": 60.25277349999996,
    "end": 61.52027349999995,
    "words": 3,
    "text": "was being analyzed."
  },
  {
    "start": 61.74127349999996,
    "end": 63.501481499999954,
    "words": 4,
    "text": "In nineteen ninety-nine, John"
  },
  {
    "start": 63.501481499999954,
    "end": 64.91731449999996,
    "words": 4,
    "text": "Schneeberger was convicted of"
  },
  {
    "start": 64.91731449999996,
    "end": 65.93773149999996,
    "words": 3,
    "text": "sexual assault and"
  },
  {
    "start": 65.93773149999996,
    "end": 67.30493949999996,
    "words": 3,
    "text": "obstruction of justice."
  },
  {
    "start": 67.44598149999996,
    "end": 68.46639849999995,
    "words": 3,
    "text": "He received six"
  },
  {
    "start": 68.46639849999995,
    "end": 69.50198149999996,
    "words": 3,
    "text": "years in prison."
  },
  {
    "start": 69.65575249999995,
    "end": 70.84196049999994,
    "words": 4,
    "text": "His first victim had"
  },
  {
    "start": 70.84196049999994,
    "end": 71.76033549999995,
    "words": 3,
    "text": "fought for justice"
  },
  {
    "start": 71.76033549999995,
    "end": 72.84696049999994,
    "words": 3,
    "text": "for seven years."
  },
  {
    "start": 73.00914849999994,
    "end": 74.04231549999994,
    "words": 4,
    "text": "Is six years enough"
  },
  {
    "start": 74.04231549999994,
    "end": 75.25402349999995,
    "words": 4,
    "text": "for sexual assault and"
  },
  {
    "start": 75.25402349999995,
    "end": 76.10860749999995,
    "words": 3,
    "text": "trying to deceive"
  },
  {
    "start": 76.10860749999995,
    "end": 77.23352349999993,
    "words": 3,
    "text": "the justice system?"
  }
]
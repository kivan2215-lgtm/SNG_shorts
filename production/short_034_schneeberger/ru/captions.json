[
  {
    "start": 0.05,
    "end": 2.5504379999999998,
    "words": 5,
    "text": "Женщина обвинила врача в насилии."
  },
  {
    "start": 2.5504379999999998,
    "end": 3.7004379999999997,
    "words": 4,
    "text": "Но анализ ДНК не"
  },
  {
    "start": 3.7004379999999997,
    "end": 5.180438,
    "words": 3,
    "text": "подтвердил её слова."
  },
  {
    "start": 5.214188,
    "end": 6.206688000000001,
    "words": 2,
    "text": "Ни первый."
  },
  {
    "start": 6.2436250000000015,
    "end": 7.236125,
    "words": 2,
    "text": "Ни второй."
  },
  {
    "start": 7.279542000000001,
    "end": 8.472042000000002,
    "words": 2,
    "text": "Она ошиблась?"
  },
  {
    "start": 8.537353999999999,
    "end": 9.912353999999999,
    "words": 4,
    "text": "Разгадка всё это время"
  },
  {
    "start": 9.912353999999999,
    "end": 11.892354000000001,
    "words": 5,
    "text": "скрывалась прямо под его кожей."
  },
  {
    "start": 12.112354,
    "end": 12.910687,
    "words": 1,
    "text": "Канада."
  },
  {
    "start": 12.962208000000002,
    "end": 15.208541000000004,
    "words": 5,
    "text": "Тысяча девятьсот девяносто второй год."
  },
  {
    "start": 15.218333000000007,
    "end": 17.050000000000004,
    "words": 4,
    "text": "Пациентка заявила, что врач"
  },
  {
    "start": 17.050000000000004,
    "end": 19.036458000000007,
    "words": 5,
    "text": "ввёл ей препарат и изнасиловал."
  },
  {
    "start": 19.08220800000001,
    "end": 20.765375000000013,
    "words": 4,
    "text": "Полиция получила улики и"
  },
  {
    "start": 20.765375000000013,
    "end": 21.984458000000007,
    "words": 4,
    "text": "взяла у него кровь."
  },
  {
    "start": 22.03800000000001,
    "end": 23.41800000000001,
    "words": 2,
    "text": "Совпадения нет."
  },
  {
    "start": 23.45948000000002,
    "end": 26.11418700000002,
    "words": 4,
    "text": "Женщина потребовала повторной проверки."
  },
  {
    "start": 26.16935500000001,
    "end": 27.586479000000008,
    "words": 3,
    "text": "Результат тот же."
  },
  {
    "start": 27.630813000000003,
    "end": 29.332605000000004,
    "words": 4,
    "text": "В итоге дело закрыли."
  },
  {
    "start": 29.552584500000002,
    "end": 31.107584500000005,
    "words": 4,
    "text": "Но она не отступила."
  },
  {
    "start": 31.129980500000002,
    "end": 32.729980499999996,
    "words": 4,
    "text": "Частный детектив добыл из"
  },
  {
    "start": 32.729980499999996,
    "end": 34.6224805,
    "words": 5,
    "text": "машины врача бальзам для губ."
  },
  {
    "start": 34.65908449999999,
    "end": 36.764084499999996,
    "words": 5,
    "text": "На нём остались следы слюны."
  },
  {
    "start": 36.79195949999999,
    "end": 37.77945949999999,
    "words": 4,
    "text": "И вот эта ДНК"
  },
  {
    "start": 37.77945949999999,
    "end": 39.38445949999999,
    "words": 4,
    "text": "уже совпала с уликами."
  },
  {
    "start": 39.416376499999984,
    "end": 40.74137649999999,
    "words": 4,
    "text": "Как у одного человека"
  },
  {
    "start": 40.74137649999999,
    "end": 43.12137649999999,
    "words": 5,
    "text": "могли оказаться два разных результата?"
  },
  {
    "start": 43.16039749999998,
    "end": 45.855793499999976,
    "words": 5,
    "text": "Позже появилась ещё одна пострадавшая."
  },
  {
    "start": 45.855793499999976,
    "end": 47.72437649999998,
    "words": 2,
    "text": "Расследование возобновили."
  },
  {
    "start": 47.72437649999998,
    "end": 50.054376499999975,
    "words": 4,
    "text": "Новые образцы, включая волосы,"
  },
  {
    "start": 50.211876499999974,
    "end": 52.079376499999974,
    "words": 4,
    "text": "связали врача с преступлением."
  },
  {
    "start": 52.299376499999966,
    "end": 53.41187649999996,
    "words": 4,
    "text": "А на суде раскрылась"
  },
  {
    "start": 53.41187649999996,
    "end": 55.479376499999965,
    "words": 3,
    "text": "причина прежних несовпадений."
  },
  {
    "start": 55.48035549999997,
    "end": 57.04285549999997,
    "words": 4,
    "text": "Врач спрятал под кожей"
  },
  {
    "start": 57.04285549999997,
    "end": 58.610355499999976,
    "words": 4,
    "text": "трубку с чужой кровью."
  },
  {
    "start": 58.61783449999997,
    "end": 60.08033449999998,
    "words": 4,
    "text": "Во время прежних проверок"
  },
  {
    "start": 60.08033449999998,
    "end": 62.03533449999997,
    "words": 4,
    "text": "кровь брали именно оттуда."
  },
  {
    "start": 62.05643849999997,
    "end": 63.68643849999997,
    "words": 4,
    "text": "Он обманул не анализ."
  },
  {
    "start": 63.776271499999964,
    "end": 66.38127149999995,
    "words": 5,
    "text": "Он подменил то, что анализировали."
  },
  {
    "start": 66.60127149999997,
    "end": 68.01710449999997,
    "words": 4,
    "text": "В тысяча девятьсот девяносто"
  },
  {
    "start": 68.01710449999997,
    "end": 69.50943749999998,
    "words": 4,
    "text": "девятом году Джона признали"
  },
  {
    "start": 69.50943749999998,
    "end": 71.12931249999997,
    "words": 4,
    "text": "виновным в сексуальном насилии"
  },
  {
    "start": 71.12931249999997,
    "end": 73.01839549999997,
    "words": 3,
    "text": "и препятствовании правосудию."
  },
  {
    "start": 73.01839549999997,
    "end": 75.15093749999997,
    "words": 5,
    "text": "Он получил шесть лет тюрьмы."
  },
  {
    "start": 75.16754149999996,
    "end": 77.02979149999996,
    "words": 4,
    "text": "А первая пострадавшая добивалась"
  },
  {
    "start": 77.02979149999996,
    "end": 78.30774949999996,
    "words": 3,
    "text": "этого семь лет."
  },
  {
    "start": 78.31283249999994,
    "end": 79.88170749999995,
    "words": 4,
    "text": "Достаточно ли шести лет"
  },
  {
    "start": 79.88170749999995,
    "end": 80.74904149999995,
    "words": 3,
    "text": "за насилие и"
  },
  {
    "start": 80.74904149999995,
    "end": 82.74129049999995,
    "words": 3,
    "text": "попытку обмануть правосудие?"
  }
]
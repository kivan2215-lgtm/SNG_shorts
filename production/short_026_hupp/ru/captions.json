[
  {
    "start": 0.05,
    "end": 1.8175,
    "words": 4,
    "text": "Женщина позвонила в полицию:"
  },
  {
    "start": 1.8375,
    "end": 4.05,
    "words": 4,
    "text": "она застрелила незнакомца, который"
  },
  {
    "start": 4.05,
    "end": 4.925,
    "words": 3,
    "text": "якобы напал на"
  },
  {
    "start": 4.925,
    "end": 5.8549999999999995,
    "words": 3,
    "text": "неё с ножом."
  },
  {
    "start": 5.859688000000001,
    "end": 6.422188000000001,
    "words": 3,
    "text": "Но в его"
  },
  {
    "start": 6.422188000000001,
    "end": 8.064688000000002,
    "words": 3,
    "text": "кармане нашли записку."
  },
  {
    "start": 8.122188,
    "end": 8.859688,
    "words": 3,
    "text": "И дело о"
  },
  {
    "start": 8.859688,
    "end": 10.852188,
    "words": 3,
    "text": "самообороне начало рассыпаться."
  },
  {
    "start": 11.072188,
    "end": 13.873729,
    "words": 5,
    "text": "Миссури, две тысячи шестнадцатый год."
  },
  {
    "start": 13.919104000000003,
    "end": 16.137271,
    "words": 4,
    "text": "Хозяйка утверждала: мужчина хотел"
  },
  {
    "start": 16.137271,
    "end": 17.387271,
    "words": 4,
    "text": "её похитить и забрать"
  },
  {
    "start": 17.387271,
    "end": 18.620186999999998,
    "words": 3,
    "text": "деньги из банка."
  },
  {
    "start": 18.644188000000007,
    "end": 20.323104000000008,
    "words": 4,
    "text": "При погибшем нашли инструкции"
  },
  {
    "start": 20.323104000000008,
    "end": 21.580521000000008,
    "words": 3,
    "text": "и девятьсот долларов."
  },
  {
    "start": 21.634875000000008,
    "end": 23.056458000000006,
    "words": 4,
    "text": "Но Луис после тяжёлой"
  },
  {
    "start": 23.056458000000006,
    "end": 23.80400000000001,
    "words": 3,
    "text": "аварии жил с"
  },
  {
    "start": 23.80400000000001,
    "end": 25.811479000000006,
    "words": 3,
    "text": "серьёзными нарушениями здоровья."
  },
  {
    "start": 25.811479000000006,
    "end": 27.441395000000007,
    "words": 4,
    "text": "А телефон хозяйки незадолго"
  },
  {
    "start": 27.441395000000007,
    "end": 28.56881200000001,
    "words": 3,
    "text": "до стрельбы находился"
  },
  {
    "start": 28.56881200000001,
    "end": 29.691478000000007,
    "words": 3,
    "text": "возле его дома."
  },
  {
    "start": 29.700000000000003,
    "end": 31.570165999999997,
    "words": 4,
    "text": "Зачем она туда ездила?"
  },
  {
    "start": 31.790145833333327,
    "end": 33.93743683333333,
    "words": 3,
    "text": "Затем нашлась свидетельница."
  },
  {
    "start": 33.95668683333333,
    "end": 35.924520833333325,
    "words": 4,
    "text": "Незнакомка предложила ей тысячу"
  },
  {
    "start": 35.924520833333325,
    "end": 37.186895833333324,
    "words": 3,
    "text": "долларов за постановочный"
  },
  {
    "start": 37.186895833333324,
    "end": 38.38812383333332,
    "words": 3,
    "text": "звонок в полицию."
  },
  {
    "start": 38.38812383333332,
    "end": 40.10229083333332,
    "words": 2,
    "text": "Женщина отказалась."
  },
  {
    "start": 40.17147783333331,
    "end": 41.24822783333331,
    "words": 3,
    "text": "А домашняя камера"
  },
  {
    "start": 41.24822783333331,
    "end": 43.32126983333332,
    "words": 3,
    "text": "сняла автомобиль посетительницы."
  },
  {
    "start": 43.35260283333331,
    "end": 45.74118583333331,
    "words": 4,
    "text": "Следователи установили: это машина"
  },
  {
    "start": 45.74118583333331,
    "end": 47.195477833333314,
    "words": 3,
    "text": "той самой хозяйки."
  },
  {
    "start": 47.4154573333333,
    "end": 48.70412333333331,
    "words": 3,
    "text": "И обнаружилась связь"
  },
  {
    "start": 48.70412333333331,
    "end": 49.8908313333333,
    "words": 3,
    "text": "со старым делом."
  },
  {
    "start": 49.9069563333333,
    "end": 51.2729563333333,
    "words": 4,
    "text": "В две тысячи одиннадцатом"
  },
  {
    "start": 51.2729563333333,
    "end": 53.3257893333333,
    "words": 4,
    "text": "году убили Бетси Фарию."
  },
  {
    "start": 53.3257893333333,
    "end": 55.245873333333286,
    "words": 4,
    "text": "Её мужа осудили, но"
  },
  {
    "start": 55.245873333333286,
    "end": 57.31724833333329,
    "words": 4,
    "text": "на повторном процессе оправдали."
  },
  {
    "start": 57.31724833333329,
    "end": 58.79920633333328,
    "words": 4,
    "text": "А хозяйка дома получила"
  },
  {
    "start": 58.79920633333328,
    "end": 60.409998333333284,
    "words": 4,
    "text": "сто пятьдесят тысяч долларов"
  },
  {
    "start": 60.409998333333284,
    "end": 61.77712333333329,
    "words": 3,
    "text": "по страховке Бетси."
  },
  {
    "start": 61.997123333333285,
    "end": 63.91283033333329,
    "words": 4,
    "text": "Её звали Памела Хапп."
  },
  {
    "start": 63.96456033333329,
    "end": 65.71201833333329,
    "words": 4,
    "text": "По версии прокуратуры, она"
  },
  {
    "start": 65.71201833333329,
    "end": 67.5742683333333,
    "words": 4,
    "text": "заманила Луиса, убила его"
  },
  {
    "start": 67.5742683333333,
    "end": 69.27068533333329,
    "words": 4,
    "text": "и подбросила записку, чтобы"
  },
  {
    "start": 69.27068533333329,
    "end": 71.55631033333329,
    "words": 4,
    "text": "подставить оправданного мужа Бетси."
  },
  {
    "start": 71.59431033333328,
    "end": 72.98460233333329,
    "words": 4,
    "text": "В две тысячи девятнадцатом"
  },
  {
    "start": 72.98460233333329,
    "end": 74.22185233333329,
    "words": 4,
    "text": "году за убийство Луиса"
  },
  {
    "start": 74.22185233333329,
    "end": 75.9820603333333,
    "words": 4,
    "text": "Хапп получила пожизненный срок"
  },
  {
    "start": 75.9820603333333,
    "end": 77.68093533333328,
    "words": 4,
    "text": "без права на освобождение."
  },
  {
    "start": 77.68349733333328,
    "end": 79.57124733333328,
    "words": 4,
    "text": "Человек погиб, чтобы чужая"
  },
  {
    "start": 79.57124733333328,
    "end": 81.60178933333327,
    "words": 3,
    "text": "ложь выглядела убедительнее."
  }
]
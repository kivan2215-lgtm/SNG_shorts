[
  {
    "start": 0.05,
    "end": 0.9625,
    "words": 4,
    "text": "A man was shot"
  },
  {
    "start": 0.9625,
    "end": 2.2925,
    "words": 4,
    "text": "dead in broad daylight."
  },
  {
    "start": 2.4526459999999997,
    "end": 4.5826459999999996,
    "words": 5,
    "text": "Dozens of witnesses stood nearby."
  },
  {
    "start": 4.739521000000002,
    "end": 6.102021000000001,
    "words": 4,
    "text": "But almost everyone told"
  },
  {
    "start": 6.102021000000001,
    "end": 7.077021000000002,
    "words": 4,
    "text": "police they had not"
  },
  {
    "start": 7.077021000000002,
    "end": 8.007021000000002,
    "words": 3,
    "text": "seen the shooter."
  },
  {
    "start": 8.226021000000001,
    "end": 9.667312000000003,
    "words": 2,
    "text": "Skidmore, Missouri."
  },
  {
    "start": 9.793646,
    "end": 11.087896,
    "words": 2,
    "text": "Nineteen eighty-one."
  },
  {
    "start": 11.283082999999998,
    "end": 12.729166,
    "words": 4,
    "text": "Ken McElroy had frightened"
  },
  {
    "start": 12.729166,
    "end": 13.864040999999999,
    "words": 4,
    "text": "the town for years."
  },
  {
    "start": 14.009937,
    "end": 15.909437,
    "words": 4,
    "text": "He threatened neighbors, intimidated"
  },
  {
    "start": 15.909437,
    "end": 18.184061999999997,
    "words": 5,
    "text": "witnesses, and kept avoiding punishment."
  },
  {
    "start": 18.312688000000005,
    "end": 19.121521000000005,
    "words": 4,
    "text": "Then he shot an"
  },
  {
    "start": 19.121521000000005,
    "end": 20.746604,
    "words": 4,
    "text": "elderly grocery store owner."
  },
  {
    "start": 20.849084000000005,
    "end": 22.069750000000003,
    "words": 3,
    "text": "The man survived."
  },
  {
    "start": 22.199646000000005,
    "end": 23.06973000000001,
    "words": 3,
    "text": "This time, a"
  },
  {
    "start": 23.06973000000001,
    "end": 24.768355000000007,
    "words": 3,
    "text": "jury convicted McElroy."
  },
  {
    "start": 24.95285500000001,
    "end": 25.884230000000006,
    "words": 4,
    "text": "But he was released"
  },
  {
    "start": 25.884230000000006,
    "end": 27.42356300000001,
    "words": 5,
    "text": "on bond while he appealed."
  },
  {
    "start": 27.532064000000002,
    "end": 28.647272000000005,
    "words": 4,
    "text": "Soon he returned to"
  },
  {
    "start": 28.647272000000005,
    "end": 29.456105000000004,
    "words": 3,
    "text": "the local bar"
  },
  {
    "start": 29.456105000000004,
    "end": 30.198855000000002,
    "words": 3,
    "text": "with a gun."
  },
  {
    "start": 30.366418,
    "end": 32.175334,
    "words": 5,
    "text": "And threatened the grocer again."
  },
  {
    "start": 32.39481383333333,
    "end": 34.02847983333332,
    "words": 4,
    "text": "On July tenth, residents"
  },
  {
    "start": 34.02847983333332,
    "end": 35.06810483333332,
    "words": 4,
    "text": "gathered to discuss how"
  },
  {
    "start": 35.06810483333332,
    "end": 36.37385483333333,
    "words": 3,
    "text": "to protect themselves."
  },
  {
    "start": 36.51816783333332,
    "end": 38.06520983333333,
    "words": 4,
    "text": "Meanwhile, McElroy and his"
  },
  {
    "start": 38.06520983333333,
    "end": 39.46995883333333,
    "words": 5,
    "text": "wife arrived at the bar."
  },
  {
    "start": 39.61012583333331,
    "end": 41.20054183333331,
    "words": 5,
    "text": "The crowd headed there too."
  },
  {
    "start": 41.40287583333331,
    "end": 42.343458833333315,
    "words": 4,
    "text": "Ken walked out and"
  },
  {
    "start": 42.343458833333315,
    "end": 43.67395883333331,
    "words": 4,
    "text": "climbed into his pickup."
  },
  {
    "start": 43.808959833333304,
    "end": 45.164250833333305,
    "words": 4,
    "text": "People stood around him."
  },
  {
    "start": 45.3223348333333,
    "end": 46.71470883333331,
    "words": 4,
    "text": "Then shots rang out."
  },
  {
    "start": 46.8473138333333,
    "end": 48.2768138333333,
    "words": 3,
    "text": "McElroy was dead."
  },
  {
    "start": 48.49833456666663,
    "end": 49.49062666666663,
    "words": 4,
    "text": "His wife said she"
  },
  {
    "start": 49.49062666666663,
    "end": 51.19279266666663,
    "words": 5,
    "text": "recognized one of the gunmen."
  },
  {
    "start": 51.38350166666662,
    "end": 52.73658566666663,
    "words": 4,
    "text": "But other witnesses said"
  },
  {
    "start": 52.73658566666663,
    "end": 53.936168666666624,
    "words": 4,
    "text": "they had seen nothing."
  },
  {
    "start": 54.14481366666662,
    "end": 56.336688666666625,
    "words": 4,
    "text": "Even the FBI investigated."
  },
  {
    "start": 56.45510566666661,
    "end": 58.18302166666661,
    "words": 5,
    "text": "Yet no charges were filed."
  },
  {
    "start": 58.3105226666666,
    "end": 59.5745226666666,
    "words": 2,
    "text": "Decades passed."
  },
  {
    "start": 59.701584666666605,
    "end": 61.60991766666661,
    "words": 4,
    "text": "The killing remained unsolved."
  },
  {
    "start": 61.83089783333327,
    "end": 62.787563833333266,
    "words": 4,
    "text": "The town had feared"
  },
  {
    "start": 62.787563833333266,
    "end": 63.52735583333326,
    "words": 4,
    "text": "a man the law"
  },
  {
    "start": 63.52735583333326,
    "end": 64.55018883333327,
    "words": 3,
    "text": "could not stop."
  },
  {
    "start": 64.68550183333326,
    "end": 65.85896083333327,
    "words": 4,
    "text": "After his death, the"
  },
  {
    "start": 65.85896083333327,
    "end": 67.37929283333327,
    "words": 4,
    "text": "law was powerless again."
  },
  {
    "start": 67.56452283333326,
    "end": 68.54668983333326,
    "words": 3,
    "text": "Only now, the"
  },
  {
    "start": 68.54668983333326,
    "end": 69.68431483333326,
    "words": 3,
    "text": "town was silent."
  },
  {
    "start": 69.80541883333325,
    "end": 71.08337683333325,
    "words": 3,
    "text": "Was this justice?"
  },
  {
    "start": 71.25085683333324,
    "end": 71.90139783333325,
    "words": 3,
    "text": "Or a murder"
  },
  {
    "start": 71.90139783333325,
    "end": 73.29414783333324,
    "words": 3,
    "text": "nobody answered for?"
  }
]
[
  {
    "start": 0.05,
    "end": 2.505,
    "words": 5,
    "text": "Мужчину застрелили среди бела дня."
  },
  {
    "start": 2.527125,
    "end": 5.044625,
    "words": 4,
    "text": "Вокруг стояли десятки свидетелей."
  },
  {
    "start": 5.050188000000001,
    "end": 6.475188000000001,
    "words": 4,
    "text": "Но полиции почти все"
  },
  {
    "start": 6.475188000000001,
    "end": 8.705188000000001,
    "words": 4,
    "text": "сказали: стрелявшего не видели."
  },
  {
    "start": 8.925188000000002,
    "end": 10.697354000000002,
    "words": 2,
    "text": "Скидмор, Миссури."
  },
  {
    "start": 10.758645999999999,
    "end": 13.217103,
    "words": 5,
    "text": "Тысяча девятьсот восемьдесят первый год."
  },
  {
    "start": 13.246354,
    "end": 15.582271000000004,
    "words": 5,
    "text": "Кена Макэлроя боялся весь город."
  },
  {
    "start": 15.609771000000002,
    "end": 17.455479,
    "words": 4,
    "text": "Он годами угрожал соседям,"
  },
  {
    "start": 17.582813,
    "end": 20.276313000000005,
    "words": 5,
    "text": "запугивал свидетелей и избегал наказания."
  },
  {
    "start": 20.276313000000005,
    "end": 21.893979000000005,
    "words": 4,
    "text": "Однажды Кен выстрелил в"
  },
  {
    "start": 21.893979000000005,
    "end": 23.641604000000005,
    "words": 3,
    "text": "пожилого владельца магазина."
  },
  {
    "start": 23.692208000000008,
    "end": 24.667791000000005,
    "words": 2,
    "text": "Тот выжил."
  },
  {
    "start": 24.73162500000001,
    "end": 25.83454200000001,
    "words": 4,
    "text": "На этот раз суд"
  },
  {
    "start": 25.83454200000001,
    "end": 27.533166000000005,
    "words": 3,
    "text": "признал Макэлроя виновным."
  },
  {
    "start": 27.558729000000007,
    "end": 29.249896,
    "words": 4,
    "text": "Но до рассмотрения апелляции"
  },
  {
    "start": 29.249896,
    "end": 30.764729,
    "words": 4,
    "text": "его отпустили под залог."
  },
  {
    "start": 30.792769999999997,
    "end": 32.373644999999996,
    "words": 4,
    "text": "Вскоре он снова пришёл"
  },
  {
    "start": 32.373644999999996,
    "end": 33.447269999999996,
    "words": 4,
    "text": "в бар с оружием."
  },
  {
    "start": 33.480895,
    "end": 35.86577,
    "words": 5,
    "text": "И опять угрожал владельцу магазина."
  },
  {
    "start": 36.08574983333332,
    "end": 38.07833283333332,
    "words": 4,
    "text": "Десятого июля жители собрались"
  },
  {
    "start": 38.07833283333332,
    "end": 40.02762383333332,
    "words": 3,
    "text": "обсудить, как защититься."
  },
  {
    "start": 40.05841583333332,
    "end": 41.38266583333332,
    "words": 4,
    "text": "В это время Макэлрой"
  },
  {
    "start": 41.38266583333332,
    "end": 42.94833183333332,
    "words": 5,
    "text": "с женой приехал к бару."
  },
  {
    "start": 42.99876983333331,
    "end": 44.82431083333332,
    "words": 4,
    "text": "Люди направились туда же."
  },
  {
    "start": 44.863519833333314,
    "end": 45.828852833333315,
    "words": 3,
    "text": "Кен вышел и"
  },
  {
    "start": 45.828852833333315,
    "end": 46.80043583333332,
    "words": 3,
    "text": "сел в пикап."
  },
  {
    "start": 46.83972883333332,
    "end": 48.51672783333332,
    "words": 3,
    "text": "Его окружала толпа."
  },
  {
    "start": 48.572228833333305,
    "end": 50.43493683333331,
    "words": 3,
    "text": "Затем раздались выстрелы."
  },
  {
    "start": 50.4777288333333,
    "end": 51.882477833333304,
    "words": 2,
    "text": "Макэлрой погиб."
  },
  {
    "start": 52.10245799999996,
    "end": 53.97099899999997,
    "words": 4,
    "text": "Его жена утверждала: она"
  },
  {
    "start": 53.97099899999997,
    "end": 55.87937399999997,
    "words": 4,
    "text": "узнала одного из стрелявших."
  },
  {
    "start": 55.93237399999996,
    "end": 57.776289999999975,
    "words": 4,
    "text": "Но другие свидетели говорили,"
  },
  {
    "start": 57.916915999999965,
    "end": 59.422519999999956,
    "words": 4,
    "text": "что ничего не видели."
  },
  {
    "start": 59.422519999999956,
    "end": 62.063456999999964,
    "words": 4,
    "text": "Расследованием занялось даже ФБР."
  },
  {
    "start": 62.063456999999964,
    "end": 63.687165999999955,
    "words": 3,
    "text": "Однако обвинений так"
  },
  {
    "start": 63.687165999999955,
    "end": 64.72158199999996,
    "words": 3,
    "text": "и не предъявили."
  },
  {
    "start": 64.72158199999996,
    "end": 66.37333199999995,
    "words": 2,
    "text": "Прошли десятилетия."
  },
  {
    "start": 66.37333199999995,
    "end": 68.66828999999996,
    "words": 3,
    "text": "Убийство осталось нераскрытым."
  },
  {
    "start": 68.88826983333328,
    "end": 71.2224358333333,
    "words": 4,
    "text": "Жители боялись человека, которого"
  },
  {
    "start": 71.2224358333333,
    "end": 72.92131083333328,
    "words": 4,
    "text": "закон не смог остановить."
  },
  {
    "start": 72.9741438333333,
    "end": 74.19864383333328,
    "words": 4,
    "text": "Но после его смерти"
  },
  {
    "start": 74.19864383333328,
    "end": 76.39497783333329,
    "words": 4,
    "text": "закон снова оказался бессилен."
  },
  {
    "start": 76.44378983333328,
    "end": 78.39778983333326,
    "words": 4,
    "text": "Только теперь молчал город."
  },
  {
    "start": 78.43583183333328,
    "end": 79.87958183333328,
    "words": 2,
    "text": "Это справедливость?"
  },
  {
    "start": 79.93733183333327,
    "end": 81.65929083333327,
    "words": 4,
    "text": "Или убийство, за которое"
  },
  {
    "start": 81.65929083333327,
    "end": 82.82241483333326,
    "words": 3,
    "text": "никто не ответил?"
  }
]
[
  {
    "start": 0.05,
    "end": 1.802458,
    "words": 4,
    "text": "Австралия отправила солдат с"
  },
  {
    "start": 1.802458,
    "end": 3.3784989999999997,
    "words": 3,
    "text": "пулемётами против птиц."
  },
  {
    "start": 3.4547290000000004,
    "end": 4.859228,
    "words": 2,
    "text": "Да, блядь."
  },
  {
    "start": 4.925500000000001,
    "end": 6.084916000000001,
    "words": 2,
    "text": "Против птиц."
  },
  {
    "start": 6.153479000000002,
    "end": 7.3666870000000015,
    "words": 4,
    "text": "И очень скоро людям"
  },
  {
    "start": 7.3666870000000015,
    "end": 8.599645000000004,
    "words": 4,
    "text": "стало не до понтов."
  },
  {
    "start": 8.819625166666668,
    "end": 11.081999166666668,
    "words": 5,
    "text": "Тысяча девятьсот тридцать второй год."
  },
  {
    "start": 11.103021166666668,
    "end": 13.291854166666669,
    "words": 4,
    "text": "Тысячи эму топчут пшеницу."
  },
  {
    "start": 13.347626166666668,
    "end": 15.119792166666668,
    "words": 3,
    "text": "Фермеры просят помощи."
  },
  {
    "start": 15.168459166666672,
    "end": 16.903834166666673,
    "words": 3,
    "text": "Приезжают трое военных."
  },
  {
    "start": 16.95937516666667,
    "end": 18.368708166666675,
    "words": 4,
    "text": "С двумя пулемётами и"
  },
  {
    "start": 18.368708166666675,
    "end": 20.21441716666667,
    "words": 3,
    "text": "десятью тысячами патронов."
  },
  {
    "start": 20.278250166666673,
    "end": 21.854333166666674,
    "words": 3,
    "text": "У птиц ноги."
  },
  {
    "start": 21.87908416666668,
    "end": 23.491958166666677,
    "words": 3,
    "text": "Охуенный баланс сил."
  },
  {
    "start": 23.711938333333347,
    "end": 26.182604333333344,
    "words": 5,
    "text": "Но эму разбегаются маленькими группами."
  },
  {
    "start": 26.213333333333342,
    "end": 28.269333333333332,
    "words": 5,
    "text": "Солдаты не успевают за ними."
  },
  {
    "start": 28.269333333333332,
    "end": 30.494916333333336,
    "words": 5,
    "text": "Тогда устраивают засаду у воды."
  },
  {
    "start": 30.51923033333333,
    "end": 32.420167333333325,
    "words": 3,
    "text": "Подходит огромная стая."
  },
  {
    "start": 32.420167333333325,
    "end": 34.47416633333332,
    "words": 4,
    "text": "Вот он, звёздный час!"
  },
  {
    "start": 34.57397933333331,
    "end": 36.22360433333332,
    "words": 3,
    "text": "И пулемёт заклинивает."
  },
  {
    "start": 36.23858433333331,
    "end": 37.76562533333331,
    "words": 2,
    "text": "Пернатые сваливают."
  },
  {
    "start": 37.7915003333333,
    "end": 40.78912533333331,
    "words": 5,
    "text": "Человеческий интеллект берёт технический перерыв."
  },
  {
    "start": 41.00910516666663,
    "end": 41.82539616666664,
    "words": 1,
    "text": "Ладно."
  },
  {
    "start": 41.87891816666662,
    "end": 43.63879316666664,
    "words": 4,
    "text": "Пулемёт ставят на грузовик."
  },
  {
    "start": 43.69552216666662,
    "end": 45.40639716666663,
    "words": 3,
    "text": "Теперь точно догонят!"
  },
  {
    "start": 45.44216716666662,
    "end": 46.94470816666662,
    "words": 4,
    "text": "Но машину так трясёт,"
  },
  {
    "start": 47.01079216666662,
    "end": 49.16283316666662,
    "words": 4,
    "text": "что нормально стрелять невозможно."
  },
  {
    "start": 49.21262616666661,
    "end": 50.899001166666615,
    "words": 3,
    "text": "Птицы снова уходят."
  },
  {
    "start": 50.93500116666662,
    "end": 52.30275016666662,
    "words": 2,
    "text": "Купили мобильность."
  },
  {
    "start": 52.354772166666606,
    "end": 53.955355166666614,
    "words": 3,
    "text": "Получили массаж жопы."
  },
  {
    "start": 54.00216816666661,
    "end": 55.615042166666605,
    "words": 2,
    "text": "Военных отзывают."
  },
  {
    "start": 55.655543166666604,
    "end": 57.3418761666666,
    "words": 3,
    "text": "Потом отправляют обратно."
  },
  {
    "start": 57.4070651666666,
    "end": 59.21598116666659,
    "words": 4,
    "text": "Проблему это не решает."
  },
  {
    "start": 59.43596099999992,
    "end": 61.09846099999993,
    "words": 4,
    "text": "Птицы погибали, так что"
  },
  {
    "start": 61.09846099999993,
    "end": 63.203460999999926,
    "words": 5,
    "text": "бескровной победой это не назовёшь."
  },
  {
    "start": 63.27656499999992,
    "end": 65.30656499999992,
    "words": 4,
    "text": "Но армейская операция закончилась,"
  },
  {
    "start": 65.43906499999993,
    "end": 67.19235699999993,
    "words": 5,
    "text": "а фермеры остались с эму."
  },
  {
    "start": 67.19235699999993,
    "end": 68.55485699999993,
    "words": 4,
    "text": "История вошла в память"
  },
  {
    "start": 68.55485699999993,
    "end": 69.93485699999992,
    "words": 4,
    "text": "как война с птицами."
  },
  {
    "start": 69.96985699999993,
    "end": 71.18235699999993,
    "words": 4,
    "text": "И вот вопрос: на"
  },
  {
    "start": 71.18235699999993,
    "end": 72.23235699999992,
    "words": 4,
    "text": "каком этапе надо было"
  },
  {
    "start": 72.23235699999992,
    "end": 74.66235699999993,
    "words": 5,
    "text": "признать, что план полная херня?"
  }
]
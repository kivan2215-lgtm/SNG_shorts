[
  {
    "start": 0.049,
    "end": 1.580875,
    "words": 4,
    "text": "Australia sent soldiers with"
  },
  {
    "start": 1.580875,
    "end": 3.181457,
    "words": 5,
    "text": "machine guns to fight birds."
  },
  {
    "start": 3.324249,
    "end": 4.030249,
    "words": 1,
    "text": "Yes."
  },
  {
    "start": 4.084416000000001,
    "end": 5.194832000000001,
    "words": 2,
    "text": "Fucking birds."
  },
  {
    "start": 5.344291,
    "end": 6.361416,
    "words": 4,
    "text": "The humans were about"
  },
  {
    "start": 6.361416,
    "end": 6.729082,
    "words": 3,
    "text": "to have a"
  },
  {
    "start": 6.729082,
    "end": 7.925249,
    "words": 3,
    "text": "very awkward week."
  },
  {
    "start": 8.1442285,
    "end": 9.512019500000003,
    "words": 3,
    "text": "Nineteen thirty two."
  },
  {
    "start": 9.634207499999999,
    "end": 10.7126235,
    "words": 3,
    "text": "Thousands of emus"
  },
  {
    "start": 10.7126235,
    "end": 11.7617485,
    "words": 3,
    "text": "are trampling wheat."
  },
  {
    "start": 11.844249499999998,
    "end": 13.4080815,
    "words": 4,
    "text": "Farmers ask for help."
  },
  {
    "start": 13.451936499999999,
    "end": 15.2241035,
    "words": 4,
    "text": "Three military men arrive."
  },
  {
    "start": 15.3524575,
    "end": 16.6344155,
    "words": 3,
    "text": "Two machine guns."
  },
  {
    "start": 16.7825205,
    "end": 18.1992705,
    "words": 3,
    "text": "Ten thousand rounds."
  },
  {
    "start": 18.341062500000003,
    "end": 19.7333125,
    "words": 4,
    "text": "The birds have legs."
  },
  {
    "start": 19.885770500000007,
    "end": 21.584395500000007,
    "words": 3,
    "text": "Brilliant fucking matchmaking."
  },
  {
    "start": 21.80337533333334,
    "end": 23.06566633333334,
    "words": 4,
    "text": "But the emus scatter"
  },
  {
    "start": 23.06566633333334,
    "end": 24.200541333333337,
    "words": 3,
    "text": "into small groups."
  },
  {
    "start": 24.358687333333343,
    "end": 26.020603333333344,
    "words": 5,
    "text": "The soldiers cannot keep up."
  },
  {
    "start": 26.18750033333334,
    "end": 26.935041333333338,
    "words": 4,
    "text": "So they set an"
  },
  {
    "start": 26.935041333333338,
    "end": 28.253749333333335,
    "words": 4,
    "text": "ambush by the water."
  },
  {
    "start": 28.357041333333335,
    "end": 29.969874333333333,
    "words": 4,
    "text": "A huge flock approaches."
  },
  {
    "start": 30.045687333333333,
    "end": 31.866854333333333,
    "words": 4,
    "text": "Finally, their big moment!"
  },
  {
    "start": 32.01489533333333,
    "end": 33.468437333333334,
    "words": 4,
    "text": "The machine gun jams."
  },
  {
    "start": 33.60060333333332,
    "end": 34.760061333333326,
    "words": 3,
    "text": "The birds leave."
  },
  {
    "start": 34.886166333333314,
    "end": 36.099416333333316,
    "words": 3,
    "text": "Human intelligence is"
  },
  {
    "start": 36.099416333333316,
    "end": 38.312749333333315,
    "words": 3,
    "text": "experiencing technical difficulties."
  },
  {
    "start": 38.53172949999998,
    "end": 39.176437499999984,
    "words": 1,
    "text": "Fine."
  },
  {
    "start": 39.351645499999975,
    "end": 40.319770499999976,
    "words": 4,
    "text": "Put a machine gun"
  },
  {
    "start": 40.319770499999976,
    "end": 41.07476949999998,
    "words": 3,
    "text": "on a truck."
  },
  {
    "start": 41.206520499999975,
    "end": 42.54972849999997,
    "words": 5,
    "text": "Now they can chase them!"
  },
  {
    "start": 42.73316649999997,
    "end": 43.68904149999997,
    "words": 4,
    "text": "Except the ride is"
  },
  {
    "start": 43.68904149999997,
    "end": 44.86554149999997,
    "words": 4,
    "text": "so rough, the gunner"
  },
  {
    "start": 44.86554149999997,
    "end": 46.147499499999974,
    "words": 3,
    "text": "cannot shoot properly."
  },
  {
    "start": 46.30224949999997,
    "end": 47.792540499999966,
    "words": 5,
    "text": "The birds get away again."
  },
  {
    "start": 47.97497849999996,
    "end": 49.403978499999965,
    "words": 3,
    "text": "They ordered mobility."
  },
  {
    "start": 49.51843649999996,
    "end": 51.008728499999954,
    "words": 5,
    "text": "They got an ass massage."
  },
  {
    "start": 51.20816549999995,
    "end": 52.63720749999995,
    "words": 4,
    "text": "The troops are recalled."
  },
  {
    "start": 52.73316549999994,
    "end": 53.904831499999936,
    "words": 3,
    "text": "Then sent back."
  },
  {
    "start": 54.03560349999994,
    "end": 55.44010349999994,
    "words": 3,
    "text": "The problem remains."
  },
  {
    "start": 55.66008333333326,
    "end": 56.93508333333327,
    "words": 4,
    "text": "Birds did die, so"
  },
  {
    "start": 56.93508333333327,
    "end": 58.665083333333264,
    "words": 5,
    "text": "this was no bloodless victory."
  },
  {
    "start": 58.79560433333326,
    "end": 60.27060433333325,
    "words": 4,
    "text": "But the military operation"
  },
  {
    "start": 60.27060433333325,
    "end": 61.508104333333264,
    "words": 4,
    "text": "ended, and the farmers"
  },
  {
    "start": 61.508104333333264,
    "end": 62.63810433333327,
    "words": 3,
    "text": "still had emus."
  },
  {
    "start": 62.78137533333326,
    "end": 64.14387533333326,
    "words": 4,
    "text": "History remembers it as"
  },
  {
    "start": 64.14387533333326,
    "end": 65.16137533333325,
    "words": 3,
    "text": "the Emu War."
  },
  {
    "start": 65.31187533333325,
    "end": 66.22437533333324,
    "words": 4,
    "text": "At what point should"
  },
  {
    "start": 66.22437533333324,
    "end": 67.26187533333324,
    "words": 4,
    "text": "someone have admitted that"
  },
  {
    "start": 67.26187533333324,
    "end": 68.94187533333324,
    "words": 5,
    "text": "the plan was complete bullshit?"
  }
]
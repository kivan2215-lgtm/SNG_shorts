[
  {
    "start": 0.05,
    "end": 1.508333,
    "words": 3,
    "text": "Австралия отправила солдат"
  },
  {
    "start": 1.508333,
    "end": 2.949583,
    "words": 4,
    "text": "с пулемётами против эму"
  },
  {
    "start": 3.076958,
    "end": 4.768125,
    "words": 4,
    "text": "здоровенных птиц, у которых"
  },
  {
    "start": 4.768125,
    "end": 6.422541,
    "words": 4,
    "text": "весь военный бюджет помещается"
  },
  {
    "start": 6.422541,
    "end": 7.361332,
    "words": 3,
    "text": "в двух ногах."
  },
  {
    "start": 7.4858959999999986,
    "end": 9.049687,
    "words": 4,
    "text": "И этот план, блядь,"
  },
  {
    "start": 9.115770999999999,
    "end": 10.716353999999999,
    "words": 4,
    "text": "умудрился пойти по пизде."
  },
  {
    "start": 10.8763335,
    "end": 12.175333499999999,
    "words": 4,
    "text": "В тысяча девятьсот тридцать"
  },
  {
    "start": 12.175333499999999,
    "end": 14.4499585,
    "words": 5,
    "text": "втором году эму топтали пшеницу."
  },
  {
    "start": 14.560562499999998,
    "end": 16.136603499999996,
    "words": 3,
    "text": "Фермеры попросили помощи,"
  },
  {
    "start": 16.2639785,
    "end": 17.121812499999997,
    "words": 4,
    "text": "и к ним прислали"
  },
  {
    "start": 17.121812499999997,
    "end": 18.261520499999996,
    "words": 4,
    "text": "троих военных с двумя"
  },
  {
    "start": 18.261520499999996,
    "end": 20.8302285,
    "words": 5,
    "text": "пулемётами и десятью тысячами патронов."
  },
  {
    "start": 20.959999500000002,
    "end": 22.259041500000002,
    "words": 4,
    "text": "У птиц оставались только"
  },
  {
    "start": 22.259041500000002,
    "end": 23.9944155,
    "words": 3,
    "text": "ноги, зато, сука,"
  },
  {
    "start": 24.1094995,
    "end": 25.9797495,
    "words": 4,
    "text": "без согласования с начальством."
  },
  {
    "start": 26.139729333333335,
    "end": 27.794145333333333,
    "words": 4,
    "text": "Но эму разбегались маленькими"
  },
  {
    "start": 27.794145333333333,
    "end": 29.485312333333333,
    "words": 4,
    "text": "группами, и солдатам пришлось"
  },
  {
    "start": 29.485312333333333,
    "end": 30.857854333333336,
    "words": 3,
    "text": "выяснить, что мишень,"
  },
  {
    "start": 30.857854333333336,
    "end": 32.78931233333334,
    "words": 3,
    "text": "оказывается, может съебаться."
  },
  {
    "start": 32.89491633333334,
    "end": 34.13266633333334,
    "words": 3,
    "text": "Тогда устроили засаду"
  },
  {
    "start": 34.13266633333334,
    "end": 35.66454133333335,
    "words": 4,
    "text": "у воды: подходит огромная"
  },
  {
    "start": 35.66454133333335,
    "end": 37.00774933333335,
    "words": 3,
    "text": "стая, всё готово,"
  },
  {
    "start": 37.08608333333334,
    "end": 38.83370733333335,
    "words": 4,
    "text": "и тут пулемёт заклинивает."
  },
  {
    "start": 38.94508333333335,
    "end": 40.869124333333346,
    "words": 4,
    "text": "Птицы сваливают, а человеческий"
  },
  {
    "start": 40.869124333333346,
    "end": 42.849582333333345,
    "words": 4,
    "text": "интеллект зависает, как принтер,"
  },
  {
    "start": 42.94020833333335,
    "end": 45.59470833333335,
    "words": 5,
    "text": "которому срочно понадобился голубой картридж."
  },
  {
    "start": 45.75470833333335,
    "end": 47.39687433333335,
    "words": 4,
    "text": "Пулемёт поставили на грузовик,"
  },
  {
    "start": 47.39687433333335,
    "end": 48.69587433333335,
    "words": 4,
    "text": "чтобы догнать эту пернатую"
  },
  {
    "start": 48.69587433333335,
    "end": 49.94587433333335,
    "words": 4,
    "text": "херню, но на ухабах"
  },
  {
    "start": 49.94587433333335,
    "end": 51.27683233333335,
    "words": 3,
    "text": "стрелка так колбасило,"
  },
  {
    "start": 51.39195833333335,
    "end": 52.58070833333335,
    "words": 3,
    "text": "что нормально стрелять"
  },
  {
    "start": 52.58070833333335,
    "end": 53.33570733333335,
    "words": 3,
    "text": "он не мог."
  },
  {
    "start": 53.455083333333356,
    "end": 54.58999933333335,
    "words": 3,
    "text": "Эму опять ушли,"
  },
  {
    "start": 54.68058333333335,
    "end": 55.857041333333356,
    "words": 4,
    "text": "а вместо боевой машины"
  },
  {
    "start": 55.857041333333356,
    "end": 58.511583333333355,
    "words": 5,
    "text": "получился, блядь, вибратор на колёсах."
  },
  {
    "start": 58.633437333333355,
    "end": 60.90806133333336,
    "words": 4,
    "text": "Военных отозвали, потом вернули,"
  },
  {
    "start": 61.084437333333355,
    "end": 62.81985333333336,
    "words": 5,
    "text": "но проблему это не решило."
  },
  {
    "start": 62.97983316666668,
    "end": 64.98962416666669,
    "words": 4,
    "text": "Птицы погибали, поэтому сказки"
  },
  {
    "start": 64.98962416666669,
    "end": 66.42345816666668,
    "words": 4,
    "text": "о бескровной победе оставим"
  },
  {
    "start": 66.42345816666668,
    "end": 68.60004116666667,
    "words": 3,
    "text": "интернету: операция закончилась,"
  },
  {
    "start": 68.60483316666668,
    "end": 70.34024916666668,
    "words": 5,
    "text": "а фермеры остались с эму."
  },
  {
    "start": 70.38204116666668,
    "end": 71.88941616666668,
    "words": 4,
    "text": "Вот такая война, где"
  },
  {
    "start": 71.88941616666668,
    "end": 72.96783216666667,
    "words": 4,
    "text": "у людей были оружие"
  },
  {
    "start": 72.96783216666667,
    "end": 73.67379016666668,
    "words": 2,
    "text": "и звания,"
  },
  {
    "start": 73.72762416666667,
    "end": 75.27174916666668,
    "words": 4,
    "text": "а у противника перья"
  },
  {
    "start": 75.27174916666668,
    "end": 76.75458216666668,
    "words": 4,
    "text": "и полное отсутствие интереса"
  },
  {
    "start": 76.75458216666668,
    "end": 77.63216516666667,
    "words": 3,
    "text": "к этой хуйне."
  },
  {
    "start": 77.74399916666667,
    "end": 78.76116616666667,
    "words": 4,
    "text": "Когда уже надо было"
  },
  {
    "start": 78.76116616666667,
    "end": 80.91324916666666,
    "words": 4,
    "text": "признать, что план говно?"
  }
]
[
  {
    "start": 0.05,
    "end": 1.508333,
    "words": 3,
    "text": "Австралия отправила солдат"
  },
  {
    "start": 1.508333,
    "end": 2.949583,
    "words": 4,
    "text": "с пулемётами против эму"
  },
  {
    "start": 3.076958,
    "end": 4.768125,
    "words": 4,
    "text": "здоровенных птиц, у которых"
  },
  {
    "start": 4.768125,
    "end": 6.422541,
    "words": 4,
    "text": "весь военный бюджет помещается"
  },
  {
    "start": 6.422541,
    "end": 7.301021000000001,
    "words": 3,
    "text": "в двух ногах."
  },
  {
    "start": 7.301021000000001,
    "end": 8.833124999999999,
    "words": 4,
    "text": "И этот охуенно надёжный"
  },
  {
    "start": 8.833124999999999,
    "end": 10.086355000000001,
    "words": 4,
    "text": "план пошёл по пизде."
  },
  {
    "start": 10.086355000000001,
    "end": 11.197375000000003,
    "words": 4,
    "text": "Кто бы мог подумать,"
  },
  {
    "start": 11.251166999999999,
    "end": 12.464417000000001,
    "words": 4,
    "text": "что птицы не станут"
  },
  {
    "start": 12.464417000000001,
    "end": 14.064168000000002,
    "words": 5,
    "text": "стоять в очереди под пулемёт?"
  },
  {
    "start": 14.064168000000002,
    "end": 15.3275635,
    "words": 4,
    "text": "В тысяча девятьсот тридцать"
  },
  {
    "start": 15.3275635,
    "end": 17.518230000000003,
    "words": 5,
    "text": "втором году эму топтали пшеницу."
  },
  {
    "start": 17.518230000000003,
    "end": 19.065250499999998,
    "words": 3,
    "text": "Фермеры попросили помощи,"
  },
  {
    "start": 19.1295635,
    "end": 19.987397499999997,
    "words": 4,
    "text": "и к ним прислали"
  },
  {
    "start": 19.987397499999997,
    "end": 21.127105499999995,
    "words": 4,
    "text": "троих военных с двумя"
  },
  {
    "start": 21.127105499999995,
    "end": 23.632855,
    "words": 5,
    "text": "пулемётами и десятью тысячами патронов."
  },
  {
    "start": 23.632855,
    "end": 24.866396499999997,
    "words": 4,
    "text": "У птиц оставались только"
  },
  {
    "start": 24.866396499999997,
    "end": 26.165438499999997,
    "words": 4,
    "text": "ноги, зато им нахуй"
  },
  {
    "start": 26.165438499999997,
    "end": 28.035604499999994,
    "words": 4,
    "text": "не требовалось разрешение начальства,"
  },
  {
    "start": 28.1262305,
    "end": 29.41233499999999,
    "words": 3,
    "text": "чтобы ими пользоваться."
  },
  {
    "start": 29.41233499999999,
    "end": 31.01314699999999,
    "words": 4,
    "text": "Но эму разбегались маленькими"
  },
  {
    "start": 31.01314699999999,
    "end": 32.588813999999985,
    "words": 4,
    "text": "группами, и солдатам пришлось"
  },
  {
    "start": 32.588813999999985,
    "end": 34.91908499999999,
    "words": 5,
    "text": "выяснить, что мишень умеет съебаться."
  },
  {
    "start": 34.91908499999999,
    "end": 36.00310599999998,
    "words": 2,
    "text": "Охуенное открытие"
  },
  {
    "start": 36.00310599999998,
    "end": 37.196668999999986,
    "words": 4,
    "text": "для людей с оружием!"
  },
  {
    "start": 37.196668999999986,
    "end": 38.411439999999985,
    "words": 3,
    "text": "Тогда устроили засаду"
  },
  {
    "start": 38.411439999999985,
    "end": 39.943314999999984,
    "words": 4,
    "text": "у воды: подходит огромная"
  },
  {
    "start": 39.943314999999984,
    "end": 41.298771999999985,
    "words": 3,
    "text": "стая, всё готово,"
  },
  {
    "start": 41.31462699999998,
    "end": 42.963835999999986,
    "words": 4,
    "text": "и тут пулемёт заклинивает."
  },
  {
    "start": 42.963835999999986,
    "end": 44.86487699999998,
    "words": 4,
    "text": "Птицы сваливают, а человеческий"
  },
  {
    "start": 44.86487699999998,
    "end": 46.62791799999998,
    "words": 4,
    "text": "интеллект зависает, как принтер"
  },
  {
    "start": 46.62791799999998,
    "end": 47.960605999999984,
    "words": 3,
    "text": "без голубого картриджа."
  },
  {
    "start": 47.960605999999984,
    "end": 49.689833999999976,
    "words": 4,
    "text": "Два пулемёта против птиц,"
  },
  {
    "start": 49.770855999999974,
    "end": 51.082105999999975,
    "words": 3,
    "text": "а техническая поддержка"
  },
  {
    "start": 51.082105999999975,
    "end": 52.60746099999997,
    "words": 3,
    "text": "опять нахуй недоступна."
  },
  {
    "start": 52.60746099999997,
    "end": 54.208105833333306,
    "words": 4,
    "text": "И представляете, что эти"
  },
  {
    "start": 54.208105833333306,
    "end": 56.101189999999974,
    "words": 4,
    "text": "ёбаные гении придумали дальше?"
  },
  {
    "start": 56.101189999999974,
    "end": 57.698043833333315,
    "words": 4,
    "text": "Пулемёт поставили на грузовик,"
  },
  {
    "start": 57.698043833333315,
    "end": 59.00929383333332,
    "words": 4,
    "text": "чтобы догнать эту пернатую"
  },
  {
    "start": 59.00929383333332,
    "end": 60.33318983333331,
    "words": 4,
    "text": "пиздобратию, но на ухабах"
  },
  {
    "start": 60.33318983333331,
    "end": 61.68864783333331,
    "words": 3,
    "text": "стрелка так колбасило,"
  },
  {
    "start": 61.80377283333331,
    "end": 62.9924808333333,
    "words": 3,
    "text": "что нормально стрелять"
  },
  {
    "start": 62.9924808333333,
    "end": 63.59448099999996,
    "words": 3,
    "text": "он не мог."
  },
  {
    "start": 63.59448099999996,
    "end": 64.65460583333329,
    "words": 3,
    "text": "Ну охуеть теперь,"
  },
  {
    "start": 64.79423083333329,
    "end": 65.98400199999996,
    "words": 3,
    "text": "на кочках трясёт!"
  },
  {
    "start": 65.98400199999996,
    "end": 67.11648083333328,
    "words": 3,
    "text": "Эму опять ушли,"
  },
  {
    "start": 67.11871083333328,
    "end": 68.34421083333329,
    "words": 4,
    "text": "а вместо боевой машины"
  },
  {
    "start": 68.34421083333329,
    "end": 69.72900183333329,
    "words": 3,
    "text": "получился ёбаный вибратор"
  },
  {
    "start": 69.72900183333329,
    "end": 71.97068999999995,
    "words": 5,
    "text": "на колёсах с государственным финансированием."
  },
  {
    "start": 71.97068999999995,
    "end": 74.11535583333328,
    "words": 4,
    "text": "Военных отозвали, потом вернули,"
  },
  {
    "start": 74.26723183333328,
    "end": 75.14960683333328,
    "words": 4,
    "text": "но проблему это не"
  },
  {
    "start": 75.14960683333328,
    "end": 76.96331483333329,
    "words": 4,
    "text": "решило: если обосрались один"
  },
  {
    "start": 76.96331483333329,
    "end": 79.04237799999994,
    "words": 5,
    "text": "раз, надо же закрепить результат."
  },
  {
    "start": 79.04237799999994,
    "end": 81.02685683333328,
    "words": 4,
    "text": "Птицы погибали, поэтому сказки"
  },
  {
    "start": 81.02685683333328,
    "end": 82.44844083333328,
    "words": 4,
    "text": "о бескровной победе оставим"
  },
  {
    "start": 82.44844083333328,
    "end": 84.48950283333328,
    "words": 3,
    "text": "интернету: операция закончилась,"
  },
  {
    "start": 84.49433683333328,
    "end": 86.08746199999995,
    "words": 5,
    "text": "а фермеры остались с эму."
  },
  {
    "start": 86.08746199999995,
    "end": 87.55279483333328,
    "words": 4,
    "text": "Вот такая война, где"
  },
  {
    "start": 87.55279483333328,
    "end": 88.63125283333328,
    "words": 4,
    "text": "у людей были оружие"
  },
  {
    "start": 88.63125283333328,
    "end": 89.33721083333327,
    "words": 2,
    "text": "и звания,"
  },
  {
    "start": 89.39104483333328,
    "end": 90.88183683333328,
    "words": 4,
    "text": "а у противника перья"
  },
  {
    "start": 90.88183683333328,
    "end": 92.37691983333329,
    "words": 4,
    "text": "и полное отсутствие интереса"
  },
  {
    "start": 92.37691983333329,
    "end": 93.08592099999994,
    "words": 3,
    "text": "к этой хуйне."
  },
  {
    "start": 93.08592099999994,
    "end": 93.97402483333327,
    "words": 4,
    "text": "Когда уже надо было"
  },
  {
    "start": 93.97402483333327,
    "end": 95.87406599999993,
    "words": 4,
    "text": "признать, что план говно,"
  },
  {
    "start": 95.87406599999993,
    "end": 96.58052383333326,
    "words": 3,
    "text": "а не добавлять"
  },
  {
    "start": 96.58052383333326,
    "end": 97.87473283333325,
    "words": 3,
    "text": "этому говну колёса?"
  }
]
[
  {
    "start": 0.05,
    "end": 1.520583,
    "words": 3,
    "text": "Австралия отправила солдат"
  },
  {
    "start": 1.520583,
    "end": 2.961833,
    "words": 4,
    "text": "с пулемётами против эму"
  },
  {
    "start": 3.089208,
    "end": 4.727396000000001,
    "words": 4,
    "text": "здоровенных птиц, у которых"
  },
  {
    "start": 4.727396000000001,
    "end": 6.381812,
    "words": 4,
    "text": "весь военный бюджет помещается"
  },
  {
    "start": 6.381812,
    "end": 7.248417000000001,
    "words": 3,
    "text": "в двух ногах."
  },
  {
    "start": 7.248417000000001,
    "end": 8.747603999999999,
    "words": 4,
    "text": "И этот охуенно надёжный"
  },
  {
    "start": 8.747603999999999,
    "end": 9.936354000000001,
    "words": 3,
    "text": "план умудрился пойти"
  },
  {
    "start": 9.936354000000001,
    "end": 10.671645999999999,
    "words": 4,
    "text": "по пизде ещё до"
  },
  {
    "start": 10.671645999999999,
    "end": 12.39477,
    "words": 4,
    "text": "того, как птицы поняли,"
  },
  {
    "start": 12.399562,
    "end": 13.497125,
    "words": 4,
    "text": "что с ними воюют."
  },
  {
    "start": 13.497125,
    "end": 14.760520499999998,
    "words": 4,
    "text": "В тысяча девятьсот тридцать"
  },
  {
    "start": 14.760520499999998,
    "end": 16.951187,
    "words": 5,
    "text": "втором году эму топтали пшеницу."
  },
  {
    "start": 16.951187,
    "end": 18.498207499999996,
    "words": 3,
    "text": "Фермеры попросили помощи,"
  },
  {
    "start": 18.5607075,
    "end": 19.418541499999996,
    "words": 4,
    "text": "и к ним прислали"
  },
  {
    "start": 19.418541499999996,
    "end": 20.558249499999995,
    "words": 4,
    "text": "троих военных с двумя"
  },
  {
    "start": 20.558249499999995,
    "end": 23.063999999999997,
    "words": 5,
    "text": "пулемётами и десятью тысячами патронов."
  },
  {
    "start": 23.063999999999997,
    "end": 24.297540499999997,
    "words": 4,
    "text": "У птиц оставались только"
  },
  {
    "start": 24.297540499999997,
    "end": 25.596582499999997,
    "words": 4,
    "text": "ноги, зато им нахуй"
  },
  {
    "start": 25.596582499999997,
    "end": 27.466748499999994,
    "words": 4,
    "text": "не требовалось разрешение начальства,"
  },
  {
    "start": 27.557374499999998,
    "end": 28.843498999999994,
    "words": 3,
    "text": "чтобы ими пользоваться."
  },
  {
    "start": 28.843498999999994,
    "end": 30.455935999999994,
    "words": 4,
    "text": "Но эму разбегались маленькими"
  },
  {
    "start": 30.455935999999994,
    "end": 32.023289999999996,
    "words": 4,
    "text": "группами, и солдатам пришлось"
  },
  {
    "start": 32.023289999999996,
    "end": 33.51837299999999,
    "words": 4,
    "text": "выяснить, что мишень умеет"
  },
  {
    "start": 33.51837299999999,
    "end": 35.911685999999996,
    "words": 4,
    "text": "съебаться без предварительного уведомления."
  },
  {
    "start": 35.911685999999996,
    "end": 37.12460299999999,
    "words": 3,
    "text": "Тогда устроили засаду"
  },
  {
    "start": 37.12460299999999,
    "end": 38.66872799999999,
    "words": 4,
    "text": "у воды: подходит огромная"
  },
  {
    "start": 38.66872799999999,
    "end": 40.024184999999996,
    "words": 3,
    "text": "стая, всё готово,"
  },
  {
    "start": 40.03547799999998,
    "end": 41.688915999999985,
    "words": 4,
    "text": "и тут пулемёт заклинивает."
  },
  {
    "start": 41.688915999999985,
    "end": 43.50243599999998,
    "words": 4,
    "text": "Птицы сваливают, а человеческий"
  },
  {
    "start": 43.50243599999998,
    "end": 45.24264499999998,
    "words": 4,
    "text": "интеллект зависает, как принтер"
  },
  {
    "start": 45.24264499999998,
    "end": 46.88481099999998,
    "words": 4,
    "text": "без голубого картриджа: чёрная"
  },
  {
    "start": 46.88481099999998,
    "end": 48.11026999999998,
    "words": 4,
    "text": "краска есть, но эта"
  },
  {
    "start": 48.11026999999998,
    "end": 49.06618599999998,
    "words": 3,
    "text": "сраная херня всё"
  },
  {
    "start": 49.06618599999998,
    "end": 50.07128999999998,
    "words": 3,
    "text": "равно не работает."
  },
  {
    "start": 50.07128999999998,
    "end": 51.66616483333331,
    "words": 4,
    "text": "Пулемёт поставили на грузовик,"
  },
  {
    "start": 51.66616483333331,
    "end": 52.97741483333331,
    "words": 4,
    "text": "чтобы догнать эту пернатую"
  },
  {
    "start": 52.97741483333331,
    "end": 54.309977833333306,
    "words": 4,
    "text": "пиздобратию, но на ухабах"
  },
  {
    "start": 54.309977833333306,
    "end": 55.67768583333331,
    "words": 3,
    "text": "стрелка так колбасило,"
  },
  {
    "start": 55.7928118333333,
    "end": 56.9815198333333,
    "words": 3,
    "text": "что нормально стрелять"
  },
  {
    "start": 56.9815198333333,
    "end": 57.66043599999997,
    "words": 3,
    "text": "он не мог."
  },
  {
    "start": 57.66043599999997,
    "end": 58.7906228333333,
    "words": 3,
    "text": "Эму опять ушли,"
  },
  {
    "start": 58.79603983333329,
    "end": 60.0215398333333,
    "words": 4,
    "text": "а вместо боевой машины"
  },
  {
    "start": 60.0215398333333,
    "end": 61.40633183333329,
    "words": 3,
    "text": "получился ёбаный вибратор"
  },
  {
    "start": 61.40633183333329,
    "end": 63.65368599999996,
    "words": 5,
    "text": "на колёсах с государственным финансированием."
  },
  {
    "start": 63.65368599999996,
    "end": 65.79120583333328,
    "words": 4,
    "text": "Военных отозвали, потом вернули,"
  },
  {
    "start": 65.95533083333328,
    "end": 66.86220583333328,
    "words": 4,
    "text": "но проблему это не"
  },
  {
    "start": 66.86220583333328,
    "end": 68.25924783333328,
    "words": 3,
    "text": "решило: второе свидание"
  },
  {
    "start": 68.25924783333328,
    "end": 70.18628999999994,
    "words": 5,
    "text": "с провалом тоже оказалось говном."
  },
  {
    "start": 70.18628999999994,
    "end": 72.09576799999995,
    "words": 4,
    "text": "Птицы погибали, поэтому сказки"
  },
  {
    "start": 72.09576799999995,
    "end": 73.51735199999995,
    "words": 4,
    "text": "о бескровной победе оставим"
  },
  {
    "start": 73.51735199999995,
    "end": 75.55841399999994,
    "words": 3,
    "text": "интернету: операция закончилась,"
  },
  {
    "start": 75.56324799999994,
    "end": 77.15637299999995,
    "words": 5,
    "text": "а фермеры остались с эму."
  },
  {
    "start": 77.15637299999995,
    "end": 78.62170599999996,
    "words": 4,
    "text": "Вот такая война, где"
  },
  {
    "start": 78.62170599999996,
    "end": 79.70016399999994,
    "words": 4,
    "text": "у людей были оружие"
  },
  {
    "start": 79.70016399999994,
    "end": 80.40612199999995,
    "words": 2,
    "text": "и звания,"
  },
  {
    "start": 80.45995599999995,
    "end": 81.95074799999995,
    "words": 4,
    "text": "а у противника перья"
  },
  {
    "start": 81.95074799999995,
    "end": 83.44583099999997,
    "words": 4,
    "text": "и полное отсутствие интереса"
  },
  {
    "start": 83.44583099999997,
    "end": 84.15483199999994,
    "words": 3,
    "text": "к этой хуйне."
  },
  {
    "start": 84.15483199999994,
    "end": 85.04293599999994,
    "words": 4,
    "text": "Когда уже надо было"
  },
  {
    "start": 85.04293599999994,
    "end": 86.94297699999993,
    "words": 4,
    "text": "признать, что план говно,"
  },
  {
    "start": 86.94297699999993,
    "end": 87.64943499999993,
    "words": 3,
    "text": "а не добавлять"
  },
  {
    "start": 87.64943499999993,
    "end": 88.94364399999992,
    "words": 3,
    "text": "этому говну колёса?"
  }
]
[
  {
    "start": 0.05,
    "end": 1.25,
    "words": 4,
    "text": "In court, a woman"
  },
  {
    "start": 1.25,
    "end": 2.6875,
    "words": 4,
    "text": "raised her metal prosthesis"
  },
  {
    "start": 2.6875,
    "end": 4.2675,
    "words": 5,
    "text": "and pointed at the defendant."
  },
  {
    "start": 4.418396,
    "end": 5.118396000000001,
    "words": 4,
    "text": "But he was on"
  },
  {
    "start": 5.118396000000001,
    "end": 7.023396,
    "words": 5,
    "text": "trial for killing another woman."
  },
  {
    "start": 7.190583000000001,
    "end": 7.803083,
    "words": 3,
    "text": "Why was her"
  },
  {
    "start": 7.803083,
    "end": 9.520583,
    "words": 3,
    "text": "testimony so important?"
  },
  {
    "start": 9.740083000000002,
    "end": 12.011166000000001,
    "words": 3,
    "text": "California, nineteen seventy-eight."
  },
  {
    "start": 12.122561000000001,
    "end": 14.703061000000003,
    "words": 5,
    "text": "Fifteen-year-old Mary Vincent was hitchhiking."
  },
  {
    "start": 14.888874000000005,
    "end": 16.949581000000002,
    "words": 5,
    "text": "Lawrence Singleton stopped his van."
  },
  {
    "start": 17.12260300000001,
    "end": 17.889937000000007,
    "words": 4,
    "text": "He drove her to"
  },
  {
    "start": 17.889937000000007,
    "end": 19.672103000000007,
    "words": 4,
    "text": "an isolated place, sexually"
  },
  {
    "start": 19.672103000000007,
    "end": 21.095395000000007,
    "words": 4,
    "text": "assaulted her, then severed"
  },
  {
    "start": 21.095395000000007,
    "end": 21.776062000000007,
    "words": 3,
    "text": "both her arms"
  },
  {
    "start": 21.776062000000007,
    "end": 22.896144000000007,
    "words": 3,
    "text": "below the elbows."
  },
  {
    "start": 23.00979100000001,
    "end": 24.03699900000001,
    "words": 4,
    "text": "He threw Mary into"
  },
  {
    "start": 24.03699900000001,
    "end": 24.95283300000001,
    "words": 4,
    "text": "a ravine and left"
  },
  {
    "start": 24.95283300000001,
    "end": 25.714040000000008,
    "words": 3,
    "text": "her to die."
  },
  {
    "start": 25.894437000000014,
    "end": 27.280562000000014,
    "words": 4,
    "text": "But she survived, reached"
  },
  {
    "start": 27.280562000000014,
    "end": 28.394437000000014,
    "words": 4,
    "text": "the road, and found"
  },
  {
    "start": 28.394437000000014,
    "end": 29.514562000000012,
    "words": 4,
    "text": "people who helped her."
  },
  {
    "start": 29.734041833333347,
    "end": 30.922166833333346,
    "words": 4,
    "text": "Singleton was caught and"
  },
  {
    "start": 30.922166833333346,
    "end": 31.986541833333344,
    "words": 3,
    "text": "sentenced to fourteen"
  },
  {
    "start": 31.986541833333344,
    "end": 32.98287383333334,
    "words": 3,
    "text": "years in prison."
  },
  {
    "start": 33.16016583333334,
    "end": 34.57724883333334,
    "words": 4,
    "text": "But in nineteen eighty-seven,"
  },
  {
    "start": 34.65766583333334,
    "end": 35.47449983333334,
    "words": 4,
    "text": "he was released on"
  },
  {
    "start": 35.47449983333334,
    "end": 36.52649983333334,
    "words": 3,
    "text": "parole after serving"
  },
  {
    "start": 36.52649983333334,
    "end": 37.55995683333334,
    "words": 3,
    "text": "about eight years."
  },
  {
    "start": 37.67474883333333,
    "end": 38.838123833333334,
    "words": 4,
    "text": "For Mary, the fear"
  },
  {
    "start": 38.838123833333334,
    "end": 39.48166583333333,
    "words": 3,
    "text": "did not end"
  },
  {
    "start": 39.48166583333333,
    "end": 40.34187383333333,
    "words": 3,
    "text": "with the trial."
  },
  {
    "start": 40.56339456666666,
    "end": 41.64585366666666,
    "words": 4,
    "text": "Ten years later, in"
  },
  {
    "start": 41.64585366666666,
    "end": 44.08143666666666,
    "words": 4,
    "text": "Florida, Singleton murdered thirty-one-year-old"
  },
  {
    "start": 44.08143666666666,
    "end": 45.21547866666666,
    "words": 3,
    "text": "Roxanne Hayes, a"
  },
  {
    "start": 45.21547866666666,
    "end": 46.23464466666666,
    "words": 3,
    "text": "mother of three."
  },
  {
    "start": 46.38331166666666,
    "end": 47.33689466666666,
    "words": 4,
    "text": "A witness saw the"
  },
  {
    "start": 47.33689466666666,
    "end": 48.858644666666656,
    "words": 5,
    "text": "attack and went for help."
  },
  {
    "start": 48.97666566666665,
    "end": 50.38133166666665,
    "words": 4,
    "text": "The following year, Mary"
  },
  {
    "start": 50.38133166666665,
    "end": 52.186581666666655,
    "words": 5,
    "text": "faced Singleton in court again."
  },
  {
    "start": 52.36847866666665,
    "end": 53.37360366666665,
    "words": 4,
    "text": "This is the moment"
  },
  {
    "start": 53.37360366666665,
    "end": 54.66343666666665,
    "words": 3,
    "text": "in the photograph."
  },
  {
    "start": 54.67247866666664,
    "end": 55.651853666666646,
    "words": 4,
    "text": "She pointed at him"
  },
  {
    "start": 55.651853666666646,
    "end": 56.83743666666664,
    "words": 4,
    "text": "with her prosthesis and"
  },
  {
    "start": 56.83743666666664,
    "end": 57.816811666666645,
    "words": 4,
    "text": "described what he had"
  },
  {
    "start": 57.816811666666645,
    "end": 58.33226966666664,
    "words": 3,
    "text": "done to her"
  },
  {
    "start": 58.33226966666664,
    "end": 59.58339466666665,
    "words": 3,
    "text": "twenty years earlier."
  },
  {
    "start": 59.80437449999997,
    "end": 61.29674949999997,
    "words": 4,
    "text": "Her testimony came during"
  },
  {
    "start": 61.29674949999997,
    "end": 62.52366549999998,
    "words": 3,
    "text": "the penalty phase."
  },
  {
    "start": 62.639353499999984,
    "end": 64.24647849999998,
    "words": 4,
    "text": "This time, Singleton was"
  },
  {
    "start": 64.24647849999998,
    "end": 65.35864449999997,
    "words": 3,
    "text": "sentenced to death."
  },
  {
    "start": 65.47429149999998,
    "end": 66.72429149999998,
    "words": 4,
    "text": "But Roxanne could not"
  },
  {
    "start": 66.72429149999998,
    "end": 67.70887449999996,
    "words": 3,
    "text": "be brought back."
  },
  {
    "start": 67.82791649999997,
    "end": 69.20549949999997,
    "words": 4,
    "text": "Even the full fourteen-year"
  },
  {
    "start": 69.20549949999997,
    "end": 70.31516649999996,
    "words": 4,
    "text": "sentence would have ended"
  },
  {
    "start": 70.31516649999996,
    "end": 71.46558249999997,
    "words": 3,
    "text": "before her murder."
  },
  {
    "start": 71.61247849999997,
    "end": 72.25022849999996,
    "words": 4,
    "text": "So how do we"
  },
  {
    "start": 72.25022849999996,
    "end": 73.60227049999996,
    "words": 4,
    "text": "determine whether someone who"
  },
  {
    "start": 73.60227049999996,
    "end": 74.69918749999997,
    "words": 4,
    "text": "committed such a crime"
  },
  {
    "start": 74.69918749999997,
    "end": 75.92614549999995,
    "words": 4,
    "text": "is safe to release?"
  }
]
[
  {
    "start": 0.05,
    "end": 1.45,
    "words": 4,
    "text": "В суде женщина подняла"
  },
  {
    "start": 1.45,
    "end": 2.7375,
    "words": 3,
    "text": "металлический протез и"
  },
  {
    "start": 2.7375,
    "end": 4.2425,
    "words": 3,
    "text": "указала на подсудимого."
  },
  {
    "start": 4.2498960000000015,
    "end": 5.262396000000001,
    "words": 4,
    "text": "Но его судили за"
  },
  {
    "start": 5.262396000000001,
    "end": 6.792396000000001,
    "words": 3,
    "text": "убийство другой женщины."
  },
  {
    "start": 6.856917,
    "end": 8.206917,
    "words": 3,
    "text": "Почему её свидетельство"
  },
  {
    "start": 8.206917,
    "end": 9.361917,
    "words": 3,
    "text": "было так важно?"
  },
  {
    "start": 9.581917,
    "end": 11.463125000000002,
    "words": 3,
    "text": "Калифорния, тысяча девятьсот"
  },
  {
    "start": 11.463125000000002,
    "end": 12.867874000000002,
    "words": 3,
    "text": "семьдесят восьмой год."
  },
  {
    "start": 12.884062,
    "end": 15.835811999999999,
    "words": 5,
    "text": "Пятнадцатилетняя Мэри Винсент ловила попутку."
  },
  {
    "start": 15.899708,
    "end": 17.644750000000002,
    "words": 4,
    "text": "За рулём остановившегося фургона"
  },
  {
    "start": 17.644750000000002,
    "end": 19.235166,
    "words": 3,
    "text": "был Лоуренс Синглтон."
  },
  {
    "start": 19.279229000000004,
    "end": 20.071271000000003,
    "words": 4,
    "text": "Он увёз её в"
  },
  {
    "start": 20.071271000000003,
    "end": 22.169103000000003,
    "words": 4,
    "text": "безлюдное место, подверг насилию,"
  },
  {
    "start": 22.261896000000004,
    "end": 23.388104000000002,
    "words": 4,
    "text": "а затем отрубил обе"
  },
  {
    "start": 23.388104000000002,
    "end": 24.681478000000006,
    "words": 3,
    "text": "руки ниже локтей."
  },
  {
    "start": 24.702270000000002,
    "end": 25.989395000000005,
    "words": 4,
    "text": "Мэри он сбросил в"
  },
  {
    "start": 25.989395000000005,
    "end": 27.777811000000007,
    "words": 3,
    "text": "овраг, оставив умирать."
  },
  {
    "start": 27.830728000000004,
    "end": 29.439645000000002,
    "words": 4,
    "text": "Но она выжила: выбралась"
  },
  {
    "start": 29.439645000000002,
    "end": 30.578270000000007,
    "words": 4,
    "text": "к дороге и дождалась"
  },
  {
    "start": 30.578270000000007,
    "end": 32.60185300000001,
    "words": 4,
    "text": "людей, которые помогли ей."
  },
  {
    "start": 32.82183283333333,
    "end": 34.43695683333334,
    "words": 2,
    "text": "Синглтона поймали."
  },
  {
    "start": 34.46279083333333,
    "end": 37.37749883333332,
    "words": 5,
    "text": "Суд назначил четырнадцать лет заключения."
  },
  {
    "start": 37.37749883333332,
    "end": 38.76362383333332,
    "words": 4,
    "text": "Однако в тысяча девятьсот"
  },
  {
    "start": 38.76362383333332,
    "end": 39.964123833333325,
    "words": 3,
    "text": "восемьдесят седьмом году"
  },
  {
    "start": 39.964123833333325,
    "end": 42.35337283333332,
    "words": 3,
    "text": "его условно-досрочно освободили."
  },
  {
    "start": 42.35337283333332,
    "end": 44.30270583333332,
    "words": 5,
    "text": "Он отбыл около восьми лет."
  },
  {
    "start": 44.31856083333331,
    "end": 45.63043583333331,
    "words": 4,
    "text": "Для Мэри страх не"
  },
  {
    "start": 45.63043583333331,
    "end": 47.332226833333316,
    "words": 4,
    "text": "закончился вместе с судом."
  },
  {
    "start": 47.55220699999997,
    "end": 49.098581999999965,
    "words": 4,
    "text": "Десять лет спустя, во"
  },
  {
    "start": 49.098581999999965,
    "end": 51.70170699999997,
    "words": 4,
    "text": "Флориде, Синглтон убил тридцатиоднолетнюю"
  },
  {
    "start": 51.70170699999997,
    "end": 54.40847699999996,
    "words": 5,
    "text": "Роксану Хейс, мать троих детей."
  },
  {
    "start": 54.40847699999996,
    "end": 56.40589399999996,
    "words": 4,
    "text": "Очевидец увидел нападение и"
  },
  {
    "start": 56.40589399999996,
    "end": 57.553934999999974,
    "words": 3,
    "text": "позвал на помощь."
  },
  {
    "start": 57.63747699999996,
    "end": 59.09364399999997,
    "words": 4,
    "text": "На следующий год Мэри"
  },
  {
    "start": 59.09364399999997,
    "end": 60.17610199999996,
    "words": 3,
    "text": "снова встретилась с"
  },
  {
    "start": 60.17610199999996,
    "end": 61.56901899999996,
    "words": 3,
    "text": "Синглтоном в суде."
  },
  {
    "start": 61.59753999999997,
    "end": 63.11816499999996,
    "words": 4,
    "text": "Именно этот момент вы"
  },
  {
    "start": 63.11816499999996,
    "end": 64.57141499999996,
    "words": 3,
    "text": "видите на фотографии."
  },
  {
    "start": 64.57141499999996,
    "end": 65.73120699999996,
    "words": 4,
    "text": "Она указала на него"
  },
  {
    "start": 65.73120699999996,
    "end": 67.52245699999996,
    "words": 4,
    "text": "протезом и рассказала, что"
  },
  {
    "start": 67.52245699999996,
    "end": 68.32141499999996,
    "words": 4,
    "text": "он сделал с ней"
  },
  {
    "start": 68.32141499999996,
    "end": 69.68853999999995,
    "words": 3,
    "text": "двадцать лет назад."
  },
  {
    "start": 69.90851983333329,
    "end": 71.7452698333333,
    "words": 4,
    "text": "Её показания прозвучали на"
  },
  {
    "start": 71.7452698333333,
    "end": 73.60745683333329,
    "words": 3,
    "text": "этапе назначения наказания."
  },
  {
    "start": 73.60745683333329,
    "end": 75.15083183333329,
    "words": 4,
    "text": "На этот раз Синглтона"
  },
  {
    "start": 75.15083183333329,
    "end": 76.47983183333328,
    "words": 3,
    "text": "приговорили к смерти."
  },
  {
    "start": 76.51849783333329,
    "end": 77.69195683333328,
    "words": 3,
    "text": "Но Роксану уже"
  },
  {
    "start": 77.69195683333328,
    "end": 78.68933083333327,
    "words": 3,
    "text": "было не вернуть."
  },
  {
    "start": 78.73285183333327,
    "end": 80.91397683333328,
    "words": 4,
    "text": "Даже полный четырнадцатилетний срок"
  },
  {
    "start": 80.91397683333328,
    "end": 82.85518483333327,
    "words": 5,
    "text": "закончился бы до её убийства."
  },
  {
    "start": 82.89316383333326,
    "end": 84.56408083333326,
    "words": 4,
    "text": "И вопрос остаётся: как"
  },
  {
    "start": 84.56408083333326,
    "end": 86.32428883333327,
    "words": 4,
    "text": "определить, что человек после"
  },
  {
    "start": 86.32428883333327,
    "end": 88.49512183333326,
    "words": 5,
    "text": "такого преступления больше не опасен?"
  }
]
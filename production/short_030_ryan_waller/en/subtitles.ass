Dialogue: 0,0:00:00.07,0:00:01.24,S,,0,0,0,,{\pos(500,1595)\fs58}POLICE WERE\NQUESTIONING A
Dialogue: 0,0:00:01.24,0:00:02.12,S,,0,0,0,,{\pos(500,1595)\fs58}YOUNG MAN ABOUT
Dialogue: 0,0:00:02.12,0:00:03.49,S,,0,0,0,,{\pos(500,1595)\fs58}HIS GIRLFRIEND'S\NMURDER.
Dialogue: 0,0:00:03.60,0:00:04.77,S,,0,0,0,,{\pos(500,1595)\fs58}HE STRUGGLED\NTO ANSWER
Dialogue: 0,0:00:04.77,0:00:06.02,S,,0,0,0,,{\pos(500,1595)\fs58}AND SEEMED CONFUSED.
Dialogue: 0,0:00:06.18,0:00:06.89,S,,0,0,0,,{\pos(500,1595)\fs58}BUT THEY DID NOT
Dialogue: 0,0:00:06.89,0:00:07.95,S,,0,0,0,,{\pos(500,1595)\fs58}KNOW THE MOST\NIMPORTANT
Dialogue: 0,0:00:07.95,0:00:09.40,S,,0,0,0,,{\pos(500,1595)\fs58}FACT: A BULLET\NFRAGMENT
Dialogue: 0,0:00:09.40,0:00:11.03,S,,0,0,0,,{\pos(500,1595)\fs58}WAS LODGED\NINSIDE HIS BRAIN.
Dialogue: 0,0:00:11.27,0:00:12.22,S,,0,0,0,,{\pos(500,1595)\fs58}ARIZONA.
Dialogue: 0,0:00:12.34,0:00:14.35,S,,0,0,0,,{\pos(500,1595)\fs58}CHRISTMAS, TWO\NTHOUSAND SIX.
Dialogue: 0,0:00:14.50,0:00:16.02,S,,0,0,0,,{\pos(500,1595)\fs58}RYAN WALLER\NNEVER ARRIVED
Dialogue: 0,0:00:16.02,0:00:17.18,S,,0,0,0,,{\pos(500,1595)\fs58}AT HIS PARENTS HOME.
Dialogue: 0,0:00:17.33,0:00:18.91,S,,0,0,0,,{\pos(500,1595)\fs58}HIS MOTHER\NCALLED POLICE.
Dialogue: 0,0:00:19.05,0:00:20.66,S,,0,0,0,,{\pos(500,1595)\fs58}INSIDE HIS\NHOUSE, OFFICERS
Dialogue: 0,0:00:20.66,0:00:21.96,S,,0,0,0,,{\pos(500,1595)\fs58}FOUND HEATHER\NQUAN {\c&H0073CCF0&}DEAD,{\c&H00FFFFFF&}
Dialogue: 0,0:00:21.99,0:00:23.35,S,,0,0,0,,{\pos(500,1595)\fs58}AND RYAN STILL {\c&H0073CCF0&}ALIVE.{\c&H00FFFFFF&}
Dialogue: 0,0:00:23.48,0:00:25.30,S,,0,0,0,,{\pos(500,1595)\fs58}HIS FACE WAS\NBADLY INJURED.
Dialogue: 0,0:00:25.46,0:00:27.15,S,,0,0,0,,{\pos(500,1595)\fs58}INSTEAD OF IMMEDIATE\NTREATMENT,
Dialogue: 0,0:00:27.19,0:00:28.21,S,,0,0,0,,{\pos(500,1595)\fs58}HE WAS QUESTIONED.
Dialogue: 0,0:00:28.45,0:00:29.76,S,,0,0,0,,{\pos(500,1595)\fs58}RYAN TRIED TO EXPLAIN:
Dialogue: 0,0:00:29.84,0:00:31.33,S,,0,0,0,,{\pos(500,1595)\fs58}HIS FORMER\NROOMMATE, RICHIE
Dialogue: 0,0:00:31.33,0:00:32.75,S,,0,0,0,,{\pos(500,1595)\fs58}CARVER, AND\NRICHIE'S FATHER
Dialogue: 0,0:00:32.75,0:00:33.87,S,,0,0,0,,{\pos(500,1595)\fs58}HAD COME TO\NTHE HOUSE.
Dialogue: 0,0:00:33.99,0:00:35.25,S,,0,0,0,,{\pos(500,1595)\fs58}HE HAD BEEN SHOT.
Dialogue: 0,0:00:35.40,0:00:37.40,S,,0,0,0,,{\pos(500,1595)\fs58}SO YOU GOT\NSHOT FIRST?
Dialogue: 0,0:00:37.40,0:00:37.90,S,,0,0,0,,{\pos(500,1595)\fs58}MM-HMM.
Dialogue: 0,0:00:37.90,0:00:38.80,S,,0,0,0,,{\pos(500,1595)\fs58}AND WHAT HAPPENED?
Dialogue: 0,0:00:38.80,0:00:39.50,S,,0,0,0,,{\pos(500,1595)\fs58}DID YOU FALL
Dialogue: 0,0:00:39.50,0:00:40.20,S,,0,0,0,,{\pos(500,1595)\fs58}ON THE GROUND?
Dialogue: 0,0:00:40.20,0:00:41.08,S,,0,0,0,,{\pos(500,1595)\fs58}YEAH, I WAS TRYING
Dialogue: 0,0:00:41.08,0:00:41.74,S,,0,0,0,,{\pos(500,1595)\fs58}TO GET UP
Dialogue: 0,0:00:41.74,0:00:42.39,S,,0,0,0,,{\pos(500,1595)\fs58}AND COULD NOT.
Dialogue: 0,0:00:42.39,0:00:43.53,S,,0,0,0,,{\pos(500,1595)\fs58}BUT OFFICERS DID NOT
Dialogue: 0,0:00:43.53,0:00:45.40,S,,0,0,0,,{\pos(500,1595)\fs58}IMMEDIATELY\NRECOGNIZE THE WOUND.
Dialogue: 0,0:00:45.54,0:00:46.93,S,,0,0,0,,{\pos(500,1595)\fs58}THE COURT\NDECISION DESCRIBES
Dialogue: 0,0:00:46.93,0:00:48.93,S,,0,0,0,,{\pos(500,1595)\fs58}HIM AS DISORIENTED\NAND CONFUSED.
Dialogue: 0,0:00:49.09,0:00:50.23,S,,0,0,0,,{\pos(500,1595)\fs58}ONLY AFTER NOTICING A
Dialogue: 0,0:00:50.23,0:00:51.46,S,,0,0,0,,{\pos(500,1595)\fs58}SMALL HOLE BESIDE HIS
Dialogue: 0,0:00:51.46,0:00:53.41,S,,0,0,0,,{\pos(500,1595)\fs58}NOSE DID POLICE\NCALL PARAMEDICS.
Dialogue: 0,0:00:53.65,0:00:54.77,S,,0,0,0,,{\pos(500,1595)\fs58}A BULLET\NFRAGMENT WAS
Dialogue: 0,0:00:54.77,0:00:55.93,S,,0,0,0,,{\pos(500,1595)\fs58}LODGED BEHIND\NHIS LEFT
Dialogue: 0,0:00:55.93,0:00:57.05,S,,0,0,0,,{\pos(500,1595)\fs58}EYE, IN THE TEMPORAL
Dialogue: 0,0:00:57.05,0:00:58.09,S,,0,0,0,,{\pos(500,1595)\fs58}LOBE OF HIS BRAIN.
Dialogue: 0,0:00:58.29,0:01:00.46,S,,0,0,0,,{\pos(500,1595)\fs58}SWELLING MADE\NSURGERY NECESSARY.
Dialogue: 0,0:01:00.60,0:01:02.38,S,,0,0,0,,{\pos(500,1595)\fs58}RYAN {\c&H0073CCF0&}SURVIVED,{\c&H00FFFFFF&}\NBUT SUFFERED
Dialogue: 0,0:01:02.38,0:01:03.84,S,,0,0,0,,{\pos(500,1595)\fs58}A DEVASTATING INJURY.
Dialogue: 0,0:01:03.98,0:01:05.85,S,,0,0,0,,{\pos(500,1595)\fs58}INVESTIGATORS\NESTABLISHED THAT THE
Dialogue: 0,0:01:05.85,0:01:08.12,S,,0,0,0,,{\pos(500,1595)\fs55}ATTACK HAPPENED ON\NDECEMBER TWENTY-THIRD.
Dialogue: 0,0:01:08.29,0:01:10.00,S,,0,0,0,,{\pos(500,1595)\fs58}HELP ARRIVED\NTWO DAYS LATER.
Dialogue: 0,0:01:10.12,0:01:11.21,S,,0,0,0,,{\pos(500,1595)\fs58}RICHIE CARVER AND HIS
Dialogue: 0,0:01:11.21,0:01:13.47,S,,0,0,0,,{\pos(500,1595)\fs58}FATHER, LARRY, WERE\NBOTH CONVICTED.
Dialogue: 0,0:01:13.71,0:01:14.78,S,,0,0,0,,{\pos(500,1595)\fs58}BUT A CONVICTION DID
Dialogue: 0,0:01:14.78,0:01:16.25,S,,0,0,0,,{\pos(500,1595)\fs58}NOT END RYAN'S STORY.
Dialogue: 0,0:01:16.39,0:01:18.03,S,,0,0,0,,{\pos(500,1595)\fs58}ON JANUARY\NTWENTIETH, TWO
Dialogue: 0,0:01:18.03,0:01:19.79,S,,0,0,0,,{\pos(500,1595)\fs58}THOUSAND\NSIXTEEN, HE DIED.
Dialogue: 0,0:01:19.94,0:01:21.62,S,,0,0,0,,{\pos(500,1595)\fs58}HE WAS ONLY\NTWENTY-SEVEN.
Dialogue: 0,0:01:21.78,0:01:22.91,S,,0,0,0,,{\pos(500,1595)\fs58}AND THIS\NRECORDING LEAVES
Dialogue: 0,0:01:22.91,0:01:24.03,S,,0,0,0,,{\pos(500,1595)\fs58}A QUESTION: WHY WAS
Dialogue: 0,0:01:24.03,0:01:24.62,S,,0,0,0,,{\pos(500,1595)\fs58}A MAN WITH A
Dialogue: 0,0:01:24.62,0:01:26.14,S,,0,0,0,,{\pos(500,1595)\fs58}SEVERE FACIAL\NINJURY TREATED
Dialogue: 0,0:01:26.14,0:01:27.03,S,,0,0,0,,{\pos(500,1595)\fs58}AS A SUSPECT FOR
Dialogue: 0,0:01:27.03,0:01:28.37,S,,0,0,0,,{\pos(500,1595)\fs58}SO LONG BEFORE\NOFFICERS
Dialogue: 0,0:01:28.37,0:01:29.85,S,,0,0,0,,{\pos(500,1595)\fs58}RECOGNIZED HIS\NHEAD WOUND?

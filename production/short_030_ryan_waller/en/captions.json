[
  {
    "start": 0.07,
    "end": 1.2449999999999999,
    "words": 4,
    "text": "Police were questioning a"
  },
  {
    "start": 1.2449999999999999,
    "end": 2.12,
    "words": 3,
    "text": "young man about"
  },
  {
    "start": 2.12,
    "end": 3.4875000000000003,
    "words": 3,
    "text": "his girlfriend's murder."
  },
  {
    "start": 3.603521,
    "end": 4.766021,
    "words": 4,
    "text": "He struggled to answer"
  },
  {
    "start": 4.766021,
    "end": 6.021021,
    "words": 3,
    "text": "and seemed confused."
  },
  {
    "start": 6.175521,
    "end": 6.888021000000002,
    "words": 4,
    "text": "But they did not"
  },
  {
    "start": 6.888021000000002,
    "end": 7.950521000000002,
    "words": 4,
    "text": "know the most important"
  },
  {
    "start": 7.950521000000002,
    "end": 9.400521000000001,
    "words": 4,
    "text": "fact: a bullet fragment"
  },
  {
    "start": 9.400521000000001,
    "end": 11.030521000000002,
    "words": 5,
    "text": "was lodged inside his brain."
  },
  {
    "start": 11.270521000000002,
    "end": 12.221604000000003,
    "words": 1,
    "text": "Arizona."
  },
  {
    "start": 12.344333000000002,
    "end": 14.349333000000001,
    "words": 4,
    "text": "Christmas, two thousand six."
  },
  {
    "start": 14.495979000000004,
    "end": 16.015604,
    "words": 4,
    "text": "Ryan Waller never arrived"
  },
  {
    "start": 16.015604,
    "end": 17.17502,
    "words": 4,
    "text": "at his parents home."
  },
  {
    "start": 17.329979000000005,
    "end": 18.906021000000003,
    "words": 4,
    "text": "His mother called police."
  },
  {
    "start": 19.045250000000006,
    "end": 20.66287500000001,
    "words": 4,
    "text": "Inside his house, officers"
  },
  {
    "start": 20.66287500000001,
    "end": 21.957125000000005,
    "words": 4,
    "text": "found Heather Quan dead,"
  },
  {
    "start": 21.986417000000007,
    "end": 23.354166000000006,
    "words": 4,
    "text": "and Ryan still alive."
  },
  {
    "start": 23.482667000000014,
    "end": 25.303833000000015,
    "words": 5,
    "text": "His face was badly injured."
  },
  {
    "start": 25.464876000000018,
    "end": 27.151250000000015,
    "words": 4,
    "text": "Instead of immediate treatment,"
  },
  {
    "start": 27.19279200000002,
    "end": 28.205167000000014,
    "words": 3,
    "text": "he was questioned."
  },
  {
    "start": 28.445146833333347,
    "end": 29.763270833333348,
    "words": 4,
    "text": "Ryan tried to explain:"
  },
  {
    "start": 29.843646833333345,
    "end": 31.328812833333345,
    "words": 4,
    "text": "his former roommate, Richie"
  },
  {
    "start": 31.328812833333345,
    "end": 32.75206283333335,
    "words": 4,
    "text": "Carver, and Richie's father"
  },
  {
    "start": 32.75206283333335,
    "end": 33.87218783333335,
    "words": 5,
    "text": "had come to the house."
  },
  {
    "start": 33.991833833333345,
    "end": 35.24808283333335,
    "words": 4,
    "text": "He had been shot."
  },
  {
    "start": 35.4,
    "end": 37.4,
    "words": 5,
    "text": "So you got shot first?"
  },
  {
    "start": 37.4,
    "end": 37.9,
    "words": 1,
    "text": "Mm-hmm."
  },
  {
    "start": 37.9,
    "end": 38.8,
    "words": 3,
    "text": "And what happened?"
  },
  {
    "start": 38.8,
    "end": 39.5,
    "words": 3,
    "text": "Did you fall"
  },
  {
    "start": 39.5,
    "end": 40.199999999999996,
    "words": 3,
    "text": "on the ground?"
  },
  {
    "start": 40.199999999999996,
    "end": 41.08,
    "words": 4,
    "text": "Yeah, I was trying"
  },
  {
    "start": 41.08,
    "end": 41.739999999999995,
    "words": 3,
    "text": "to get up"
  },
  {
    "start": 41.739999999999995,
    "end": 42.39052083333334,
    "words": 3,
    "text": "and could not."
  },
  {
    "start": 42.39052083333334,
    "end": 43.529145833333345,
    "words": 4,
    "text": "But officers did not"
  },
  {
    "start": 43.529145833333345,
    "end": 45.40418683333335,
    "words": 4,
    "text": "immediately recognize the wound."
  },
  {
    "start": 45.544374833333336,
    "end": 46.93049983333334,
    "words": 4,
    "text": "The court decision describes"
  },
  {
    "start": 46.93049983333334,
    "end": 48.92933283333334,
    "words": 5,
    "text": "him as disoriented and confused."
  },
  {
    "start": 49.09347983333333,
    "end": 50.23206283333333,
    "words": 4,
    "text": "Only after noticing a"
  },
  {
    "start": 50.23206283333333,
    "end": 51.45731283333333,
    "words": 4,
    "text": "small hole beside his"
  },
  {
    "start": 51.45731283333333,
    "end": 53.406645833333336,
    "words": 5,
    "text": "nose did police call paramedics."
  },
  {
    "start": 53.646645833333324,
    "end": 54.76777083333332,
    "words": 4,
    "text": "A bullet fragment was"
  },
  {
    "start": 54.76777083333332,
    "end": 55.927562833333326,
    "words": 4,
    "text": "lodged behind his left"
  },
  {
    "start": 55.927562833333326,
    "end": 57.048729833333326,
    "words": 4,
    "text": "eye, in the temporal"
  },
  {
    "start": 57.048729833333326,
    "end": 58.093645833333326,
    "words": 4,
    "text": "lobe of his brain."
  },
  {
    "start": 58.29316683333332,
    "end": 60.459291833333324,
    "words": 4,
    "text": "Swelling made surgery necessary."
  },
  {
    "start": 60.603333833333316,
    "end": 62.38166683333332,
    "words": 4,
    "text": "Ryan survived, but suffered"
  },
  {
    "start": 62.38166683333332,
    "end": 63.838999833333325,
    "words": 3,
    "text": "a devastating injury."
  },
  {
    "start": 63.98308383333331,
    "end": 65.85162583333332,
    "words": 4,
    "text": "Investigators established that the"
  },
  {
    "start": 65.85162583333332,
    "end": 68.12079183333331,
    "words": 5,
    "text": "attack happened on December twenty-third."
  },
  {
    "start": 68.2940008333333,
    "end": 69.9961258333333,
    "words": 5,
    "text": "Help arrived two days later."
  },
  {
    "start": 70.1162918333333,
    "end": 71.21166683333331,
    "words": 4,
    "text": "Richie Carver and his"
  },
  {
    "start": 71.21166683333331,
    "end": 73.4679578333333,
    "words": 5,
    "text": "father, Larry, were both convicted."
  },
  {
    "start": 73.70793799999996,
    "end": 74.77939599999996,
    "words": 4,
    "text": "But a conviction did"
  },
  {
    "start": 74.77939599999996,
    "end": 76.24864499999995,
    "words": 4,
    "text": "not end Ryan's story."
  },
  {
    "start": 76.38593799999995,
    "end": 78.03131299999995,
    "words": 4,
    "text": "On January twentieth, two"
  },
  {
    "start": 78.03131299999995,
    "end": 79.79397899999995,
    "words": 4,
    "text": "thousand sixteen, he died."
  },
  {
    "start": 79.93602099999995,
    "end": 81.62214599999994,
    "words": 4,
    "text": "He was only twenty-seven."
  },
  {
    "start": 81.77572999999994,
    "end": 82.91093799999994,
    "words": 4,
    "text": "And this recording leaves"
  },
  {
    "start": 82.91093799999994,
    "end": 84.03339599999994,
    "words": 4,
    "text": "a question: why was"
  },
  {
    "start": 84.03339599999994,
    "end": 84.62014599999995,
    "words": 4,
    "text": "a man with a"
  },
  {
    "start": 84.62014599999995,
    "end": 86.13797999999994,
    "words": 4,
    "text": "severe facial injury treated"
  },
  {
    "start": 86.13797999999994,
    "end": 87.03085499999995,
    "words": 4,
    "text": "as a suspect for"
  },
  {
    "start": 87.03085499999995,
    "end": 88.37014599999995,
    "words": 4,
    "text": "so long before officers"
  },
  {
    "start": 88.37014599999995,
    "end": 89.85218699999994,
    "words": 4,
    "text": "recognized his head wound?"
  }
]
[
  {
    "start": 0.07,
    "end": 1.8825,
    "words": 4,
    "text": "Полицейские допрашивали парня по"
  },
  {
    "start": 1.8825,
    "end": 3.5500000000000003,
    "words": 4,
    "text": "делу об убийстве девушки."
  },
  {
    "start": 3.5805210000000005,
    "end": 4.893021000000001,
    "words": 4,
    "text": "Он путался в ответах"
  },
  {
    "start": 4.893021000000001,
    "end": 6.548020999999999,
    "words": 4,
    "text": "и едва понимал вопросы."
  },
  {
    "start": 6.590375000000002,
    "end": 7.477875000000001,
    "words": 4,
    "text": "Но они не знали"
  },
  {
    "start": 7.477875000000001,
    "end": 8.877875000000001,
    "words": 4,
    "text": "главного: в его мозге"
  },
  {
    "start": 8.877875000000001,
    "end": 10.682875000000003,
    "words": 3,
    "text": "находился осколок пули."
  },
  {
    "start": 10.922875000000001,
    "end": 11.844958000000002,
    "words": 1,
    "text": "Аризона."
  },
  {
    "start": 11.885645000000002,
    "end": 14.330020000000001,
    "words": 5,
    "text": "Рождество две тысячи шестого года."
  },
  {
    "start": 14.349000000000002,
    "end": 15.549500000000004,
    "words": 3,
    "text": "Райан Уоллер не"
  },
  {
    "start": 15.549500000000004,
    "end": 16.731457000000002,
    "words": 3,
    "text": "пришёл к родителям."
  },
  {
    "start": 16.754687000000008,
    "end": 18.87104200000001,
    "words": 4,
    "text": "Его мать вызвала полицию."
  },
  {
    "start": 18.87104200000001,
    "end": 20.294334000000006,
    "words": 4,
    "text": "В доме обнаружили тело"
  },
  {
    "start": 20.294334000000006,
    "end": 22.20650000000001,
    "words": 4,
    "text": "его девушки, Хизер Куан."
  },
  {
    "start": 22.239813000000012,
    "end": 23.570312000000012,
    "words": 3,
    "text": "Райан был жив."
  },
  {
    "start": 23.618854000000013,
    "end": 24.41093700000001,
    "words": 3,
    "text": "На его лице"
  },
  {
    "start": 24.41093700000001,
    "end": 26.204250000000016,
    "words": 3,
    "text": "были тяжёлые повреждения."
  },
  {
    "start": 26.204250000000016,
    "end": 29.094166000000012,
    "words": 5,
    "text": "Вместо немедленной помощи начался допрос."
  },
  {
    "start": 29.314146500000007,
    "end": 31.133437500000007,
    "words": 4,
    "text": "Райан пытался объяснить: в"
  },
  {
    "start": 31.133437500000007,
    "end": 32.22256250000001,
    "words": 4,
    "text": "дом пришли его бывший"
  },
  {
    "start": 32.22256250000001,
    "end": 33.34881250000001,
    "words": 3,
    "text": "сосед Ричи Карвер"
  },
  {
    "start": 33.34881250000001,
    "end": 34.53077050000001,
    "words": 3,
    "text": "и отец Ричи."
  },
  {
    "start": 34.5480425,
    "end": 36.0,
    "words": 3,
    "text": "В него выстрелили."
  },
  {
    "start": 36.0,
    "end": 37.0,
    "words": 3,
    "text": "То есть сначала"
  },
  {
    "start": 37.0,
    "end": 38.0,
    "words": 3,
    "text": "выстрелили в вас?"
  },
  {
    "start": 38.0,
    "end": 38.5,
    "words": 1,
    "text": "Угу."
  },
  {
    "start": 38.5,
    "end": 39.4,
    "words": 3,
    "text": "И что случилось?"
  },
  {
    "start": 39.4,
    "end": 40.8,
    "words": 4,
    "text": "Вы упали на пол?"
  },
  {
    "start": 40.8,
    "end": 42.05714285714286,
    "words": 4,
    "text": "Да, я пытался встать"
  },
  {
    "start": 42.05714285714286,
    "end": 43.0063345,
    "words": 3,
    "text": "и не мог."
  },
  {
    "start": 43.0063345,
    "end": 44.4295845,
    "words": 4,
    "text": "Но полицейские не сразу"
  },
  {
    "start": 44.4295845,
    "end": 46.465500500000005,
    "words": 5,
    "text": "поняли, что перед ними раненый."
  },
  {
    "start": 46.496126499999995,
    "end": 48.4267925,
    "words": 4,
    "text": "Судебное решение описывает его"
  },
  {
    "start": 48.4267925,
    "end": 51.6959385,
    "words": 5,
    "text": "состояние: растерянность и спутанность сознания."
  },
  {
    "start": 51.6959385,
    "end": 53.50289649999999,
    "words": 4,
    "text": "Только заметив маленькое отверстие"
  },
  {
    "start": 53.50289649999999,
    "end": 56.1699795,
    "words": 5,
    "text": "сбоку носа, сотрудники вызвали медиков."
  },
  {
    "start": 56.389959666666655,
    "end": 57.96212566666666,
    "words": 4,
    "text": "Фрагмент пули застрял за"
  },
  {
    "start": 57.96212566666666,
    "end": 58.92862566666666,
    "words": 3,
    "text": "левым глазом, в"
  },
  {
    "start": 58.92862566666666,
    "end": 60.57925066666666,
    "words": 3,
    "text": "височной доле мозга."
  },
  {
    "start": 60.61616766666665,
    "end": 62.09924966666665,
    "words": 2,
    "text": "Начался отёк."
  },
  {
    "start": 62.146292666666646,
    "end": 64.00773066666665,
    "words": 2,
    "text": "Потребовалась операция."
  },
  {
    "start": 64.00773066666665,
    "end": 65.32214766666664,
    "words": 3,
    "text": "Райан выжил, но"
  },
  {
    "start": 65.32214766666664,
    "end": 66.99856366666663,
    "words": 3,
    "text": "получил тяжёлую травму."
  },
  {
    "start": 67.00604366666664,
    "end": 69.69933466666663,
    "words": 4,
    "text": "Следствие установило: нападение произошло"
  },
  {
    "start": 69.69933466666663,
    "end": 71.33708466666661,
    "words": 3,
    "text": "двадцать третьего декабря."
  },
  {
    "start": 71.37537666666661,
    "end": 72.52229266666662,
    "words": 3,
    "text": "Помощь пришла лишь"
  },
  {
    "start": 72.52229266666662,
    "end": 73.68320966666661,
    "words": 3,
    "text": "через два дня."
  },
  {
    "start": 73.69012566666662,
    "end": 75.0303346666666,
    "words": 4,
    "text": "Ричи Карвер и его"
  },
  {
    "start": 75.0303346666666,
    "end": 77.0030836666666,
    "words": 4,
    "text": "отец Ларри были осуждены."
  },
  {
    "start": 77.22306383333327,
    "end": 78.53685483333328,
    "words": 4,
    "text": "Но для Райана история"
  },
  {
    "start": 78.53685483333328,
    "end": 80.21022983333327,
    "words": 3,
    "text": "не закончилась приговором."
  },
  {
    "start": 80.23245983333327,
    "end": 81.99266783333327,
    "words": 4,
    "text": "Двадцатого января две тысячи"
  },
  {
    "start": 81.99266783333327,
    "end": 83.81908383333327,
    "words": 4,
    "text": "шестнадцатого года он умер."
  },
  {
    "start": 83.84773083333329,
    "end": 84.90639683333328,
    "words": 3,
    "text": "Ему было всего"
  },
  {
    "start": 84.90639683333328,
    "end": 86.20825183333326,
    "words": 3,
    "text": "двадцать семь лет."
  },
  {
    "start": 86.20825183333326,
    "end": 87.57304283333326,
    "words": 4,
    "text": "И эта запись оставляет"
  },
  {
    "start": 87.57304283333326,
    "end": 89.03987683333327,
    "words": 4,
    "text": "вопрос: почему в человеке"
  },
  {
    "start": 89.03987683333327,
    "end": 90.18783483333326,
    "words": 4,
    "text": "с тяжёлой травмой лица"
  },
  {
    "start": 90.18783483333326,
    "end": 91.92500083333326,
    "words": 4,
    "text": "так долго видели подозреваемого,"
  },
  {
    "start": 92.07562683333327,
    "end": 94.37400083333327,
    "words": 5,
    "text": "прежде чем распознали ранение головы?"
  }
]
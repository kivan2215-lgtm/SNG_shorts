[
  {
    "start": 0.05,
    "end": 1.63,
    "words": 4,
    "text": "Подлодка легла на дно."
  },
  {
    "start": 1.6806039999999998,
    "end": 3.853187,
    "words": 4,
    "text": "Внутри ещё оставались живые."
  },
  {
    "start": 3.853187,
    "end": 5.170687,
    "words": 4,
    "text": "Чтобы добраться до них,"
  },
  {
    "start": 5.240687,
    "end": 6.790687,
    "words": 4,
    "text": "спасателям нужно было открыть"
  },
  {
    "start": 6.790687,
    "end": 7.883187,
    "words": 3,
    "text": "люк под водой."
  },
  {
    "start": 7.891,
    "end": 9.041,
    "words": 4,
    "text": "Но как не затопить"
  },
  {
    "start": 9.041,
    "end": 11.033500000000002,
    "words": 4,
    "text": "тех, кого пришли спасать?"
  },
  {
    "start": 11.2535,
    "end": 13.221333,
    "words": 4,
    "text": "Двадцать третье мая, тысяча"
  },
  {
    "start": 13.221333,
    "end": 14.873624000000001,
    "words": 4,
    "text": "девятьсот тридцать девятый год."
  },
  {
    "start": 14.919646000000004,
    "end": 16.194396000000005,
    "words": 4,
    "text": "У берегов США новая"
  },
  {
    "start": 16.194396000000005,
    "end": 18.149813,
    "words": 3,
    "text": "подлодка «Скволус» уходит"
  },
  {
    "start": 18.149813,
    "end": 19.785709000000008,
    "words": 3,
    "text": "на испытательное погружение."
  },
  {
    "start": 19.785709000000008,
    "end": 22.291958000000008,
    "words": 5,
    "text": "Клапан подачи воздуха не закрывается."
  },
  {
    "start": 22.31883400000001,
    "end": 24.008208000000007,
    "words": 3,
    "text": "Вода врывается внутрь."
  },
  {
    "start": 24.065834000000013,
    "end": 26.101792000000014,
    "words": 3,
    "text": "Кормовые отсеки затоплены."
  },
  {
    "start": 26.140751000000016,
    "end": 28.337584000000017,
    "words": 4,
    "text": "Двадцать шесть человек погибли."
  },
  {
    "start": 28.366751000000008,
    "end": 30.687375000000007,
    "words": 5,
    "text": "Остальные успели перекрыть путь воде."
  },
  {
    "start": 30.90735516666667,
    "end": 32.83235516666667,
    "words": 4,
    "text": "Тридцать три человека оказались"
  },
  {
    "start": 32.83235516666667,
    "end": 34.549855166666674,
    "words": 3,
    "text": "отрезаны от поверхности."
  },
  {
    "start": 34.588043166666665,
    "end": 37.13054316666667,
    "words": 4,
    "text": "Глубина семьдесят четыре метра."
  },
  {
    "start": 37.15425116666666,
    "end": 38.55425116666666,
    "words": 4,
    "text": "Тогда к лодке спустили"
  },
  {
    "start": 38.55425116666666,
    "end": 40.446751166666665,
    "words": 3,
    "text": "стальную спасательную камеру."
  },
  {
    "start": 40.47583416666666,
    "end": 41.838334166666655,
    "words": 4,
    "text": "Но просто поставить её"
  },
  {
    "start": 41.838334166666655,
    "end": 43.643334166666655,
    "words": 4,
    "text": "над люком было недостаточно."
  },
  {
    "start": 43.86333416666665,
    "end": 46.40583416666665,
    "words": 4,
    "text": "Водолаз закрепил направляющий трос."
  },
  {
    "start": 46.48702216666665,
    "end": 47.33702216666665,
    "words": 3,
    "text": "По нему камеру"
  },
  {
    "start": 47.33702216666665,
    "end": 48.56702216666665,
    "words": 3,
    "text": "подтянули к люку."
  },
  {
    "start": 48.59966816666664,
    "end": 50.47466816666664,
    "words": 3,
    "text": "Резиновое кольцо герметично"
  },
  {
    "start": 50.47466816666664,
    "end": 51.79216816666664,
    "words": 3,
    "text": "прижалось к корпусу."
  },
  {
    "start": 51.827147166666634,
    "end": 52.96464716666664,
    "words": 3,
    "text": "Из нижнего отсека"
  },
  {
    "start": 52.96464716666664,
    "end": 54.45714716666664,
    "words": 3,
    "text": "камеры убрали воду."
  },
  {
    "start": 54.49350116666662,
    "end": 56.05600116666662,
    "words": 4,
    "text": "Между лодкой и камерой"
  },
  {
    "start": 56.05600116666662,
    "end": 57.698501166666624,
    "words": 3,
    "text": "появился сухой проход."
  },
  {
    "start": 57.71289716666662,
    "end": 58.86289716666661,
    "words": 3,
    "text": "Только теперь люки"
  },
  {
    "start": 58.86289716666661,
    "end": 60.06789716666662,
    "words": 3,
    "text": "можно было открыть."
  },
  {
    "start": 60.0877301666666,
    "end": 61.8752301666666,
    "words": 4,
    "text": "Люди переходили внутрь, и"
  },
  {
    "start": 61.8752301666666,
    "end": 63.6302301666666,
    "words": 4,
    "text": "камера поднимала их наверх."
  },
  {
    "start": 63.850230166666606,
    "end": 65.8552291666666,
    "words": 3,
    "text": "Потребовалось четыре рейса."
  },
  {
    "start": 65.8780841666666,
    "end": 67.6127921666666,
    "words": 4,
    "text": "На поверхность доставили всех"
  },
  {
    "start": 67.6127921666666,
    "end": 70.2074181666666,
    "words": 5,
    "text": "тридцать трёх, кто пережил затопление."
  },
  {
    "start": 70.2074181666666,
    "end": 71.6487511666666,
    "words": 4,
    "text": "Впервые людей спасли с"
  },
  {
    "start": 71.6487511666666,
    "end": 73.89360516666659,
    "words": 4,
    "text": "затонувшей подлодки таким способом."
  },
  {
    "start": 73.89360516666659,
    "end": 75.89860516666658,
    "words": 5,
    "text": "Они не могли выбраться сами."
  },
  {
    "start": 75.92870916666658,
    "end": 77.95679316666659,
    "words": 4,
    "text": "Поэтому спасатели доставили выход"
  },
  {
    "start": 77.95679316666659,
    "end": 78.90312516666658,
    "words": 3,
    "text": "прямо на дно."
  }
]
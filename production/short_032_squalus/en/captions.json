[
  {
    "start": 0.05,
    "end": 1.1625,
    "words": 3,
    "text": "A submarine sank"
  },
  {
    "start": 1.1625,
    "end": 2.0925,
    "words": 3,
    "text": "to the seabed."
  },
  {
    "start": 2.228271,
    "end": 4.133271,
    "words": 5,
    "text": "People were still alive inside."
  },
  {
    "start": 4.3295,
    "end": 5.742000000000001,
    "words": 4,
    "text": "To reach them, rescuers"
  },
  {
    "start": 5.742000000000001,
    "end": 6.392,
    "words": 3,
    "text": "had to open"
  },
  {
    "start": 6.392,
    "end": 7.572,
    "words": 3,
    "text": "a hatch underwater."
  },
  {
    "start": 7.6839580000000005,
    "end": 8.321458,
    "words": 4,
    "text": "But how could they"
  },
  {
    "start": 8.321458,
    "end": 9.483958,
    "words": 4,
    "text": "do that without flooding"
  },
  {
    "start": 9.483958,
    "end": 10.058958,
    "words": 3,
    "text": "the people they"
  },
  {
    "start": 10.058958,
    "end": 11.001458000000001,
    "words": 3,
    "text": "came to save?"
  },
  {
    "start": 11.220958,
    "end": 13.591082,
    "words": 4,
    "text": "May twenty-third, nineteen thirty-nine."
  },
  {
    "start": 13.769791,
    "end": 15.224040000000002,
    "words": 4,
    "text": "Off the American coast,"
  },
  {
    "start": 15.292041,
    "end": 16.628666000000003,
    "words": 4,
    "text": "the new submarine Squalus"
  },
  {
    "start": 16.628666000000003,
    "end": 17.860165,
    "words": 4,
    "text": "begins a test dive."
  },
  {
    "start": 18.030332,
    "end": 19.255581999999997,
    "words": 4,
    "text": "An air induction valve"
  },
  {
    "start": 19.255581999999997,
    "end": 20.363289999999996,
    "words": 3,
    "text": "fails to close."
  },
  {
    "start": 20.513604,
    "end": 21.955478000000003,
    "words": 3,
    "text": "Seawater pours in."
  },
  {
    "start": 22.120979000000005,
    "end": 23.859895000000005,
    "words": 4,
    "text": "The aft compartments flood."
  },
  {
    "start": 24.038771000000004,
    "end": 25.641520000000003,
    "words": 3,
    "text": "Twenty-six people die."
  },
  {
    "start": 25.785021000000008,
    "end": 26.81227100000001,
    "words": 4,
    "text": "The others manage to"
  },
  {
    "start": 26.81227100000001,
    "end": 28.04372900000001,
    "words": 4,
    "text": "seal off the water."
  },
  {
    "start": 28.263709166666665,
    "end": 29.68870916666667,
    "words": 4,
    "text": "Thirty-three people are trapped"
  },
  {
    "start": 29.68870916666667,
    "end": 30.818709166666668,
    "words": 3,
    "text": "below the surface."
  },
  {
    "start": 30.96825116666666,
    "end": 31.805751166666667,
    "words": 3,
    "text": "The depth: two"
  },
  {
    "start": 31.805751166666667,
    "end": 33.33575116666667,
    "words": 3,
    "text": "hundred forty-three feet."
  },
  {
    "start": 33.47910516666666,
    "end": 34.55410516666666,
    "words": 4,
    "text": "Then a steel rescue"
  },
  {
    "start": 34.55410516666666,
    "end": 35.491605166666666,
    "words": 3,
    "text": "chamber is lowered"
  },
  {
    "start": 35.491605166666666,
    "end": 36.62160516666667,
    "words": 3,
    "text": "toward the submarine."
  },
  {
    "start": 36.81456316666666,
    "end": 37.90206316666666,
    "words": 4,
    "text": "But simply placing it"
  },
  {
    "start": 37.90206316666666,
    "end": 38.72706316666666,
    "words": 4,
    "text": "over the hatch will"
  },
  {
    "start": 38.72706316666666,
    "end": 39.69456316666666,
    "words": 3,
    "text": "not be enough."
  },
  {
    "start": 39.91456316666665,
    "end": 41.00206316666666,
    "words": 3,
    "text": "A diver attaches"
  },
  {
    "start": 41.00206316666666,
    "end": 41.93206316666666,
    "words": 3,
    "text": "a guide cable."
  },
  {
    "start": 42.03616716666665,
    "end": 43.111167166666654,
    "words": 4,
    "text": "The chamber is pulled"
  },
  {
    "start": 43.111167166666654,
    "end": 44.34116716666665,
    "words": 4,
    "text": "down onto the hatch."
  },
  {
    "start": 44.51031316666664,
    "end": 45.585313166666644,
    "words": 4,
    "text": "A rubber ring forms"
  },
  {
    "start": 45.585313166666644,
    "end": 46.54781316666664,
    "words": 3,
    "text": "a watertight seal"
  },
  {
    "start": 46.54781316666664,
    "end": 47.54031316666664,
    "words": 3,
    "text": "against the hull."
  },
  {
    "start": 47.66581316666664,
    "end": 48.890813166666646,
    "words": 4,
    "text": "Water is removed from"
  },
  {
    "start": 48.890813166666646,
    "end": 50.658313166666645,
    "words": 4,
    "text": "the chamber's lower compartment."
  },
  {
    "start": 50.80373016666664,
    "end": 51.89123016666664,
    "words": 4,
    "text": "A dry passage now"
  },
  {
    "start": 51.89123016666664,
    "end": 53.32123016666664,
    "words": 4,
    "text": "connects the two vessels."
  },
  {
    "start": 53.461063166666634,
    "end": 54.24856316666663,
    "words": 3,
    "text": "Only then can"
  },
  {
    "start": 54.24856316666663,
    "end": 55.29106316666664,
    "words": 3,
    "text": "the hatches open."
  },
  {
    "start": 55.446730166666626,
    "end": 56.93423016666662,
    "words": 4,
    "text": "People climb inside, and"
  },
  {
    "start": 56.93423016666662,
    "end": 58.04673016666662,
    "words": 4,
    "text": "the chamber carries them"
  },
  {
    "start": 58.04673016666662,
    "end": 59.08923016666663,
    "words": 3,
    "text": "toward the surface."
  },
  {
    "start": 59.31023016666663,
    "end": 60.77956316666663,
    "words": 4,
    "text": "It takes four trips."
  },
  {
    "start": 60.91789616666662,
    "end": 62.28268816666663,
    "words": 4,
    "text": "All thirty-three people who"
  },
  {
    "start": 62.28268816666663,
    "end": 63.45614616666663,
    "words": 4,
    "text": "survived the flooding are"
  },
  {
    "start": 63.45614616666663,
    "end": 64.51727116666662,
    "words": 3,
    "text": "brought up alive."
  },
  {
    "start": 64.67470816666662,
    "end": 65.49104216666662,
    "words": 4,
    "text": "It is the first"
  },
  {
    "start": 65.49104216666662,
    "end": 66.67725016666662,
    "words": 4,
    "text": "rescue from a sunken"
  },
  {
    "start": 66.67725016666662,
    "end": 68.47816616666661,
    "words": 4,
    "text": "submarine using this method."
  },
  {
    "start": 68.52766716666662,
    "end": 69.52254216666663,
    "words": 4,
    "text": "They could not escape"
  },
  {
    "start": 69.52254216666663,
    "end": 70.27754216666662,
    "words": 3,
    "text": "on their own."
  },
  {
    "start": 70.45785516666662,
    "end": 71.78439616666661,
    "words": 4,
    "text": "So rescuers brought the"
  },
  {
    "start": 71.78439616666661,
    "end": 73.04956316666662,
    "words": 5,
    "text": "way out down to them."
  }
]
[
  {
    "start": 0.05,
    "end": 1.45,
    "words": 4,
    "text": "Полгода полиция не могла"
  },
  {
    "start": 1.45,
    "end": 3.03,
    "words": 3,
    "text": "найти убийцу женщины."
  },
  {
    "start": 3.088313,
    "end": 5.180813,
    "words": 5,
    "text": "Потом к детективам пришёл врач."
  },
  {
    "start": 5.247813000000001,
    "end": 6.860313,
    "words": 4,
    "text": "Он сказал: «Моя жена"
  },
  {
    "start": 6.860313,
    "end": 8.527813,
    "words": 3,
    "text": "говорит голосом убитой»."
  },
  {
    "start": 8.568812999999999,
    "end": 10.318812999999999,
    "words": 4,
    "text": "И назвал имя, которое"
  },
  {
    "start": 10.318812999999999,
    "end": 11.623813,
    "words": 3,
    "text": "услышал от неё."
  },
  {
    "start": 11.843813,
    "end": 13.596271,
    "words": 3,
    "text": "Чикаго, тысяча девятьсот"
  },
  {
    "start": 13.596271,
    "end": 14.96402,
    "words": 3,
    "text": "семьдесят седьмой год."
  },
  {
    "start": 14.988292000000001,
    "end": 16.140251000000003,
    "words": 3,
    "text": "В квартире Тереситы"
  },
  {
    "start": 16.140251000000003,
    "end": 17.704084,
    "words": 3,
    "text": "Басы вспыхнул пожар."
  },
  {
    "start": 17.746938000000004,
    "end": 19.604896000000004,
    "words": 4,
    "text": "Пожарные нашли её тело."
  },
  {
    "start": 19.645813000000008,
    "end": 21.32472900000001,
    "words": 4,
    "text": "Тереситу убили ножом, а"
  },
  {
    "start": 21.32472900000001,
    "end": 23.182646000000005,
    "words": 4,
    "text": "огнём пытались скрыть следы."
  },
  {
    "start": 23.213563000000008,
    "end": 25.022479000000008,
    "words": 4,
    "text": "Следствие зашло в тупик."
  },
  {
    "start": 25.242459166666677,
    "end": 27.012250166666675,
    "words": 4,
    "text": "Спустя несколько месяцев жена"
  },
  {
    "start": 27.012250166666675,
    "end": 28.28700016666668,
    "words": 4,
    "text": "врача Реми Чуа стала"
  },
  {
    "start": 28.28700016666668,
    "end": 29.580375166666673,
    "words": 3,
    "text": "вести себя странно."
  },
  {
    "start": 29.621938166666673,
    "end": 31.19372916666667,
    "words": 4,
    "text": "По словам мужа, трижды"
  },
  {
    "start": 31.19372916666667,
    "end": 32.71602116666667,
    "words": 4,
    "text": "она говорила чужим голосом"
  },
  {
    "start": 32.71602116666667,
    "end": 34.43018716666667,
    "words": 4,
    "text": "и называла себя Тереситой."
  },
  {
    "start": 34.43483416666667,
    "end": 36.043709166666666,
    "words": 4,
    "text": "Супруги долго не решались"
  },
  {
    "start": 36.043709166666666,
    "end": 37.17577116666666,
    "words": 3,
    "text": "идти в полицию."
  },
  {
    "start": 37.17577116666666,
    "end": 39.24260516666666,
    "words": 4,
    "text": "Наконец женщина назвала Аллана"
  },
  {
    "start": 39.24260516666666,
    "end": 41.73643716666666,
    "words": 5,
    "text": "Шоуэри сотрудника той же больницы."
  },
  {
    "start": 41.788042166666656,
    "end": 43.08754216666665,
    "words": 4,
    "text": "И сказала, что он"
  },
  {
    "start": 43.08754216666665,
    "end": 44.950250166666656,
    "words": 3,
    "text": "забрал украшения погибшей."
  },
  {
    "start": 45.170229999999975,
    "end": 47.52385499999997,
    "words": 4,
    "text": "Детективы проверили это имя."
  },
  {
    "start": 47.52385499999997,
    "end": 49.17335499999997,
    "words": 4,
    "text": "У девушки Шоуэри нашли"
  },
  {
    "start": 49.17335499999997,
    "end": 50.38468799999997,
    "words": 3,
    "text": "жемчужное кольцо и"
  },
  {
    "start": 50.38468799999997,
    "end": 52.13839599999997,
    "words": 3,
    "text": "нефритовый кулон Тереситы."
  },
  {
    "start": 52.15595899999997,
    "end": 54.52824999999998,
    "words": 5,
    "text": "Это уже были настоящие улики."
  },
  {
    "start": 54.58516699999997,
    "end": 56.50529199999997,
    "words": 3,
    "text": "Шоуэри признался, затем"
  },
  {
    "start": 56.50529199999997,
    "end": 58.061145999999965,
    "words": 3,
    "text": "отказался от признания."
  },
  {
    "start": 58.061145999999965,
    "end": 60.54781299999995,
    "words": 5,
    "text": "Первый суд закончился без решения."
  },
  {
    "start": 60.54781299999995,
    "end": 62.042687999999956,
    "words": 4,
    "text": "Позже он сам признал"
  },
  {
    "start": 62.042687999999956,
    "end": 63.00914599999996,
    "words": 3,
    "text": "вину и получил"
  },
  {
    "start": 63.00914599999996,
    "end": 64.60822899999995,
    "words": 3,
    "text": "четырнадцать лет тюрьмы."
  },
  {
    "start": 64.82820916666661,
    "end": 66.70562516666661,
    "words": 5,
    "text": "Но что произошло с Реми?"
  },
  {
    "start": 66.7499791666666,
    "end": 67.9106881666666,
    "words": 4,
    "text": "Она тоже работала в"
  },
  {
    "start": 67.9106881666666,
    "end": 69.27547916666661,
    "words": 4,
    "text": "больнице и могла узнать"
  },
  {
    "start": 69.27547916666661,
    "end": 70.8978541666666,
    "words": 3,
    "text": "что-то обычным способом."
  },
  {
    "start": 70.91385516666661,
    "end": 72.7633551666666,
    "words": 4,
    "text": "Источник её сведений так"
  },
  {
    "start": 72.7633551666666,
    "end": 73.7351881666666,
    "words": 3,
    "text": "и не установлен."
  },
  {
    "start": 73.7748131666666,
    "end": 75.2926461666666,
    "words": 3,
    "text": "Таинственный рассказ привёл"
  },
  {
    "start": 75.2926461666666,
    "end": 77.0425631666666,
    "words": 3,
    "text": "полицию к подозреваемому."
  },
  {
    "start": 77.0452711666666,
    "end": 79.5731881666666,
    "words": 4,
    "text": "А доказательством стали украшения."
  }
]
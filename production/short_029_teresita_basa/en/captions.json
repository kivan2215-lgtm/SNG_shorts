[
  {
    "start": 0.05,
    "end": 1.1875,
    "words": 4,
    "text": "Police could not find"
  },
  {
    "start": 1.1875,
    "end": 2.0125,
    "words": 3,
    "text": "a woman's killer"
  },
  {
    "start": 2.0125,
    "end": 3.0425,
    "words": 3,
    "text": "for six months."
  },
  {
    "start": 3.182125,
    "end": 4.244624999999999,
    "words": 4,
    "text": "Then a doctor came"
  },
  {
    "start": 4.244624999999999,
    "end": 5.312124999999999,
    "words": 3,
    "text": "to the detectives."
  },
  {
    "start": 5.431625,
    "end": 6.444125000000001,
    "words": 4,
    "text": "He said, My wife"
  },
  {
    "start": 6.444125000000001,
    "end": 7.044125000000001,
    "words": 3,
    "text": "speaks in the"
  },
  {
    "start": 7.044125000000001,
    "end": 8.186625000000001,
    "words": 3,
    "text": "dead woman's voice."
  },
  {
    "start": 8.326645999999998,
    "end": 8.939146,
    "words": 3,
    "text": "And he gave"
  },
  {
    "start": 8.939146,
    "end": 9.694146,
    "words": 3,
    "text": "them a name."
  },
  {
    "start": 9.913145999999998,
    "end": 12.212269999999998,
    "words": 3,
    "text": "Chicago, nineteen seventy-seven."
  },
  {
    "start": 12.382374999999998,
    "end": 13.387249999999996,
    "words": 4,
    "text": "A fire broke out"
  },
  {
    "start": 13.387249999999996,
    "end": 15.220707999999998,
    "words": 4,
    "text": "in Teresita Basa's apartment."
  },
  {
    "start": 15.291354,
    "end": 17.14927,
    "words": 4,
    "text": "Firefighters found her body."
  },
  {
    "start": 17.251813000000002,
    "end": 18.362187000000006,
    "words": 4,
    "text": "She had been stabbed,"
  },
  {
    "start": 18.428271000000006,
    "end": 19.224855000000005,
    "words": 4,
    "text": "and the fire was"
  },
  {
    "start": 19.224855000000005,
    "end": 20.445521000000003,
    "words": 5,
    "text": "meant to hide the crime."
  },
  {
    "start": 20.623022000000006,
    "end": 22.309396000000003,
    "words": 3,
    "text": "The investigation stalled."
  },
  {
    "start": 22.52887616666667,
    "end": 23.91500116666667,
    "words": 4,
    "text": "Months later, the doctor's"
  },
  {
    "start": 23.91500116666667,
    "end": 25.356917166666673,
    "words": 3,
    "text": "wife, Remibias Chua,"
  },
  {
    "start": 25.412542166666675,
    "end": 26.90391716666667,
    "words": 3,
    "text": "began acting strangely."
  },
  {
    "start": 27.00900116666668,
    "end": 27.937251166666677,
    "words": 4,
    "text": "Her husband said she"
  },
  {
    "start": 27.937251166666677,
    "end": 29.001584166666674,
    "words": 4,
    "text": "spoke in another voice"
  },
  {
    "start": 29.001584166666674,
    "end": 29.781292166666674,
    "words": 3,
    "text": "three times and"
  },
  {
    "start": 29.781292166666674,
    "end": 31.285084166666675,
    "words": 3,
    "text": "called herself Teresita."
  },
  {
    "start": 31.44858416666667,
    "end": 32.55008416666667,
    "words": 3,
    "text": "The couple hesitated"
  },
  {
    "start": 32.55008416666667,
    "end": 33.595916166666676,
    "words": 3,
    "text": "to tell police."
  },
  {
    "start": 33.74881316666667,
    "end": 35.29585516666667,
    "words": 4,
    "text": "Eventually, she named Allan"
  },
  {
    "start": 35.29585516666667,
    "end": 36.54585516666667,
    "words": 4,
    "text": "Showery, a worker at"
  },
  {
    "start": 36.54585516666667,
    "end": 37.61643816666667,
    "words": 3,
    "text": "the same hospital."
  },
  {
    "start": 37.740626166666665,
    "end": 38.63175116666666,
    "words": 4,
    "text": "She claimed he had"
  },
  {
    "start": 38.63175116666666,
    "end": 40.222125166666665,
    "words": 4,
    "text": "taken the victim's jewelry."
  },
  {
    "start": 40.44364623333333,
    "end": 42.08139633333334,
    "words": 4,
    "text": "Detectives checked the name."
  },
  {
    "start": 42.26650033333333,
    "end": 44.05887433333333,
    "words": 4,
    "text": "At Showery's girlfriend's home,"
  },
  {
    "start": 44.14795833333333,
    "end": 45.59125033333333,
    "words": 4,
    "text": "they found Teresita's pearl"
  },
  {
    "start": 45.59125033333333,
    "end": 46.95837533333333,
    "words": 4,
    "text": "ring and jade pendant."
  },
  {
    "start": 47.088229333333324,
    "end": 48.635770333333326,
    "words": 4,
    "text": "Those were real clues."
  },
  {
    "start": 48.777229333333324,
    "end": 51.072187333333325,
    "words": 4,
    "text": "Showery confessed, then recanted."
  },
  {
    "start": 51.22237533333332,
    "end": 52.56258333333332,
    "words": 4,
    "text": "His first trial ended"
  },
  {
    "start": 52.56258333333332,
    "end": 53.58174933333332,
    "words": 3,
    "text": "without a verdict."
  },
  {
    "start": 53.74183333333332,
    "end": 55.275333333333315,
    "words": 4,
    "text": "Later, he pleaded guilty"
  },
  {
    "start": 55.275333333333315,
    "end": 57.312541333333314,
    "words": 5,
    "text": "and received a fourteen-year sentence."
  },
  {
    "start": 57.533521499999985,
    "end": 59.35993749999999,
    "words": 5,
    "text": "But what happened to Remibias?"
  },
  {
    "start": 59.46854149999998,
    "end": 60.39966649999999,
    "words": 4,
    "text": "She also worked at"
  },
  {
    "start": 60.39966649999999,
    "end": 61.38183349999999,
    "words": 4,
    "text": "the hospital and might"
  },
  {
    "start": 61.38183349999999,
    "end": 62.287416499999985,
    "words": 4,
    "text": "have learned something in"
  },
  {
    "start": 62.287416499999985,
    "end": 63.399582499999994,
    "words": 3,
    "text": "an ordinary way."
  },
  {
    "start": 63.559749499999974,
    "end": 64.36333349999997,
    "words": 4,
    "text": "The source of her"
  },
  {
    "start": 64.36333349999997,
    "end": 66.40662449999996,
    "words": 4,
    "text": "information was never established."
  },
  {
    "start": 66.56195849999997,
    "end": 67.74820849999998,
    "words": 4,
    "text": "The strange account led"
  },
  {
    "start": 67.74820849999998,
    "end": 69.14095849999997,
    "words": 4,
    "text": "police to a suspect."
  },
  {
    "start": 69.28695849999997,
    "end": 71.41954149999997,
    "words": 5,
    "text": "The jewelry provided the evidence."
  }
]
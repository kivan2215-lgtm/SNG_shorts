[{"duration": 11.525, "script": ["Представь:", "ты", "несёшь", "олимпийский", "огонь", "через", "Сидней.", "Добегаешь", "до", "ратуши,", "а", "половина", "зрителей", "уже", "разошлась.", "Как,", "блядь,", "можно", "опоздать", "на", "встречу", "с", "огнём,", "если", "огонь", "у", "тебя", "в", "руке?"], "times": [0.0, 0.96, 1.06, 1.57, 2.08, 2.42, 3.01, 3.6, 4.046666666666667, 4.493333333333334, 4.94, 4.96, 5.4, 5.84, 6.14, 7.14, 7.51, 7.88, 8.06, 8.64, 8.82, 9.28, 9.42, 9.94, 10.14, 10.56, 10.64, 10.86, 11.0, 11.485000000000001], "heard": "Представь, ты несешь о лимпийский огонь через сидний. Добегаешь даратуши, а половина зрители уже разошлась. Как блять, можно опоздать на встречу с огнем, если огонь у тебя в руке."}, {"duration": 13.9375, "script": ["Отматываем", "назад.", "К", "ратуше", "бежит", "парень", "в", "брюках", "и", "галстуке.", "Полиция", "расчищает", "ему", "дорогу.", "Все", "смотрят", "на", "факел.", "Хоть", "бы", "один", "посмотрел", "на", "штаны.", "Кто", "бежит", "эстафету,", "одетый", "как", "на", "собеседование", "в", "банк?"], "times": [0.0, 0.66, 1.1333333333333333, 1.6066666666666667, 2.08, 2.42, 2.76, 2.92, 3.3, 3.89, 4.48, 4.94, 5.66, 5.88, 6.74, 6.88, 7.38, 7.56, 8.36, 8.52, 8.62, 8.88, 9.58, 9.72, 10.52, 10.64, 11.02, 11.61, 12.2, 12.32, 12.5, 13.3, 13.48, 13.8975], "heard": "Отматываем назад. Кратуши бежит парень в брюках и галстуки. Полиция расчищает ему дорогу. Все смотрят на факел. Хоть бы один посмотрел на штаны. Кто бежит эстафету, одетой как на собеседование в банк."}, {"duration": 12.9875, "script": ["Мэр", "принимает", "факел.", "На", "ладони", "серебряная", "краска.", "Он", "начинает", "речь.", "Вот", "бы", "такую", "уверенность:", "у", "тебя", "в", "руке", "облезает", "олимпийская", "реликвия,", "а", "ты", "такой:", "да", "похуй,", "у", "меня", "текст", "согласован."], "times": [0.03, 0.28, 0.86, 1.31, 1.76, 2.16, 2.92, 3.82, 3.94, 4.56, 5.2, 5.3, 5.44, 5.76, 6.84, 6.92, 7.14, 7.28, 7.54, 8.18, 8.98, 9.34, 9.700000000000001, 10.0
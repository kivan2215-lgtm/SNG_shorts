[
  {
    "start": 0.05,
    "end": 1.825,
    "words": 4,
    "text": "На школьной видеозаписи Кэсси"
  },
  {
    "start": 1.825,
    "end": 4.105,
    "words": 4,
    "text": "улыбается и говорит: «Привет»."
  },
  {
    "start": 4.138479,
    "end": 5.938479000000001,
    "words": 4,
    "text": "Позже полиция найдёт кассету"
  },
  {
    "start": 5.938479000000001,
    "end": 7.243479,
    "words": 3,
    "text": "закопанной в овраге."
  },
  {
    "start": 7.2475000000000005,
    "end": 8.385,
    "words": 4,
    "text": "А другие записи на"
  },
  {
    "start": 8.385,
    "end": 10.465,
    "words": 4,
    "text": "ней раскроют страшный замысел."
  },
  {
    "start": 10.685,
    "end": 13.155707,
    "words": 5,
    "text": "Айдахо, две тысячи шестой год."
  },
  {
    "start": 13.180019999999999,
    "end": 15.361394999999998,
    "words": 3,
    "text": "Шестнадцатилетняя Кэсси присматривала"
  },
  {
    "start": 15.361394999999998,
    "end": 16.680103,
    "words": 3,
    "text": "за домом родственников."
  },
  {
    "start": 16.740792,
    "end": 17.574125000000002,
    "words": 4,
    "text": "К ней и её"
  },
  {
    "start": 17.574125000000002,
    "end": 19.346290999999997,
    "words": 4,
    "text": "парню пришли двое друзей."
  },
  {
    "start": 19.351646000000002,
    "end": 20.731646,
    "words": 3,
    "text": "Они смотрели кино,"
  },
  {
    "start": 20.871271000000004,
    "end": 22.275771000000002,
    "words": 3,
    "text": "потом гости ушли."
  },
  {
    "start": 22.298854000000006,
    "end": 24.524437000000006,
    "words": 5,
    "text": "Через пятнадцать минут погас свет."
  },
  {
    "start": 24.58256200000001,
    "end": 26.477270000000008,
    "words": 3,
    "text": "Внизу послышались звуки."
  },
  {
    "start": 26.541917000000005,
    "end": 27.951209000000006,
    "words": 3,
    "text": "Парень позвонил одному"
  },
  {
    "start": 27.951209000000006,
    "end": 29.25766700000001,
    "words": 3,
    "text": "из ушедших друзей."
  },
  {
    "start": 29.266728999999998,
    "end": 31.227521000000003,
    "words": 4,
    "text": "Тот отвечал шёпотом: якобы"
  },
  {
    "start": 31.227521000000003,
    "end": 32.497228,
    "words": 3,
    "text": "сидел в кинотеатре."
  },
  {
    "start": 32.7172085,
    "end": 33.9053335,
    "words": 3,
    "text": "Парень уехал, и"
  },
  {
    "start": 33.9053335,
    "end": 35.409082500000004,
    "words": 3,
    "text": "Кэсси осталась одна."
  },
  {
    "start": 35.473187499999995,
    "end": 36.8346045,
    "words": 4,
    "text": "На следующий день она"
  },
  {
    "start": 36.8346045,
    "end": 38.2640615,
    "words": 4,
    "text": "не отвечала на звонки."
  },
  {
    "start": 38.29439549999999,
    "end": 39.56914549999999,
    "words": 4,
    "text": "Через двое суток после"
  },
  {
    "start": 39.56914549999999,
    "end": 40.96764549999999,
    "words": 3,
    "text": "того вечера родственники"
  },
  {
    "start": 40.96764549999999,
    "end": 42.22389449999999,
    "words": 3,
    "text": "нашли её мёртвой."
  },
  {
    "start": 42.26485349999999,
    "end": 44.02227049999999,
    "words": 3,
    "text": "Друзья повторяли полиции"
  },
  {
    "start": 44.02227049999999,
    "end": 45.26614449999999,
    "words": 3,
    "text": "историю про кино."
  },
  {
    "start": 45.320520499999986,
    "end": 46.23635449999998,
    "words": 4,
    "text": "Но один даже не"
  },
  {
    "start": 46.23635449999998,
    "end": 47.70302049999999,
    "words": 3,
    "text": "смог пересказать фильм."
  },
  {
    "start": 47.92300033333331,
    "end": 49.46937533333332,
    "words": 4,
    "text": "Затем один из подростков"
  },
  {
    "start": 49.46937533333332,
    "end": 50.577625333333316,
    "words": 3,
    "text": "привёл следователей к"
  },
  {
    "start": 50.577625333333316,
    "end": 51.80299933333332,
    "words": 3,
    "text": "тайнику в овраге."
  },
  {
    "start": 51.81956233333331,
    "end": 53.07068733333331,
    "words": 3,
    "text": "Там лежали ножи,"
  },
  {
    "start": 53.249979333333314,
    "end": 54.66864533333331,
    "words": 3,
    "text": "маски и кассета."
  },
  {
    "start": 54.7179583333333,
    "end": 56.1355003333333,
    "words": 4,
    "text": "На записи двое друзей"
  },
  {
    "start": 56.1355003333333,
    "end": 58.546416333333305,
    "words": 4,
    "text": "заранее обсуждали убийство Кэсси."
  },
  {
    "start": 58.58093833333329,
    "end": 60.4764383333333,
    "words": 4,
    "text": "Они оставили дверь незапертой,"
  },
  {
    "start": 60.6299383333333,
    "end": 62.35672933333329,
    "words": 4,
    "text": "вернулись и дождались, пока"
  },
  {
    "start": 62.35672933333329,
    "end": 63.646521333333304,
    "words": 3,
    "text": "она останется одна."
  },
  {
    "start": 63.6935423333333,
    "end": 65.30433433333329,
    "words": 4,
    "text": "Их звали Брайан Дрейпер"
  },
  {
    "start": 65.30433433333329,
    "end": 66.63279233333328,
    "words": 3,
    "text": "и Тори Адамчик."
  },
  {
    "start": 66.68345933333329,
    "end": 67.86904233333328,
    "words": 4,
    "text": "В две тысячи седьмом"
  },
  {
    "start": 67.86904233333328,
    "end": 69.91800033333328,
    "words": 4,
    "text": "году обоим назначили пожизненное"
  },
  {
    "start": 69.91800033333328,
    "end": 72.27737533333328,
    "words": 5,
    "text": "заключение без права на освобождение."
  },
  {
    "start": 72.49735516666661,
    "end": 74.83397916666661,
    "words": 5,
    "text": "А теперь вспомните школьную запись."
  },
  {
    "start": 74.90398016666661,
    "end": 77.3808961666666,
    "words": 5,
    "text": "Кэсси улыбается человеку с камерой."
  },
  {
    "start": 77.4080841666666,
    "end": 79.06875016666659,
    "words": 2,
    "text": "Говорит: «Привет»."
  },
  {
    "start": 79.1119591666666,
    "end": 80.64254216666659,
    "words": 4,
    "text": "Через несколько часов этот"
  },
  {
    "start": 80.64254216666659,
    "end": 82.0073341666666,
    "words": 3,
    "text": "человек примет участие"
  },
  {
    "start": 82.0073341666666,
    "end": 83.06845916666659,
    "words": 3,
    "text": "в её убийстве."
  },
  {
    "start": 83.1054801666666,
    "end": 84.99568816666658,
    "words": 5,
    "text": "Она ещё ничего не знала."
  },
  {
    "start": 85.01116716666658,
    "end": 86.91408316666657,
    "words": 4,
    "text": "А план уже существовал."
  }
]
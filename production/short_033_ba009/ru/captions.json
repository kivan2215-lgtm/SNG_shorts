[
  {
    "start": 0.05,
    "end": 1.9,
    "words": 4,
    "text": "У пассажирского самолёта один"
  },
  {
    "start": 1.9,
    "end": 3.9545630000000003,
    "words": 4,
    "text": "за другим остановились двигатели."
  },
  {
    "start": 3.9545630000000003,
    "end": 5.1095630000000005,
    "words": 2,
    "text": "Все четыре."
  },
  {
    "start": 5.154605000000001,
    "end": 6.367105000000001,
    "words": 3,
    "text": "За окнами появилось"
  },
  {
    "start": 6.367105000000001,
    "end": 8.251709000000002,
    "words": 3,
    "text": "странное голубое свечение."
  },
  {
    "start": 8.251709000000002,
    "end": 9.051708999999999,
    "words": 3,
    "text": "А экипаж не"
  },
  {
    "start": 9.051708999999999,
    "end": 10.769209000000002,
    "words": 3,
    "text": "понимал, что происходит."
  },
  {
    "start": 10.989209000000002,
    "end": 13.340709,
    "words": 4,
    "text": "Двадцать четвёртое июня, тысяча"
  },
  {
    "start": 13.340709,
    "end": 15.153875000000001,
    "words": 4,
    "text": "девятьсот восемьдесят второй год."
  },
  {
    "start": 15.173188000000003,
    "end": 17.555646,
    "words": 4,
    "text": "«Боинг» летит над Индонезией."
  },
  {
    "start": 17.598562000000005,
    "end": 19.312728000000003,
    "words": 4,
    "text": "В салон проникает дым."
  },
  {
    "start": 19.337645000000006,
    "end": 20.47627000000001,
    "words": 3,
    "text": "Самолёт больше не"
  },
  {
    "start": 20.47627000000001,
    "end": 21.918145000000006,
    "words": 3,
    "text": "может держать высоту."
  },
  {
    "start": 21.92956200000001,
    "end": 24.316770000000012,
    "words": 4,
    "text": "Пилоты пытаются запустить двигатели."
  },
  {
    "start": 24.316770000000012,
    "end": 25.832894000000014,
    "words": 3,
    "text": "Снова и снова."
  },
  {
    "start": 25.855665000000013,
    "end": 27.18616500000001,
    "words": 1,
    "text": "Безрезультатно."
  },
  {
    "start": 27.241353000000007,
    "end": 28.868894000000004,
    "words": 3,
    "text": "Под ними океан."
  },
  {
    "start": 29.088873833333334,
    "end": 30.07637383333334,
    "words": 3,
    "text": "Но причина была"
  },
  {
    "start": 30.07637383333334,
    "end": 30.93137383333334,
    "words": 3,
    "text": "не в топливе."
  },
  {
    "start": 30.965269833333334,
    "end": 32.02776983333334,
    "words": 3,
    "text": "Самолёт попал в"
  },
  {
    "start": 32.02776983333334,
    "end": 33.820269833333334,
    "words": 3,
    "text": "облако вулканического пепла."
  },
  {
    "start": 33.85179083333334,
    "end": 35.68179083333333,
    "words": 4,
    "text": "Ночью его не заметили."
  },
  {
    "start": 35.69987383333333,
    "end": 37.09987383333333,
    "words": 4,
    "text": "А погодный радар сухой"
  },
  {
    "start": 37.09987383333333,
    "end": 38.37987383333333,
    "words": 3,
    "text": "пепел не показал."
  },
  {
    "start": 38.39695683333332,
    "end": 40.03445683333332,
    "words": 4,
    "text": "В горячих частях двигателей"
  },
  {
    "start": 40.03445683333332,
    "end": 41.34695683333332,
    "words": 3,
    "text": "частицы плавились и"
  },
  {
    "start": 41.34695683333332,
    "end": 42.61445683333333,
    "words": 3,
    "text": "прилипали к деталям."
  },
  {
    "start": 42.64322783333331,
    "end": 44.51072783333333,
    "words": 3,
    "text": "Поток воздуха нарушился."
  },
  {
    "start": 44.54472783333331,
    "end": 46.12472783333332,
    "words": 2,
    "text": "Двигатели заглохли."
  },
  {
    "start": 46.34472783333331,
    "end": 48.4304778333333,
    "words": 4,
    "text": "И здесь произошло неожиданное."
  },
  {
    "start": 48.4304778333333,
    "end": 50.40547783333331,
    "words": 4,
    "text": "Пока самолёт снижался, он"
  },
  {
    "start": 50.40547783333331,
    "end": 51.635477833333304,
    "words": 3,
    "text": "вышел из облака."
  },
  {
    "start": 51.6694778333333,
    "end": 53.506977833333295,
    "words": 3,
    "text": "Остывая, налипший пепел"
  },
  {
    "start": 53.506977833333295,
    "end": 55.3244778333333,
    "words": 3,
    "text": "затвердевал и откалывался."
  },
  {
    "start": 55.338102833333295,
    "end": 56.9881028333333,
    "words": 4,
    "text": "Примерно через пятнадцать минут"
  },
  {
    "start": 56.9881028333333,
    "end": 59.3681028333333,
    "words": 5,
    "text": "без тяги двигатели удалось запустить."
  },
  {
    "start": 59.405540833333305,
    "end": 61.985540833333296,
    "words": 5,
    "text": "Один вскоре снова пришлось отключить."
  },
  {
    "start": 62.20554083333329,
    "end": 64.56766483333328,
    "words": 5,
    "text": "Но испытание ещё не закончилось."
  },
  {
    "start": 64.6373538333333,
    "end": 66.51476983333329,
    "words": 4,
    "text": "Пепел повредил лобовые стёкла,"
  },
  {
    "start": 66.62714483333329,
    "end": 67.63481183333329,
    "words": 3,
    "text": "и пилоты почти"
  },
  {
    "start": 67.63481183333329,
    "end": 68.81068683333328,
    "words": 3,
    "text": "не видели полосу."
  },
  {
    "start": 68.84233283333329,
    "end": 70.09233283333329,
    "words": 4,
    "text": "Они всё же посадили"
  },
  {
    "start": 70.09233283333329,
    "end": 71.53612383333328,
    "words": 3,
    "text": "самолёт в Джакарте."
  },
  {
    "start": 71.57429183333329,
    "end": 73.17220783333327,
    "words": 4,
    "text": "Все на борту выжили."
  },
  {
    "start": 73.17220783333327,
    "end": 74.95791583333327,
    "words": 3,
    "text": "Четыре двигателя остановила"
  },
  {
    "start": 74.95791583333327,
    "end": 76.21222883333328,
    "words": 3,
    "text": "не огромная буря."
  },
  {
    "start": 76.21222883333328,
    "end": 78.41885383333329,
    "words": 4,
    "text": "А крошечные частицы, которых"
  },
  {
    "start": 78.41885383333329,
    "end": 79.83714483333327,
    "words": 4,
    "text": "экипаж даже не видел."
  }
]
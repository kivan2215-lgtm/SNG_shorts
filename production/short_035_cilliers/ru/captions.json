[
  {
    "start": 0.05,
    "end": 2.1425,
    "words": 4,
    "text": "У женщины отказал парашют."
  },
  {
    "start": 2.164354,
    "end": 3.919354,
    "words": 3,
    "text": "Она раскрыла запасной."
  },
  {
    "start": 3.941125,
    "end": 5.6461250000000005,
    "words": 5,
    "text": "Но он тоже не спасал."
  },
  {
    "start": 5.680625000000001,
    "end": 8.298125000000002,
    "words": 5,
    "text": "Под ней больше километра пустоты."
  },
  {
    "start": 8.312375000000001,
    "end": 10.212375,
    "words": 4,
    "text": "Но самое страшное выяснилось"
  },
  {
    "start": 10.212375,
    "end": 11.667375000000002,
    "words": 3,
    "text": "уже после падения."
  },
  {
    "start": 11.887375,
    "end": 12.770374000000002,
    "words": 1,
    "text": "Англия."
  },
  {
    "start": 12.770374000000002,
    "end": 15.227124,
    "words": 5,
    "text": "Апрель две тысячи пятнадцатого года."
  },
  {
    "start": 15.249187000000004,
    "end": 17.681186,
    "words": 3,
    "text": "Виктория опытный инструктор."
  },
  {
    "start": 17.74256100000001,
    "end": 19.54952000000001,
    "words": 4,
    "text": "Прыжок ей организовали вскоре"
  },
  {
    "start": 19.54952000000001,
    "end": 21.152269000000008,
    "words": 3,
    "text": "после рождения ребёнка."
  },
  {
    "start": 21.175165000000007,
    "end": 22.944998000000012,
    "words": 4,
    "text": "Но вместо обычного спуска"
  },
  {
    "start": 22.944998000000012,
    "end": 24.931414000000007,
    "words": 5,
    "text": "она рухнула на вспаханное поле."
  },
  {
    "start": 24.941415000000013,
    "end": 26.34616500000001,
    "words": 2,
    "text": "Тяжелейшие травмы."
  },
  {
    "start": 26.411437000000006,
    "end": 28.113228000000003,
    "words": 5,
    "text": "И всё же она выжила."
  },
  {
    "start": 28.333207833333333,
    "end": 29.42070783333334,
    "words": 3,
    "text": "Сначала это могло"
  },
  {
    "start": 29.42070783333334,
    "end": 31.375707833333333,
    "words": 3,
    "text": "показаться несчастным случаем."
  },
  {
    "start": 31.396249833333336,
    "end": 34.02624983333334,
    "words": 5,
    "text": "Но проверка снаряжения изменила всё."
  },
  {
    "start": 34.07818783333333,
    "end": 36.69568783333333,
    "words": 5,
    "text": "Оба парашюта были намеренно повреждены."
  },
  {
    "start": 36.715145833333324,
    "end": 38.32764583333332,
    "words": 4,
    "text": "А затем полиция узнала"
  },
  {
    "start": 38.32764583333332,
    "end": 39.64514583333332,
    "words": 3,
    "text": "о другой странности."
  },
  {
    "start": 39.67616683333332,
    "end": 40.71366683333332,
    "words": 4,
    "text": "Всего за неделю до"
  },
  {
    "start": 40.71366683333332,
    "end": 42.02616683333332,
    "words": 4,
    "text": "прыжка в доме Виктории"
  },
  {
    "start": 42.02616683333332,
    "end": 43.66866683333332,
    "words": 3,
    "text": "произошла утечка газа."
  },
  {
    "start": 43.67647883333331,
    "end": 46.145332833333306,
    "words": 4,
    "text": "Следствие связало эти события."
  },
  {
    "start": 46.145332833333306,
    "end": 48.175332833333314,
    "words": 5,
    "text": "Кто-то уже пытался её убить."
  },
  {
    "start": 48.395332833333306,
    "end": 50.22033283333331,
    "words": 4,
    "text": "Теперь главный вопрос: кто"
  },
  {
    "start": 50.22033283333331,
    "end": 52.175332833333314,
    "words": 4,
    "text": "мог подобраться настолько близко?"
  },
  {
    "start": 52.214478833333295,
    "end": 55.100561833333295,
    "words": 5,
    "text": "Ответ оказался страшнее самого падения."
  },
  {
    "start": 55.100561833333295,
    "end": 56.7305618333333,
    "words": 3,
    "text": "Её собственный муж."
  },
  {
    "start": 56.79320783333329,
    "end": 58.723207833333305,
    "words": 4,
    "text": "Военный по имени Эмиль."
  },
  {
    "start": 58.77285383333329,
    "end": 61.152853833333296,
    "words": 4,
    "text": "Именно он организовал прыжок."
  },
  {
    "start": 61.19062483333328,
    "end": 63.71799983333329,
    "words": 5,
    "text": "И именно он испортил снаряжение."
  },
  {
    "start": 63.71799983333329,
    "end": 65.43049983333327,
    "words": 4,
    "text": "Как установил суд, муж"
  },
  {
    "start": 65.43049983333327,
    "end": 66.79299983333328,
    "words": 4,
    "text": "хотел начать новую жизнь"
  },
  {
    "start": 66.79299983333328,
    "end": 68.43049983333327,
    "words": 4,
    "text": "с любовницей, а страховкой"
  },
  {
    "start": 68.43049983333327,
    "end": 70.76049983333328,
    "words": 5,
    "text": "после смерти жены погасить долги."
  },
  {
    "start": 70.98049983333328,
    "end": 72.46008283333327,
    "words": 4,
    "text": "В две тысячи восемнадцатом"
  },
  {
    "start": 72.46008283333327,
    "end": 73.72283283333329,
    "words": 3,
    "text": "году его приговорили"
  },
  {
    "start": 73.72283283333329,
    "end": 75.44668783333327,
    "words": 3,
    "text": "к пожизненному заключению."
  },
  {
    "start": 75.44668783333327,
    "end": 77.10485383333327,
    "words": 3,
    "text": "Минимум восемнадцать лет"
  },
  {
    "start": 77.10485383333327,
    "end": 78.89635483333328,
    "words": 3,
    "text": "до возможности освобождения."
  },
  {
    "start": 78.89635483333328,
    "end": 80.37839583333326,
    "words": 2,
    "text": "Виктория выжила."
  },
  {
    "start": 80.40152183333328,
    "end": 81.93214683333326,
    "words": 4,
    "text": "А человек, которому она"
  },
  {
    "start": 81.93214683333326,
    "end": 83.74335483333329,
    "words": 4,
    "text": "доверяла свою жизнь, дважды"
  },
  {
    "start": 83.74335483333329,
    "end": 85.11060483333327,
    "words": 3,
    "text": "пытался её отнять."
  },
  {
    "start": 85.16472983333327,
    "end": 86.92493783333327,
    "words": 4,
    "text": "Что страшнее: упасть с"
  },
  {
    "start": 86.92493783333327,
    "end": 88.35347983333327,
    "words": 4,
    "text": "неба или узнать, кто"
  },
  {
    "start": 88.35347983333327,
    "end": 89.92481283333325,
    "words": 5,
    "text": "отправил тебя в этот полёт?"
  }
]
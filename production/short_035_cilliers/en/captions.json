[
  {
    "start": 0.05,
    "end": 1.505,
    "words": 3,
    "text": "Her parachute failed."
  },
  {
    "start": 1.628417,
    "end": 3.2584169999999997,
    "words": 4,
    "text": "She deployed her reserve."
  },
  {
    "start": 3.4026250000000005,
    "end": 4.570125000000001,
    "words": 3,
    "text": "That failed too."
  },
  {
    "start": 4.745708000000001,
    "end": 5.783208000000001,
    "words": 4,
    "text": "More than a thousand"
  },
  {
    "start": 5.783208000000001,
    "end": 6.9332080000000005,
    "words": 3,
    "text": "meters separated her"
  },
  {
    "start": 6.9332080000000005,
    "end": 7.875708,
    "words": 3,
    "text": "from the ground."
  },
  {
    "start": 8.012915999999999,
    "end": 9.187916,
    "words": 4,
    "text": "But the most disturbing"
  },
  {
    "start": 9.187916,
    "end": 11.142916,
    "words": 5,
    "text": "discovery came after the fall."
  },
  {
    "start": 11.362416,
    "end": 12.197874,
    "words": 1,
    "text": "England."
  },
  {
    "start": 12.338728,
    "end": 13.780603000000001,
    "words": 3,
    "text": "April twenty fifteen."
  },
  {
    "start": 13.971291,
    "end": 14.899499000000002,
    "words": 3,
    "text": "Victoria was an"
  },
  {
    "start": 14.899499000000002,
    "end": 17.059249,
    "words": 3,
    "text": "experienced skydiving instructor."
  },
  {
    "start": 17.187479000000003,
    "end": 17.917687000000004,
    "words": 4,
    "text": "The jump had been"
  },
  {
    "start": 17.917687000000004,
    "end": 19.229562000000005,
    "words": 4,
    "text": "arranged shortly after the"
  },
  {
    "start": 19.229562000000005,
    "end": 20.337270000000004,
    "words": 4,
    "text": "birth of her child."
  },
  {
    "start": 20.481374000000006,
    "end": 21.421958000000007,
    "words": 4,
    "text": "Instead of a normal"
  },
  {
    "start": 21.421958000000007,
    "end": 22.84520800000001,
    "words": 4,
    "text": "descent, she crashed into"
  },
  {
    "start": 22.84520800000001,
    "end": 23.829165000000007,
    "words": 3,
    "text": "a ploughed field."
  },
  {
    "start": 23.96204100000001,
    "end": 25.83712400000001,
    "words": 4,
    "text": "Her injuries were devastating."
  },
  {
    "start": 26.025937000000013,
    "end": 27.207937000000012,
    "words": 3,
    "text": "But she survived."
  },
  {
    "start": 27.427916500000002,
    "end": 28.602916500000006,
    "words": 4,
    "text": "At first, it could"
  },
  {
    "start": 28.602916500000006,
    "end": 29.9954165,
    "words": 5,
    "text": "have looked like an accident."
  },
  {
    "start": 30.132833499999997,
    "end": 32.7753335,
    "words": 5,
    "text": "Then investigators examined the equipment."
  },
  {
    "start": 32.92414649999999,
    "end": 34.01164649999999,
    "words": 3,
    "text": "Both parachutes had"
  },
  {
    "start": 34.01164649999999,
    "end": 35.82914649999999,
    "words": 3,
    "text": "been deliberately sabotaged."
  },
  {
    "start": 36.00679249999999,
    "end": 37.28179249999999,
    "words": 3,
    "text": "Police also uncovered"
  },
  {
    "start": 37.28179249999999,
    "end": 38.84929249999999,
    "words": 3,
    "text": "another disturbing event."
  },
  {
    "start": 39.008479499999986,
    "end": 39.92097949999999,
    "words": 4,
    "text": "Just a week before"
  },
  {
    "start": 39.92097949999999,
    "end": 40.92097949999999,
    "words": 4,
    "text": "the jump, there had"
  },
  {
    "start": 40.92097949999999,
    "end": 41.758479499999986,
    "words": 4,
    "text": "been a gas leak"
  },
  {
    "start": 41.758479499999986,
    "end": 42.963479499999984,
    "words": 3,
    "text": "at Victoria's home."
  },
  {
    "start": 43.14456249999998,
    "end": 45.674562499999986,
    "words": 5,
    "text": "Investigators connected the two incidents."
  },
  {
    "start": 45.806020499999974,
    "end": 47.19352049999998,
    "words": 4,
    "text": "Someone had already tried"
  },
  {
    "start": 47.19352049999998,
    "end": 47.97352049999998,
    "words": 3,
    "text": "to kill her."
  },
  {
    "start": 48.19352049999996,
    "end": 48.768520499999966,
    "words": 3,
    "text": "But who could"
  },
  {
    "start": 48.768520499999966,
    "end": 49.84852049999997,
    "words": 3,
    "text": "get that close?"
  },
  {
    "start": 50.00012449999996,
    "end": 50.912624499999964,
    "words": 4,
    "text": "The answer was more"
  },
  {
    "start": 50.912624499999964,
    "end": 52.45512449999997,
    "words": 4,
    "text": "terrifying than the fall."
  },
  {
    "start": 52.55785349999996,
    "end": 53.78785349999996,
    "words": 3,
    "text": "Her own husband."
  },
  {
    "start": 53.94756149999995,
    "end": 55.45256149999995,
    "words": 4,
    "text": "A soldier named Emile."
  },
  {
    "start": 55.56470749999994,
    "end": 57.082207499999946,
    "words": 5,
    "text": "He had arranged the jump."
  },
  {
    "start": 57.20527049999994,
    "end": 57.75527049999994,
    "words": 3,
    "text": "And he had"
  },
  {
    "start": 57.75527049999994,
    "end": 59.39777049999994,
    "words": 3,
    "text": "sabotaged the equipment."
  },
  {
    "start": 59.52768749999994,
    "end": 60.31518749999995,
    "words": 4,
    "text": "The court found that"
  },
  {
    "start": 60.31518749999995,
    "end": 60.977687499999945,
    "words": 4,
    "text": "he wanted a new"
  },
  {
    "start": 60.977687499999945,
    "end": 61.907687499999945,
    "words": 4,
    "text": "life with a lover,"
  },
  {
    "start": 62.01518749999995,
    "end": 63.12768749999994,
    "words": 4,
    "text": "and an insurance payout"
  },
  {
    "start": 63.12768749999994,
    "end": 64.14018749999995,
    "words": 4,
    "text": "after his wife's death"
  },
  {
    "start": 64.14018749999995,
    "end": 65.22018749999994,
    "words": 4,
    "text": "to clear his debts."
  },
  {
    "start": 65.44118749999994,
    "end": 66.72947849999994,
    "words": 4,
    "text": "In twenty eighteen, he"
  },
  {
    "start": 66.72947849999994,
    "end": 67.46927049999994,
    "words": 3,
    "text": "was sentenced to"
  },
  {
    "start": 67.46927049999994,
    "end": 68.47935349999993,
    "words": 3,
    "text": "life in prison."
  },
  {
    "start": 68.63412449999993,
    "end": 69.82033349999993,
    "words": 4,
    "text": "At least eighteen years"
  },
  {
    "start": 69.82033349999993,
    "end": 70.61116649999992,
    "words": 4,
    "text": "before he could be"
  },
  {
    "start": 70.61116649999992,
    "end": 71.99116649999992,
    "words": 3,
    "text": "considered for release."
  },
  {
    "start": 72.13181249999992,
    "end": 73.60106249999993,
    "words": 2,
    "text": "Victoria survived."
  },
  {
    "start": 73.72966649999992,
    "end": 74.73733349999992,
    "words": 4,
    "text": "The man she trusted"
  },
  {
    "start": 74.73733349999992,
    "end": 75.48987449999993,
    "words": 4,
    "text": "with her life had"
  },
  {
    "start": 75.48987449999993,
    "end": 76.81887449999992,
    "words": 5,
    "text": "tried to take it twice."
  },
  {
    "start": 76.95391649999992,
    "end": 78.19362449999991,
    "words": 4,
    "text": "Which is more frightening:"
  },
  {
    "start": 78.24216649999993,
    "end": 79.35429149999992,
    "words": 4,
    "text": "falling from the sky,"
  },
  {
    "start": 79.46666649999992,
    "end": 80.53808249999992,
    "words": 4,
    "text": "or discovering who sent"
  },
  {
    "start": 80.53808249999992,
    "end": 81.65020749999992,
    "words": 4,
    "text": "you into that fall?"
  }
]
[
  {
    "start": 0.05,
    "end": 1.0875,
    "words": 4,
    "text": "A flight attendant was"
  },
  {
    "start": 1.0875,
    "end": 2.0125,
    "words": 3,
    "text": "holding the captain"
  },
  {
    "start": 2.0125,
    "end": 2.9675,
    "words": 3,
    "text": "by his legs."
  },
  {
    "start": 3.1225829999999997,
    "end": 3.8475829999999998,
    "words": 4,
    "text": "The rest of his"
  },
  {
    "start": 3.8475829999999998,
    "end": 5.702583,
    "words": 5,
    "text": "body was outside the aircraft."
  },
  {
    "start": 5.846916,
    "end": 7.371916000000001,
    "words": 4,
    "text": "More than seventeen thousand"
  },
  {
    "start": 7.371916000000001,
    "end": 8.339416000000002,
    "words": 4,
    "text": "feet in the air."
  },
  {
    "start": 8.468458,
    "end": 9.318458,
    "words": 4,
    "text": "They could not pull"
  },
  {
    "start": 9.318458,
    "end": 10.423458000000002,
    "words": 3,
    "text": "him back inside."
  },
  {
    "start": 10.599354,
    "end": 11.386854,
    "words": 4,
    "text": "But the crew would"
  },
  {
    "start": 11.386854,
    "end": 12.279354,
    "words": 3,
    "text": "not let go."
  },
  {
    "start": 12.498854,
    "end": 13.334312,
    "words": 1,
    "text": "England."
  },
  {
    "start": 13.479728,
    "end": 15.404269000000003,
    "words": 4,
    "text": "June tenth, nineteen ninety."
  },
  {
    "start": 15.531978000000004,
    "end": 16.150812000000005,
    "words": 3,
    "text": "The plane was"
  },
  {
    "start": 16.150812000000005,
    "end": 17.171894000000005,
    "words": 3,
    "text": "flying to Spain."
  },
  {
    "start": 17.358416000000005,
    "end": 18.954958000000005,
    "words": 4,
    "text": "Suddenly, the left cockpit"
  },
  {
    "start": 18.954958000000005,
    "end": 20.211207000000005,
    "words": 3,
    "text": "windscreen blew out."
  },
  {
    "start": 20.372208000000008,
    "end": 21.857333000000004,
    "words": 4,
    "text": "Captain Tim Lancaster was"
  },
  {
    "start": 21.857333000000004,
    "end": 23.150708000000005,
    "words": 4,
    "text": "forced through the opening."
  },
  {
    "start": 23.34858400000001,
    "end": 24.963750000000008,
    "words": 5,
    "text": "A flight attendant grabbed him."
  },
  {
    "start": 25.12039700000001,
    "end": 26.772646000000012,
    "words": 5,
    "text": "His colleagues came to help."
  },
  {
    "start": 26.992626166666675,
    "end": 28.48012616666668,
    "words": 4,
    "text": "The copilot descended and"
  },
  {
    "start": 28.48012616666668,
    "end": 29.760126166666677,
    "words": 4,
    "text": "searched for an airport."
  },
  {
    "start": 29.90485516666667,
    "end": 31.65985516666667,
    "words": 5,
    "text": "Wind drowned out the radio."
  },
  {
    "start": 31.811042166666667,
    "end": 32.98604216666667,
    "words": 3,
    "text": "The rescuers hands"
  },
  {
    "start": 32.98604216666667,
    "end": 33.99104216666667,
    "words": 3,
    "text": "were going numb."
  },
  {
    "start": 34.16302116666667,
    "end": 35.05052116666666,
    "words": 4,
    "text": "The crew feared that"
  },
  {
    "start": 35.05052116666666,
    "end": 36.76802116666667,
    "words": 5,
    "text": "the captain would not survive."
  },
  {
    "start": 36.93520816666666,
    "end": 38.42770816666667,
    "words": 5,
    "text": "But they kept holding on."
  },
  {
    "start": 38.601958166666655,
    "end": 39.88945816666666,
    "words": 4,
    "text": "During the descent, the"
  },
  {
    "start": 39.88945816666666,
    "end": 41.36945816666666,
    "words": 4,
    "text": "captain kicked his legs."
  },
  {
    "start": 41.68610416666666,
    "end": 42.76610416666666,
    "words": 3,
    "text": "He was alive."
  },
  {
    "start": 42.89093716666665,
    "end": 43.91593716666665,
    "words": 4,
    "text": "They held him outside"
  },
  {
    "start": 43.91593716666665,
    "end": 45.30843716666665,
    "words": 4,
    "text": "for around twenty minutes."
  },
  {
    "start": 45.43066616666665,
    "end": 46.885666166666645,
    "words": 4,
    "text": "Then the plane landed."
  },
  {
    "start": 47.019583166666635,
    "end": 48.35708316666664,
    "words": 3,
    "text": "All eighty-seven people"
  },
  {
    "start": 48.35708316666664,
    "end": 49.52458316666664,
    "words": 3,
    "text": "on board survived."
  },
  {
    "start": 49.74458316666663,
    "end": 50.49458316666663,
    "words": 4,
    "text": "But why had the"
  },
  {
    "start": 50.49458316666663,
    "end": 51.66208316666663,
    "words": 3,
    "text": "window blown out?"
  },
  {
    "start": 51.80875016666663,
    "end": 53.121250166666634,
    "words": 3,
    "text": "Investigators found a"
  },
  {
    "start": 53.121250166666634,
    "end": 54.93875016666664,
    "words": 3,
    "text": "dangerous installation error."
  },
  {
    "start": 55.049208166666624,
    "end": 55.861708166666624,
    "words": 3,
    "text": "The window had"
  },
  {
    "start": 55.861708166666624,
    "end": 57.35420816666664,
    "words": 3,
    "text": "recently been replaced."
  },
  {
    "start": 57.492708166666624,
    "end": 58.73020816666662,
    "words": 4,
    "text": "Of its ninety securing"
  },
  {
    "start": 58.73020816666662,
    "end": 60.77270816666662,
    "words": 5,
    "text": "bolts, eighty-four were too narrow."
  },
  {
    "start": 60.93677016666661,
    "end": 63.47927016666662,
    "words": 4,
    "text": "By just 0.66 millimeters."
  },
  {
    "start": 63.62737416666662,
    "end": 64.4023741666666,
    "words": 3,
    "text": "The other six"
  },
  {
    "start": 64.4023741666666,
    "end": 65.3948741666666,
    "words": 3,
    "text": "were too short."
  },
  {
    "start": 65.5200821666666,
    "end": 66.9575821666666,
    "words": 4,
    "text": "Pressure inside the cockpit"
  },
  {
    "start": 66.9575821666666,
    "end": 67.9075821666666,
    "words": 4,
    "text": "pushed the window and"
  },
  {
    "start": 67.9075821666666,
    "end": 69.02508216666659,
    "words": 3,
    "text": "its fasteners out."
  },
  {
    "start": 69.2460821666666,
    "end": 70.75120716666659,
    "words": 4,
    "text": "The report identified both"
  },
  {
    "start": 70.75120716666659,
    "end": 71.8609151666666,
    "words": 3,
    "text": "maintenance errors and"
  },
  {
    "start": 71.8609151666666,
    "end": 73.27916516666659,
    "words": 3,
    "text": "failures of oversight."
  },
  {
    "start": 73.4494781666666,
    "end": 74.62293616666659,
    "words": 4,
    "text": "A tiny mismatch had"
  },
  {
    "start": 74.62293616666659,
    "end": 76.3728111666666,
    "words": 4,
    "text": "endangered dozens of lives."
  },
  {
    "start": 76.52085316666658,
    "end": 78.34726916666658,
    "words": 5,
    "text": "Was this one mechanic's fault?"
  },
  {
    "start": 78.50068716666658,
    "end": 79.36802016666658,
    "words": 4,
    "text": "Or a system that"
  },
  {
    "start": 79.36802016666658,
    "end": 80.26089516666659,
    "words": 3,
    "text": "allowed the mistake"
  },
  {
    "start": 80.26089516666659,
    "end": 81.39852016666657,
    "words": 3,
    "text": "to go unnoticed?"
  }
]
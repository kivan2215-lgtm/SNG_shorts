[
  {
    "start": 0.05,
    "end": 2.6799999999999997,
    "words": 5,
    "text": "Бортпроводник держал командира за ноги."
  },
  {
    "start": 2.6826459999999996,
    "end": 4.132645999999999,
    "words": 4,
    "text": "Остальная часть его тела"
  },
  {
    "start": 4.132645999999999,
    "end": 6.012645999999999,
    "words": 3,
    "text": "находилась снаружи самолёта."
  },
  {
    "start": 6.049563,
    "end": 8.317063,
    "words": 5,
    "text": "На высоте больше пяти километров."
  },
  {
    "start": 8.36673,
    "end": 10.746730000000001,
    "words": 5,
    "text": "Втащить его обратно не получалось."
  },
  {
    "start": 10.809937999999999,
    "end": 12.514937999999999,
    "words": 4,
    "text": "Но экипаж не отпускал."
  },
  {
    "start": 12.734938,
    "end": 13.623979000000002,
    "words": 1,
    "text": "Англия."
  },
  {
    "start": 13.623979000000002,
    "end": 15.393771000000001,
    "words": 3,
    "text": "Десятое июня тысяча"
  },
  {
    "start": 15.393771000000001,
    "end": 16.897562,
    "words": 3,
    "text": "девятьсот девяностого года."
  },
  {
    "start": 16.915083000000003,
    "end": 18.791396000000006,
    "words": 4,
    "text": "Самолёт летел в Испанию."
  },
  {
    "start": 18.791396000000006,
    "end": 20.041396000000006,
    "words": 3,
    "text": "Вдруг левое стекло"
  },
  {
    "start": 20.041396000000006,
    "end": 21.619395000000008,
    "words": 3,
    "text": "кабины вырвало наружу."
  },
  {
    "start": 21.636313000000012,
    "end": 23.195730000000008,
    "words": 3,
    "text": "Командира Тима Ланкастера"
  },
  {
    "start": 23.195730000000008,
    "end": 24.72422900000001,
    "words": 3,
    "text": "выбросило через проём."
  },
  {
    "start": 24.74902100000001,
    "end": 27.094395000000006,
    "words": 4,
    "text": "Бортпроводник успел схватить его."
  },
  {
    "start": 27.122354000000005,
    "end": 28.960229000000005,
    "words": 4,
    "text": "На помощь пришли коллеги."
  },
  {
    "start": 29.180208833333335,
    "end": 31.04270883333334,
    "words": 4,
    "text": "Второй пилот снижал самолёт"
  },
  {
    "start": 31.04270883333334,
    "end": 32.435208833333334,
    "words": 3,
    "text": "и искал аэродром."
  },
  {
    "start": 32.46293783333333,
    "end": 34.35941683333333,
    "words": 3,
    "text": "Ветер заглушал радио."
  },
  {
    "start": 34.35941683333333,
    "end": 36.28081283333333,
    "words": 3,
    "text": "Руки спасателей немели."
  },
  {
    "start": 36.28081283333333,
    "end": 38.03581283333333,
    "words": 4,
    "text": "Экипаж почти не надеялся,"
  },
  {
    "start": 38.143312833333326,
    "end": 39.56081283333332,
    "words": 3,
    "text": "что командир выживет."
  },
  {
    "start": 39.58858383333332,
    "end": 41.28108383333332,
    "words": 3,
    "text": "Но продолжали держать."
  },
  {
    "start": 41.301979833333306,
    "end": 42.28947983333332,
    "words": 3,
    "text": "И при снижении"
  },
  {
    "start": 42.28947983333332,
    "end": 44.144479833333314,
    "words": 3,
    "text": "командир пошевелил ногами."
  },
  {
    "start": 44.33456283333331,
    "end": 45.489562833333316,
    "words": 3,
    "text": "Он был жив."
  },
  {
    "start": 45.5281668333333,
    "end": 46.853166833333304,
    "words": 3,
    "text": "Около двадцати минут"
  },
  {
    "start": 46.853166833333304,
    "end": 48.55816683333331,
    "words": 3,
    "text": "его удерживали снаружи."
  },
  {
    "start": 48.566854833333295,
    "end": 49.78435483333329,
    "words": 2,
    "text": "Самолёт сел."
  },
  {
    "start": 49.81110483333329,
    "end": 51.47360483333328,
    "words": 4,
    "text": "Все восемьдесят семь человек"
  },
  {
    "start": 51.47360483333328,
    "end": 52.666104833333286,
    "words": 3,
    "text": "на борту спаслись."
  },
  {
    "start": 52.88610483333328,
    "end": 54.82860483333328,
    "words": 4,
    "text": "Но почему вылетело стекло?"
  },
  {
    "start": 54.874000833333284,
    "end": 56.936500833333284,
    "words": 3,
    "text": "Следователи обнаружили опасную"
  },
  {
    "start": 56.936500833333284,
    "end": 58.35400083333328,
    "words": 3,
    "text": "ошибку при установке."
  },
  {
    "start": 58.387167833333265,
    "end": 60.12468883333325,
    "words": 3,
    "text": "Окно недавно заменили."
  },
  {
    "start": 60.12468883333325,
    "end": 61.887188833333255,
    "words": 4,
    "text": "Из девяноста крепёжных болтов"
  },
  {
    "start": 61.887188833333255,
    "end": 64.30564683333326,
    "words": 5,
    "text": "восемьдесят четыре были тоньше нужного."
  },
  {
    "start": 64.30564683333326,
    "end": 67.04720983333326,
    "words": 4,
    "text": "Всего на 0,66 миллиметра."
  },
  {
    "start": 67.04720983333326,
    "end": 69.52720983333325,
    "words": 4,
    "text": "Остальные шесть слишком короткими."
  },
  {
    "start": 69.56773083333324,
    "end": 71.63023083333324,
    "words": 4,
    "text": "Давление внутри кабины вытолкнуло"
  },
  {
    "start": 71.63023083333324,
    "end": 73.36023083333325,
    "words": 4,
    "text": "стекло вместе с креплением."
  },
  {
    "start": 73.58023083333325,
    "end": 74.80473083333325,
    "words": 4,
    "text": "В отчёте указали не"
  },
  {
    "start": 74.80473083333325,
    "end": 75.78685583333325,
    "words": 4,
    "text": "только на ошибку при"
  },
  {
    "start": 75.78685583333325,
    "end": 76.92206383333325,
    "words": 3,
    "text": "ремонте, но и"
  },
  {
    "start": 76.92206383333325,
    "end": 78.39554283333324,
    "words": 3,
    "text": "на недостатки контроля."
  },
  {
    "start": 78.39554283333324,
    "end": 80.51287583333324,
    "words": 4,
    "text": "Неверно подобранный крепёж поставил"
  },
  {
    "start": 80.51287583333324,
    "end": 82.28239683333324,
    "words": 4,
    "text": "под угрозу десятки жизней."
  },
  {
    "start": 82.28239683333324,
    "end": 84.33839583333324,
    "words": 4,
    "text": "Это вина одного механика?"
  },
  {
    "start": 84.38120883333323,
    "end": 86.44754183333323,
    "words": 4,
    "text": "Или системы, которая позволила"
  },
  {
    "start": 86.44754183333323,
    "end": 88.41429183333324,
    "words": 3,
    "text": "ошибке остаться незамеченной?"
  }
]
[
  {
    "start": 0.05,
    "end": 0.775,
    "words": 4,
    "text": "The captain of a"
  },
  {
    "start": 0.775,
    "end": 2.5549999999999997,
    "words": 5,
    "text": "sunken yacht was found alive."
  },
  {
    "start": 2.684813,
    "end": 3.597313,
    "words": 4,
    "text": "He said a terrible"
  },
  {
    "start": 3.597313,
    "end": 5.464813,
    "words": 5,
    "text": "storm had killed his passengers."
  },
  {
    "start": 5.612792000000001,
    "end": 6.675292000000001,
    "words": 4,
    "text": "But days later, a"
  },
  {
    "start": 6.675292000000001,
    "end": 7.775292000000002,
    "words": 4,
    "text": "discovery at sea would"
  },
  {
    "start": 7.775292000000002,
    "end": 8.955292000000002,
    "words": 3,
    "text": "destroy his story."
  },
  {
    "start": 9.174292000000001,
    "end": 11.363124000000003,
    "words": 4,
    "text": "The Bahamas, nineteen sixty-one."
  },
  {
    "start": 11.545271000000001,
    "end": 12.452146,
    "words": 4,
    "text": "A family with three"
  },
  {
    "start": 12.452146,
    "end": 13.383521,
    "words": 3,
    "text": "children is sailing"
  },
  {
    "start": 13.383521,
    "end": 14.506146000000001,
    "words": 3,
    "text": "aboard the Bluebelle."
  },
  {
    "start": 14.607646000000004,
    "end": 16.453354,
    "words": 5,
    "text": "One night, the yacht sinks."
  },
  {
    "start": 16.593146000000004,
    "end": 17.855396000000006,
    "words": 4,
    "text": "The next day, Captain"
  },
  {
    "start": 17.855396000000006,
    "end": 19.504979000000002,
    "words": 4,
    "text": "Julian Harvey is rescued."
  },
  {
    "start": 19.638562000000007,
    "end": 20.545396000000007,
    "words": 4,
    "text": "He claims the mast"
  },
  {
    "start": 20.545396000000007,
    "end": 21.925396000000006,
    "words": 4,
    "text": "broke, a fire started,"
  },
  {
    "start": 21.979229000000007,
    "end": 23.43277000000001,
    "words": 5,
    "text": "and everyone else was lost."
  },
  {
    "start": 23.652250166666676,
    "end": 25.094124166666678,
    "words": 4,
    "text": "But on November sixteenth,"
  },
  {
    "start": 25.17454116666668,
    "end": 26.888707166666677,
    "words": 5,
    "text": "sailors spot a tiny float."
  },
  {
    "start": 27.045041166666685,
    "end": 27.56483316666668,
    "words": 3,
    "text": "On it is"
  },
  {
    "start": 27.56483316666668,
    "end": 29.204749166666684,
    "words": 3,
    "text": "eleven-year-old Terry Jo."
  },
  {
    "start": 29.39910416666668,
    "end": 30.67385416666668,
    "words": 4,
    "text": "Nearly four days without"
  },
  {
    "start": 30.67385416666668,
    "end": 31.96718716666668,
    "words": 4,
    "text": "food or fresh water!"
  },
  {
    "start": 32.09491616666668,
    "end": 33.09737516666667,
    "words": 4,
    "text": "When the captain learns"
  },
  {
    "start": 33.09737516666667,
    "end": 34.13695816666667,
    "words": 4,
    "text": "she is alive, he"
  },
  {
    "start": 34.13695816666667,
    "end": 35.36845716666668,
    "words": 3,
    "text": "leaves his questioning."
  },
  {
    "start": 35.558270166666674,
    "end": 37.23531116666667,
    "words": 5,
    "text": "He returns to a motel."
  },
  {
    "start": 37.376458166666666,
    "end": 38.490333166666666,
    "words": 3,
    "text": "Soon afterward, he"
  },
  {
    "start": 38.490333166666666,
    "end": 39.75895816666667,
    "words": 3,
    "text": "dies by suicide."
  },
  {
    "start": 39.91662516666667,
    "end": 41.018125166666664,
    "words": 4,
    "text": "Before Terry is well"
  },
  {
    "start": 41.018125166666664,
    "end": 42.453792166666666,
    "words": 4,
    "text": "enough to tell investigators"
  },
  {
    "start": 42.453792166666666,
    "end": 43.43774916666666,
    "words": 3,
    "text": "her full story."
  },
  {
    "start": 43.65927056666666,
    "end": 45.54185366666667,
    "words": 5,
    "text": "And her account changes everything."
  },
  {
    "start": 45.728458666666654,
    "end": 46.35987566666665,
    "words": 3,
    "text": "The sea that"
  },
  {
    "start": 46.35987566666665,
    "end": 47.41774966666666,
    "words": 3,
    "text": "night was calm."
  },
  {
    "start": 47.56587466666665,
    "end": 48.86854166666665,
    "words": 4,
    "text": "There was no fire."
  },
  {
    "start": 48.98175066666664,
    "end": 50.284458666666644,
    "words": 3,
    "text": "Screams woke her."
  },
  {
    "start": 50.452208666666635,
    "end": 51.75487566666664,
    "words": 4,
    "text": "Upstairs in the cabin,"
  },
  {
    "start": 51.86970866666664,
    "end": 52.784667666666635,
    "words": 4,
    "text": "she found her mother"
  },
  {
    "start": 52.784667666666635,
    "end": 54.06158366666664,
    "words": 4,
    "text": "and brother lying dead."
  },
  {
    "start": 54.23093866666663,
    "end": 55.37785566666663,
    "words": 4,
    "text": "When Terry approached the"
  },
  {
    "start": 55.37785566666663,
    "end": 57.22177166666663,
    "words": 5,
    "text": "captain, he shoved her away."
  },
  {
    "start": 57.35727266666663,
    "end": 58.93056366666662,
    "words": 5,
    "text": "The yacht began to sink."
  },
  {
    "start": 59.07583466666662,
    "end": 60.18408466666662,
    "words": 4,
    "text": "She managed to release"
  },
  {
    "start": 60.18408466666662,
    "end": 61.40945966666661,
    "words": 4,
    "text": "a small life float."
  },
  {
    "start": 61.63043916666662,
    "end": 63.49268916666662,
    "words": 4,
    "text": "Investigators concluded this was"
  },
  {
    "start": 63.49268916666662,
    "end": 64.52585516666662,
    "words": 3,
    "text": "a crime disguised"
  },
  {
    "start": 64.52585516666662,
    "end": 65.43393916666662,
    "words": 3,
    "text": "as a shipwreck."
  },
  {
    "start": 65.57550116666661,
    "end": 66.55766816666662,
    "words": 4,
    "text": "Harvey had killed the"
  },
  {
    "start": 66.55766816666662,
    "end": 68.30758416666662,
    "words": 5,
    "text": "passengers and sunk the yacht."
  },
  {
    "start": 68.46425116666661,
    "end": 69.2550841666666,
    "words": 4,
    "text": "But there was one"
  },
  {
    "start": 69.2550841666666,
    "end": 69.82904216666661,
    "words": 3,
    "text": "thing he had"
  },
  {
    "start": 69.82904216666661,
    "end": 70.90295816666661,
    "words": 3,
    "text": "not planned for."
  },
  {
    "start": 71.01987516666661,
    "end": 72.1295421666666,
    "words": 4,
    "text": "The girl left alone"
  },
  {
    "start": 72.1295421666666,
    "end": 73.4967921666666,
    "words": 4,
    "text": "in the ocean survived."
  },
  {
    "start": 73.6511881666666,
    "end": 75.15872916666659,
    "words": 4,
    "text": "And exposed his lies."
  }
]
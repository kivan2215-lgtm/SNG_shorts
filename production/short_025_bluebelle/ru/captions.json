[
  {
    "start": 0.05,
    "end": 2.58,
    "words": 5,
    "text": "Капитана затонувшей яхты нашли живым."
  },
  {
    "start": 2.606708,
    "end": 4.069208,
    "words": 3,
    "text": "Он уверял: страшный"
  },
  {
    "start": 4.069208,
    "end": 5.736707999999999,
    "words": 3,
    "text": "шторм погубил пассажиров."
  },
  {
    "start": 5.794646,
    "end": 7.032146000000001,
    "words": 4,
    "text": "Но через несколько дней"
  },
  {
    "start": 7.032146000000001,
    "end": 7.982146,
    "words": 3,
    "text": "находка в океане"
  },
  {
    "start": 7.982146,
    "end": 9.587146,
    "words": 3,
    "text": "разрушила его историю."
  },
  {
    "start": 9.807146000000001,
    "end": 11.571854,
    "words": 3,
    "text": "Багамы, тысяча девятьсот"
  },
  {
    "start": 11.571854,
    "end": 12.939603000000002,
    "words": 3,
    "text": "шестьдесят первый год."
  },
  {
    "start": 12.954166,
    "end": 14.253166,
    "words": 4,
    "text": "Семья с тремя детьми"
  },
  {
    "start": 14.253166,
    "end": 16.037541,
    "words": 3,
    "text": "путешествует на «Блюбелл»."
  },
  {
    "start": 16.078750000000003,
    "end": 17.752874000000002,
    "words": 3,
    "text": "Ночью яхта тонет."
  },
  {
    "start": 17.788333000000005,
    "end": 19.258916000000006,
    "words": 4,
    "text": "На следующий день спасают"
  },
  {
    "start": 19.258916000000006,
    "end": 20.883999000000003,
    "words": 3,
    "text": "капитана Джулиана Харви."
  },
  {
    "start": 20.95437400000001,
    "end": 22.46170800000001,
    "words": 4,
    "text": "По его словам, сломалась"
  },
  {
    "start": 22.46170800000001,
    "end": 24.331916000000007,
    "words": 3,
    "text": "мачта, начался пожар."
  },
  {
    "start": 24.35970700000001,
    "end": 25.82549900000001,
    "words": 2,
    "text": "Остальные погибли."
  },
  {
    "start": 26.045478500000012,
    "end": 27.765769500000008,
    "words": 4,
    "text": "Но шестнадцатого ноября моряки"
  },
  {
    "start": 27.765769500000008,
    "end": 29.41806050000001,
    "words": 3,
    "text": "замечают крошечный плот."
  },
  {
    "start": 29.461707500000006,
    "end": 32.141207500000014,
    "words": 5,
    "text": "На нём одиннадцатилетняя Терри Джо."
  },
  {
    "start": 32.19541650000001,
    "end": 33.58158250000001,
    "words": 4,
    "text": "Почти четыре дня без"
  },
  {
    "start": 33.58158250000001,
    "end": 35.159582500000006,
    "words": 4,
    "text": "еды и пресной воды!"
  },
  {
    "start": 35.1792495,
    "end": 36.788165500000005,
    "words": 4,
    "text": "Когда капитан узнал, что"
  },
  {
    "start": 36.788165500000005,
    "end": 39.3686655,
    "words": 5,
    "text": "девочка спасена, он прервал допрос."
  },
  {
    "start": 39.4376245,
    "end": 41.139415500000005,
    "words": 3,
    "text": "Вернулся в гостиницу."
  },
  {
    "start": 41.389103500000004,
    "end": 43.2517695,
    "words": 5,
    "text": "И вскоре покончил с собой."
  },
  {
    "start": 43.267957499999994,
    "end": 44.703582499999996,
    "words": 4,
    "text": "Ещё до того, как"
  },
  {
    "start": 44.703582499999996,
    "end": 46.0278735,
    "words": 3,
    "text": "Терри смогла подробно"
  },
  {
    "start": 46.0278735,
    "end": 47.6429985,
    "words": 3,
    "text": "рассказать о случившемся."
  },
  {
    "start": 47.86297833333332,
    "end": 48.80368633333332,
    "words": 3,
    "text": "А её рассказ"
  },
  {
    "start": 48.80368633333332,
    "end": 50.51876933333333,
    "words": 3,
    "text": "полностью меняет картину."
  },
  {
    "start": 50.565936333333326,
    "end": 52.82218633333333,
    "words": 5,
    "text": "Море той ночью было спокойным."
  },
  {
    "start": 52.86818633333331,
    "end": 54.38989433333331,
    "words": 2,
    "text": "Никакого пожара."
  },
  {
    "start": 54.432291333333296,
    "end": 56.6369993333333,
    "words": 4,
    "text": "Девочка проснулась от криков."
  },
  {
    "start": 56.68777033333329,
    "end": 58.29860333333329,
    "words": 4,
    "text": "Поднялась в каюту там"
  },
  {
    "start": 58.29860333333329,
    "end": 59.910562333333296,
    "words": 5,
    "text": "лежали её мать и брат."
  },
  {
    "start": 59.94420833333329,
    "end": 61.22000033333329,
    "words": 4,
    "text": "Когда Терри подошла к"
  },
  {
    "start": 61.22000033333329,
    "end": 64.04329133333329,
    "words": 5,
    "text": "капитану, тот грубо оттолкнул её."
  },
  {
    "start": 64.04893733333328,
    "end": 65.77685433333328,
    "words": 3,
    "text": "Яхта начала тонуть."
  },
  {
    "start": 65.82116633333328,
    "end": 67.41908333333328,
    "words": 3,
    "text": "Девочка успела отвязать"
  },
  {
    "start": 67.41908333333328,
    "end": 69.19858333333327,
    "words": 3,
    "text": "маленький спасательный плот."
  },
  {
    "start": 69.41856283333327,
    "end": 71.11743683333327,
    "words": 4,
    "text": "Следователи пришли к выводу:"
  },
  {
    "start": 71.25531283333328,
    "end": 72.63526983333327,
    "words": 3,
    "text": "это было преступление,"
  },
  {
    "start": 72.76039583333328,
    "end": 74.61727083333327,
    "words": 3,
    "text": "замаскированное под крушение."
  },
  {
    "start": 74.61727083333327,
    "end": 76.30093683333327,
    "words": 4,
    "text": "Харви расправился с людьми"
  },
  {
    "start": 76.30093683333327,
    "end": 77.65543683333325,
    "words": 3,
    "text": "и затопил яхту."
  },
  {
    "start": 77.70466583333327,
    "end": 79.78620783333326,
    "words": 5,
    "text": "Но одного он не предусмотрел."
  },
  {
    "start": 79.81058283333326,
    "end": 83.48654183333326,
    "words": 5,
    "text": "Девочка, оставшаяся посреди океана, выжила."
  },
  {
    "start": 83.51789583333326,
    "end": 85.34431183333326,
    "words": 5,
    "text": "И разрушила всю его ложь."
  }
]
[
  {
    "start": 0.05,
    "end": 1.349,
    "words": 3,
    "text": "НАСА отправило аппарат"
  },
  {
    "start": 1.349,
    "end": 2.427458,
    "words": 4,
    "text": "к Марсу и потеряло"
  },
  {
    "start": 2.427458,
    "end": 4.096999,
    "words": 4,
    "text": "его из-за единиц измерения."
  },
  {
    "start": 4.096999,
    "end": 5.653812000000001,
    "words": 4,
    "text": "Не пришельцы, не чёрная"
  },
  {
    "start": 5.653812000000001,
    "end": 6.605041000000001,
    "words": 3,
    "text": "дыра, а ёбаная"
  },
  {
    "start": 6.605041000000001,
    "end": 7.756208,
    "words": 3,
    "text": "путаница в числах."
  },
  {
    "start": 7.756208,
    "end": 9.088645,
    "words": 4,
    "text": "Долететь до другой планеты"
  },
  {
    "start": 9.088645,
    "end": 11.167187,
    "words": 4,
    "text": "смогли, договориться о единицах"
  },
  {
    "start": 11.22102,
    "end": 12.858,
    "words": 4,
    "text": "уже слишком сложный квест."
  },
  {
    "start": 12.858,
    "end": 14.200019833333332,
    "words": 4,
    "text": "В декабре тысяча девятьсот"
  },
  {
    "start": 14.200019833333332,
    "end": 15.768644833333333,
    "words": 4,
    "text": "девяносто восьмого года аппарат"
  },
  {
    "start": 15.768644833333333,
    "end": 17.945020999999997,
    "words": 4,
    "text": "запустили изучать марсианский климат."
  },
  {
    "start": 17.945020999999997,
    "end": 20.19643683333333,
    "words": 4,
    "text": "Девять месяцев полёта, сложнейшие"
  },
  {
    "start": 20.19643683333333,
    "end": 22.596124999999994,
    "words": 4,
    "text": "расчёты, целые команды специалистов."
  },
  {
    "start": 22.596124999999994,
    "end": 23.495603833333323,
    "words": 4,
    "text": "И вот в сентябре"
  },
  {
    "start": 23.495603833333323,
    "end": 24.765310833333324,
    "words": 4,
    "text": "он подходит к Марсу,"
  },
  {
    "start": 24.791394833333324,
    "end": 26.458290999999992,
    "words": 4,
    "text": "после чего связь пропадает."
  },
  {
    "start": 26.458290999999992,
    "end": 28.59029083333332,
    "words": 4,
    "text": "Космический прогноз погоды закончился"
  },
  {
    "start": 28.59029083333332,
    "end": 30.239916999999984,
    "words": 3,
    "text": "прогнозом полного пиздеца."
  },
  {
    "start": 30.239916999999984,
    "end": 31.633312333333315,
    "words": 3,
    "text": "Расследование нашло ошибку"
  },
  {
    "start": 31.633312333333315,
    "end": 32.197062333333314,
    "words": 3,
    "text": "в данных о"
  },
  {
    "start": 32.197062333333314,
    "end": 33.77666699999998,
    "words": 3,
    "text": "работе маленьких двигателей."
  },
  {
    "start": 33.77666699999998,
    "end": 35.61429133333331,
    "words": 4,
    "text": "Одна наземная программа выдавала"
  },
  {
    "start": 35.61429133333331,
    "end": 36.88400033333332,
    "words": 4,
    "text": "импульс в фунтах силы,"
  },
  {
    "start": 36.91733333333331,
    "end": 38.24829133333331,
    "words": 3,
    "text": "умноженных на секунды,"
  },
  {
    "start": 38.26047833333331,
    "end": 40.06795899999997,
    "words": 4,
    "text": "а другая ждала ньютон-секунды."
  },
  {
    "start": 40.06795899999997,
    "end": 41.15499933333331,
    "words": 2,
    "text": "Числа передали,"
  },
  {
    "start": 41.1805213333333,
    "end": 42.88556299999996,
    "words": 4,
    "text": "а перевести единицы забыли."
  },
  {
    "start": 42.88556299999996,
    "end": 45.0896463333333,
    "words": 4,
    "text": "Охуенное взаимодействие: один считает"
  },
  {
    "start": 45.0896463333333,
    "end": 46.739270333333295,
    "words": 4,
    "text": "в бананах, другой уверен,"
  },
  {
    "start": 46.80535433333329,
    "end": 48.52002199999996,
    "words": 5,
    "text": "что это уже нормальная физика."
  },
  {
    "start": 48.52002199999996,
    "end": 50.709771166666634,
    "words": 4,
    "text": "Разница между этими единицами"
  },
  {
    "start": 50.75904216666663,
    "end": 51.71491716666663,
    "words": 3,
    "text": "примерно в четыре"
  },
  {
    "start": 51.71491716666663,
    "end": 52.70929199999996,
    "words": 3,
    "text": "с половиной раза."
  },
  {
    "start": 52.70929199999996,
    "end": 54.28541716666663,
    "words": 4,
    "text": "Из-за неверных данных расчёт"
  },
  {
    "start": 54.28541716666663,
    "end": 56.83508399999997,
    "words": 5,
    "text": "траектории постепенно расходился с реальностью."
  },
  {
    "start": 56.83508399999997,
    "end": 58.44454216666663,
    "words": 4,
    "text": "Аппарат прошёл слишком близко"
  },
  {
    "start": 58.44454216666663,
    "end": 60.27849999999996,
    "words": 5,
    "text": "к Марсу, и миссию потеряли."
  },
  {
    "start": 60.27849999999996,
    "end": 62.46206216666662,
    "words": 4,
    "text": "Представляете, отправить технику через"
  },
  {
    "start": 62.46206216666662,
    "end": 63.73656216666662,
    "words": 4,
    "text": "космос и проебать её"
  },
  {
    "start": 63.73656216666662,
    "end": 64.93937499999996,
    "words": 3,
    "text": "на переводе единиц?"
  },
  {
    "start": 64.93937499999996,
    "end": 66.58433216666663,
    "words": 4,
    "text": "Это как построить ресторан,"
  },
  {
    "start": 66.7047711666666,
    "end": 67.53810416666661,
    "words": 3,
    "text": "а потом перепутать"
  },
  {
    "start": 67.53810416666661,
    "end": 68.51445899999996,
    "words": 3,
    "text": "соль с цементом."
  },
  {
    "start": 68.51445899999996,
    "end": 69.54987516666662,
    "words": 4,
    "text": "Но виновата не одна"
  },
  {
    "start": 69.54987516666662,
    "end": 71.25333416666663,
    "words": 3,
    "text": "строчка: расследование нашло"
  },
  {
    "start": 71.25333416666663,
    "end": 72.44950016666661,
    "words": 4,
    "text": "и проблемы с проверками,"
  },
  {
    "start": 72.54008416666662,
    "end": 74.44475099999994,
    "words": 5,
    "text": "и плохую связь между командами."
  },
  {
    "start": 74.44475099999994,
    "end": 75.64266716666663,
    "words": 4,
    "text": "То есть косяк прошёл"
  },
  {
    "start": 75.64266716666663,
    "end": 76.77012516666662,
    "words": 3,
    "text": "всю систему контроля"
  },
  {
    "start": 76.77012516666662,
    "end": 78.27666716666661,
    "words": 4,
    "text": "как дорогой гость, которому"
  },
  {
    "start": 78.27666716666661,
    "end": 79.73260599999995,
    "words": 4,
    "text": "ещё и дверь придержали."
  },
  {
    "start": 79.73260599999995,
    "end": 81.54975116666662,
    "words": 4,
    "text": "Аппарат был беспилотным, никто"
  },
  {
    "start": 81.54975116666662,
    "end": 82.65270916666663,
    "words": 4,
    "text": "не погиб, кроме веры"
  },
  {
    "start": 82.65270916666663,
    "end": 83.78012616666663,
    "words": 4,
    "text": "в то, что умные"
  },
  {
    "start": 83.78012616666663,
    "end": 86.27295999999996,
    "words": 5,
    "text": "люди обязательно проверяют очевидную херню."
  },
  {
    "start": 86.27295999999996,
    "end": 86.66345916666663,
    "words": 3,
    "text": "А у вас"
  },
  {
    "start": 86.66345916666663,
    "end": 87.71741816666662,
    "words": 4,
    "text": "на работе тоже все"
  },
  {
    "start": 87.71741816666662,
    "end": 88.72833416666663,
    "words": 3,
    "text": "думали, что это"
  },
  {
    "start": 88.72833416666663,
    "end": 90.26762616666662,
    "words": 3,
    "text": "проверит кто-нибудь другой?"
  }
]